+	text, ok := renderLookupAsText(out)
+	if !ok || !strings.Contains(text, "NOT DELIVERED: [Large]") || !strings.Contains(text, "return 7") {
+		t.Fatalf("bad bounded batch: %t %s", ok, text)
+	}
+}
