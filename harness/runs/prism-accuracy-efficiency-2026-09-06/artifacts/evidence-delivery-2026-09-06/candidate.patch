+func TestSearchRejectedScopeNeverClaimsAbsence(t *testing.T) {
+	h := symbolCapFixture(t, 1)
+	out, err := h.Invoke("prism_search", map[string]any{
+		"query": "FooThing", "scope": "both", "path": "../elsewhere"})
