@@ -206,6 +206,36 @@ complete --no-files --command %(prog_name)s --arguments \
 "(%(complete_func)s)";
 """
 
+# PowerShell passes the command line as an AST, and the word being completed
+# separately, so the env vars are used the same way as Fish. Returning no
+# completion results lets PowerShell fall back to its default (file) handling,
+# which is used for the "dir" and "file" types.
+_SOURCE_POWERSHELL = """\
+Register-ArgumentCompleter -Native -CommandName %(prog_name)s -ScriptBlock {
+    param($wordToComplete, $commandAst, $cursorPosition)
+    $env:%(complete_var)s = "powershell_complete"
+    $env:COMP_WORDS = $commandAst.ToString()
+    $env:COMP_CWORD = $wordToComplete
+    $completions = @(%(prog_name)s)
+    Remove-Item Env:%(complete_var)s
+    Remove-Item Env:COMP_WORDS
+    Remove-Item Env:COMP_CWORD
+
+    $completions | ForEach-Object {
+        $type, $value, $help = $_ -split ',', 3
+
+        if ($type -eq 'plain') {
+            if (-not $help) {
+                $help = $value
+            }
+
+            [System.Management.Automation.CompletionResult]::new(
+                $value, $value, 'ParameterValue', $help)
+        }
+    }
+}
+"""
+
 
