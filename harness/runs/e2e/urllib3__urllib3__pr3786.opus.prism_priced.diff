diff --git a/changelog/2577.bugfix.rst b/changelog/2577.bugfix.rst
new file mode 100644
index 00000000..bcafca9a
--- /dev/null
+++ b/changelog/2577.bugfix.rst
@@ -0,0 +1,5 @@
+Fixed the TLS connection to an HTTPS proxy in forwarding mode using the origin's
+``ssl_context``, ``assert_hostname`` and ``assert_fingerprint`` instead of the
+proxy's. Only ``proxy_ssl_context`` is now used to connect to proxies. Passing
+``ssl_context`` to a ``ProxyManager`` for an HTTPS proxy with
+``use_forwarding_for_https=True`` now raises a ``ValueError``.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 84e1dab9..561ca59f 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -780,6 +780,19 @@ class HTTPSConnection(HTTPConnection):
             if self.server_hostname is not None:
                 server_hostname = self.server_hostname
 
+            # If we're not tunneling then this TLS connection is established
+            # with the proxy itself, not the origin, so the proxy's own TLS
+            # configuration must be used instead of the origin's.
+            if self.proxy_is_forwarding:
+                proxy_config = typing.cast(ProxyConfig, self.proxy_config)
+                ssl_context = proxy_config.ssl_context
+                assert_hostname = proxy_config.assert_hostname
+                assert_fingerprint = proxy_config.assert_fingerprint
+            else:
+                ssl_context = self.ssl_context
+                assert_hostname = self.assert_hostname
+                assert_fingerprint = self.assert_fingerprint
+
             is_time_off = datetime.date.today() < RECENT_DATE
             if is_time_off:
                 warnings.warn(
@@ -806,10 +819,10 @@ class HTTPSConnection(HTTPConnection):
                 key_file=self.key_file,
                 key_password=self.key_password,
                 server_hostname=server_hostname_rm_dot,
-                ssl_context=self.ssl_context,
+                ssl_context=ssl_context,
                 tls_in_tls=tls_in_tls,
-                assert_hostname=self.assert_hostname,
-                assert_fingerprint=self.assert_fingerprint,
+                assert_hostname=assert_hostname,
+                assert_fingerprint=assert_fingerprint,
             )
             self.sock = sock_and_verified.socket
 
diff --git a/src/urllib3/poolmanager.py b/src/urllib3/poolmanager.py
index 3914dec2..5b63079f 100644
--- a/src/urllib3/poolmanager.py
+++ b/src/urllib3/poolmanager.py
@@ -585,6 +585,25 @@ class ProxyManager(PoolManager):
             port = port_by_scheme.get(proxy.scheme, 80)
             proxy = proxy._replace(port=port)
 
+        # In forwarding mode the TLS connection is established with the proxy,
+        # never with the origin, so 'ssl_context' can't be honored.
+        if (
+            proxy.scheme == "https"
+            and use_forwarding_for_https
+            and connection_pool_kw.get("ssl_context") is not None
+        ):
+            if proxy_ssl_context is not None:
+                raise ValueError(
+                    "Can't specify both 'ssl_context' and 'proxy_ssl_context' "
+                    "when 'use_forwarding_for_https' is True, only "
+                    "'proxy_ssl_context' is used to connect to the proxy."
+                )
+            raise ValueError(
+                "'proxy_ssl_context' should be used instead of 'ssl_context' "
+                "when 'use_forwarding_for_https' is True, the TLS connection "
+                "is established with the proxy, not the origin."
+            )
+
         self.proxy = proxy
         self.proxy_headers = proxy_headers or {}
         self.proxy_ssl_context = proxy_ssl_context
