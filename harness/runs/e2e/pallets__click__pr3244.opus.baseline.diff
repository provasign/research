 class _NamedTextIOWrapper(io.TextIOWrapper):
     def __init__(
-        self, buffer: t.BinaryIO, name: str, mode: str, **kwargs: t.Any
+        self,
+        buffer: t.BinaryIO,
+        name: str,
+        mode: str,
+        real_stream: t.IO[t.Any] | None = None,
+        **kwargs: t.Any,
     ) -> None:
         super().__init__(buffer, **kwargs)
         self._name = name
         self._mode = mode
+        self._real_stream = real_stream
+
+    def fileno(self) -> int:
+        """Return the file descriptor of the real stream this replaces.
+
+        The captured stream is backed by an in-memory buffer, which has
+        no file descriptor. Code that passes ``sys.stdout`` or
+        ``sys.stderr`` to something needing a real descriptor, such as
+        :func:`subprocess.run`, would fail during isolation. Falling back
+        to the descriptor of the replaced stream keeps that working, at
+        the cost of that output not being captured.
+
+        .. versionadded:: 8.3.3
+        """
+        if self._real_stream is not None:
+            try:
+                return self._real_stream.fileno()
+            except (AttributeError, OSError, ValueError, io.UnsupportedOperation):
+                pass
+
+        return super().fileno()
 
