+class PowerShellComplete(ShellComplete):
+    """Shell completion for PowerShell, on Windows and other platforms.
+
+    .. versionadded:: 8.5
+    """
+
+    name: t.ClassVar[str] = "pwsh"
+    source_template: t.ClassVar[str] = _SOURCE_PWSH
+
+    def get_completion_args(self) -> tuple[list[str], str]:
+        cwords = split_arg_string(os.environ["COMP_WORDS"])
+        incomplete = os.environ["COMP_CWORD"]
+        args = cwords[1:]
+
+        # PowerShell passes the full command line, which includes the partial
+        # word, remove it from the complete args.
+        if incomplete and args and args[-1] == incomplete:
+            args.pop()
+
+        return args, incomplete
+
+    def format_completion(self, item: CompletionItem[str]) -> str:
+        # The completion script splits each line into three tab separated
+        # fields, so the help text must not contain tabs or newlines.
+        help_ = (item.help or "").replace("\t", " ").replace("\n", " ")
+        return f"{item.type}\t{item.value}\t{help_}"
+
+
 _available_shells: t.Final[dict[str, type[ShellComplete]]] = {
     "bash": BashComplete,
     "fish": FishComplete,
+    "pwsh": PowerShellComplete,
+    "powershell": PowerShellComplete,
     "zsh": ZshComplete,
 }
 
