@@ -206,6 +206,43 @@ complete --no-files --command %(prog_name)s --arguments \
 "(%(complete_func)s)";
 """
 
+# PowerShell has no equivalent of a named completion function, the completer is
+# an anonymous script block registered for the command, so ``complete_func`` is
+# unused here.
+_SOURCE_PWSH = """\
+Register-ArgumentCompleter -Native -CommandName %(prog_name)s -ScriptBlock {
+    param($wordToComplete, $commandAst, $cursorPosition);
+
+    $env:%(complete_var)s = "pwsh_complete";
+    $env:COMP_WORDS = $commandAst.ToString();
+    $env:COMP_CWORD = $wordToComplete;
+    $response = @(%(prog_name)s);
+    Remove-Item Env:%(complete_var)s;
+    Remove-Item Env:COMP_WORDS;
+    Remove-Item Env:COMP_CWORD;
+
+    foreach ($completion in $response) {
+        $type, $value, $help = $completion -split "`t", 3;
+
+        if ($type -eq "dir") {
+            Get-ChildItem -Directory -Path "$value*" -ErrorAction Ignore | ForEach-Object {
+                [System.Management.Automation.CompletionResult]::new(
+                    $_.FullName, $_.Name, "ProviderContainer", $_.FullName);
+            }
+        } elseif ($type -eq "file") {
+            Get-ChildItem -Path "$value*" -ErrorAction Ignore | ForEach-Object {
+                [System.Management.Automation.CompletionResult]::new(
+                    $_.FullName, $_.Name, "ProviderItem", $_.FullName);
+            }
+        } elseif ($type -eq "plain") {
+            if (-not $help) { $help = $value; }
+            [System.Management.Automation.CompletionResult]::new(
+                $value, $value, "ParameterValue", $help);
+        }
+    }
+}
+"""
+
 
