+    @SuppressWarnings("unchecked")
+    @Override
+    public ValueSerializer<Object> unwrappingSerializer(NameTransformer unwrapper)
+    {
+        // [databind#6017]: with dynamically resolved delegate nothing much we can do
+        if (_delegateSerializer == null) {
+            return this;
+        }
+        // Also: cannot assume delegate actually supports unwrapping (cf [databind#2565])
+        ValueSerializer<?> unwrapping = _delegateSerializer.unwrappingSerializer(unwrapper);
+        if (unwrapping == _delegateSerializer) {
+            return this;
+        }
+        return (ValueSerializer<Object>) withDelegate(_converter, _delegateType, unwrapping, _property);
+    }
