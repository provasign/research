+class PowerShellComplete(ShellComplete):
+    """Shell completion for PowerShell and Windows PowerShell.
+
+    .. versionadded:: 8.5.0
+    """
+
+    name: t.ClassVar[str] = "powershell"
+    source_template: t.ClassVar[str] = _SOURCE_POWERSHELL
+
+    def get_completion_args(self) -> tuple[list[str], str]:
+        cwords = split_arg_string(os.environ["COMP_WORDS"])
+        incomplete = os.environ["COMP_CWORD"]
+        args = cwords[1:]
+
+        # PowerShell includes the partial word in the command line as
+        # well, remove it from the complete args.
+        if incomplete and args and args[-1] == incomplete:
+            args.pop()
+
+        return args, incomplete
+
+    def format_completion(self, item: CompletionItem[str]) -> str:
+        # The completion script splits on tabs, so the value and help
+        # must not contain them.
+        help_ = item.help.replace("\n", " ").replace("\t", " ") if item.help else " "
+        return f"{item.type}\t{item.value}\t{help_}"
+
+
 _available_shells: t.Final[dict[str, type[ShellComplete]]] = {
     "bash": BashComplete,
     "fish": FishComplete,
+    "powershell": PowerShellComplete,
+    "pwsh": PowerShellComplete,
     "zsh": ZshComplete,
 }
 
