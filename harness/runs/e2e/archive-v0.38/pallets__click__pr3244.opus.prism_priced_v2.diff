diff --git a/src/click/testing.py b/src/click/testing.py
index fe079ba..8d0bf56 100644
--- a/src/click/testing.py
+++ b/src/click/testing.py
@@ -117,6 +117,29 @@ class _NamedTextIOWrapper(io.TextIOWrapper):
         """
         ...
 
+    def fileno(self) -> int:
+        """Return the descriptor of the real stream being replaced.
+
+        The wrapped buffer is a :class:`io.BytesIO`, which has no
+        descriptor, so passing ``sys.stdout``/``sys.stderr`` to code that
+        needs a real one, such as :mod:`subprocess`, raised
+        ``io.UnsupportedOperation``. Fall back to the original stream
+        Python preserves, so a child process writes to the terminal
+        instead of failing.
+
+        .. versionadded:: 8.3.3
+        """
+        real = {
+            "<stdin>": sys.__stdin__,
+            "<stdout>": sys.__stdout__,
+            "<stderr>": sys.__stderr__,
+        }.get(self._name)
+
+        if real is None:
+            raise io.UnsupportedOperation("fileno")
+
+        return real.fileno()
+
     @property
     def name(self) -> str:
         return self._name
