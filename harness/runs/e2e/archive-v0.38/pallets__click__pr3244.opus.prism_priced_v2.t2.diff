+def _get_fileno(stream: t.IO[t.Any] | None) -> int | None:
+    """Return the file descriptor of ``stream``, or ``None`` if it does
+    not have one (it may already be an in-memory stream).
+    """
+    try:
+        return stream.fileno()  # type: ignore[union-attr]
+    except (AttributeError, OSError, ValueError, io.UnsupportedOperation):
+        return None
+
+
 class _NamedTextIOWrapper(io.TextIOWrapper):
     def __init__(
-        self, buffer: t.BinaryIO, name: str, mode: str, **kwargs: t.Any
+        self,
+        buffer: t.BinaryIO,
+        name: str,
+        mode: str,
+        fileno: int | None = None,
+        **kwargs: t.Any,
     ) -> None:
         super().__init__(buffer, **kwargs)
         self._name = name
         self._mode = mode
+        self._fileno = fileno
+
+    def fileno(self) -> int:
+        """The wrapped buffer is an in-memory stream with no file
+        descriptor. Fall back to the descriptor of the real stream this
+        one replaced, so that code passing ``sys.stdout``/``sys.stderr``
+        to APIs that need a descriptor (such as ``subprocess.run``)
+        keeps working under isolation.
+
+        .. versionadded:: 8.3.2
+        """
+        if self._fileno is None:
+            return super().fileno()
+
+        return self._fileno
 
