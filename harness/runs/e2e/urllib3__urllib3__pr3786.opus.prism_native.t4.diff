diff --git a/src/urllib3/poolmanager.py b/src/urllib3/poolmanager.py
index 3914dec2..962df188 100644
--- a/src/urllib3/poolmanager.py
+++ b/src/urllib3/poolmanager.py
@@ -581,6 +581,21 @@ class ProxyManager(PoolManager):
         if proxy.scheme not in ("http", "https"):
             raise ProxySchemeUnknown(proxy.scheme)
 
+        # In forwarding mode the TLS connection is established with the proxy,
+        # not the origin, so 'proxy_ssl_context' is the option to use.
+        if (
+            use_forwarding_for_https
+            and proxy.scheme == "https"
+            and connection_pool_kw.get("ssl_context") is not None
+        ):
+            warnings.warn(
+                "Passing 'ssl_context' when 'use_forwarding_for_https=True' is "
+                "deprecated and will raise an error in urllib3 v3.0. Use "
+                "'proxy_ssl_context' to configure the TLS connection to the proxy.",
+                category=FutureWarning,
+                stacklevel=2,
+            )
+
         if not proxy.port:
             port = port_by_scheme.get(proxy.scheme, 80)
             proxy = proxy._replace(port=port)
