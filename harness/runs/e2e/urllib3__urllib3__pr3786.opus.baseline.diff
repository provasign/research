diff --git a/changelog/2577.bugfix.rst b/changelog/2577.bugfix.rst
new file mode 100644
index 00000000..4f0fcb8f
--- /dev/null
+++ b/changelog/2577.bugfix.rst
@@ -0,0 +1,4 @@
+Fixed proxies using ``ssl_context`` instead of ``proxy_ssl_context`` when
+connecting to an HTTPS proxy in forwarding mode
+(``use_forwarding_for_https=True``). Passing ``ssl_context`` together with
+``use_forwarding_for_https=True`` now raises a ``ValueError``.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 84e1dab9..0a67c9bf 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -777,6 +777,18 @@ class HTTPSConnection(HTTPConnection):
                 # Override the host with the one we're requesting data from.
                 server_hostname = typing.cast(str, self._tunnel_host)
 
+            # When forwarding, the TLS connection is established with the proxy
+            # itself, not with the origin, so the proxy's TLS configuration is
+            # the one that must be used.
+            if self.proxy_is_forwarding and self.proxy_config is not None:
+                ssl_context = self.proxy_config.ssl_context
+                assert_hostname = self.proxy_config.assert_hostname
+                assert_fingerprint = self.proxy_config.assert_fingerprint
+            else:
+                ssl_context = self.ssl_context
+                assert_hostname = self.assert_hostname
+                assert_fingerprint = self.assert_fingerprint
+
             if self.server_hostname is not None:
                 server_hostname = self.server_hostname
 
@@ -806,10 +818,10 @@ class HTTPSConnection(HTTPConnection):
                 key_file=self.key_file,
                 key_password=self.key_password,
                 server_hostname=server_hostname_rm_dot,
-                ssl_context=self.ssl_context,
+                ssl_context=ssl_context,
                 tls_in_tls=tls_in_tls,
-                assert_hostname=self.assert_hostname,
-                assert_fingerprint=self.assert_fingerprint,
+                assert_hostname=assert_hostname,
+                assert_fingerprint=assert_fingerprint,
             )
             self.sock = sock_and_verified.socket
 
diff --git a/src/urllib3/poolmanager.py b/src/urllib3/poolmanager.py
index 3914dec2..0e777c3c 100644
--- a/src/urllib3/poolmanager.py
+++ b/src/urllib3/poolmanager.py
@@ -581,6 +581,23 @@ class ProxyManager(PoolManager):
         if proxy.scheme not in ("http", "https"):
             raise ProxySchemeUnknown(proxy.scheme)
 
+        # When forwarding, the only TLS connection is the one with the proxy,
+        # so 'ssl_context' (which configures TLS with the origin) is unusable.
+        if (
+            use_forwarding_for_https
+            and connection_pool_kw.get("ssl_context") is not None
+        ):
+            if proxy_ssl_context is not None:
+                raise ValueError(
+                    "Can't use 'ssl_context' together with 'proxy_ssl_context' when "
+                    "'use_forwarding_for_https=True', only 'proxy_ssl_context' is used "
+                    "to connect to the proxy"
+                )
+            raise ValueError(
+                "Can't use 'ssl_context' when 'use_forwarding_for_https=True', "
+                "use 'proxy_ssl_context' instead"
+            )
+
         if not proxy.port:
             port = port_by_scheme.get(proxy.scheme, 80)
             proxy = proxy._replace(port=port)
