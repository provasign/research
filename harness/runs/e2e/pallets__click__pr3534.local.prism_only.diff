+#!/usr/bin/env python3
+
+import click
+import time
+
+def count():
+    for i in range(3):
+        time.sleep(1)
+        yield f"\ncount {i}"
+
+# Test to understand the difference between generator and list
+print("Generator test:")
+
+gen = count()
+print(f"Type of gen: {type(gen)}")
+print(f"isinstance(gen, collections.abc.Iterable): {isinstance(gen, __import__('collections.abc').Iterable)}")
+
+print("\nTesting with direct iteration:")
+# This mimics click's current behavior
+for item in gen:
+    print(f"Got item: {item}")
+
