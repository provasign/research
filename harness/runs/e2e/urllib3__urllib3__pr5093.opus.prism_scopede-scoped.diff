@@ -948,6 +953,19 @@ class _WrappedAndVerifiedSocket(typing.NamedTuple):
     is_verified: bool
 
 
+def _cert_reqs_for_context(
+    ssl_context: ssl.SSLContext | None, conn: HTTPSConnection
+) -> int | str | None:
+    """Determine the 'cert_reqs' to apply when wrapping a socket with
+    ``ssl_context``. If the context isn't the connection's own SSLContext
+    (for example a proxy's SSLContext) we use that context's own verify_mode
+    so the connection's settings don't leak into it.
+    """
+    if ssl_context is not None and ssl_context is not conn.ssl_context:
+        return ssl_context.verify_mode
+    return conn.cert_reqs
+
