+#!/usr/bin/env python3
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'src'))
+
+import click
+import time
+
+def count():
+    for i in range(5):
+        time.sleep(0.1)
+        yield f"count {i}\n"
+
+print("Testing echo_via_pager with generator function...")
+try:
+    # This should now work properly, yielding values one by one
+    click.echo_via_pager(count())
+    print("Success: Generator function handled correctly")
+except Exception as e:
+    print(f"Error: {e}")
