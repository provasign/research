+        return self._fd_file.fileno()
+
+    def _drain_fd(self) -> None:
+        """Copy data written to the descriptors from :meth:`fileno` into the
+        streams, preserving the order data was written in.
+
+        The peer stream is drained first, so that data a subprocess wrote to it
+        stays ahead of whatever is about to be written to this stream.
+        """
+        if self._peer is not None:
+            self._peer._drain_own_fd()
+
+        self._drain_own_fd()
+
+    def _drain_own_fd(self) -> None:
+        if self._fd_file is None:
+            return
+
+        fd = self._fd_file.fileno()
+        end = os.fstat(fd).st_size
+
+        if end <= self._fd_pos:
+            return
+
+        os.lseek(fd, self._fd_pos, os.SEEK_SET)
+        data = os.read(fd, end - self._fd_pos)
+        os.lseek(fd, end, os.SEEK_SET)
+        self._fd_pos += len(data)
+        self.copy_to.write(data)
+        io.BytesIO.write(self, data)
+
