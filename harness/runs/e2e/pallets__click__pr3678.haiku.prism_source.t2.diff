+def test_argument_named_help(runner):
+    """When a parameter is named 'help', the automatic --help is disabled."""
+    @click.command()
+    @click.argument("help")
+    def cli(help):
+        click.echo(f"help: {help}")
+
+    # Should accept the argument without confusion
+    result = runner.invoke(cli, ["value"])
+    assert result.exit_code == 0
+    assert "help: value" in result.output
+
+    # Built-in --help is disabled when there's a parameter named 'help'
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code != 0
+    assert "No such option" in result.output or "Error" in result.output
+
+
+def test_option_named_help(runner):
+    """When an option is named '--help', the automatic --help is disabled."""
+    @click.command()
+    @click.option("--help", default="default_value")
+    def cli(help):
+        click.echo(f"help: {help}")
+
+    # User's --help option takes precedence over built-in help
+    result = runner.invoke(cli, ["--help", "custom_value"])
+    assert result.exit_code == 0
+    assert "help: custom_value" in result.output
+
+    # Default value is used when --help is not provided
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0
+    assert "help: default_value" in result.output
+
+
