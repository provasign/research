+# An obs-fold is a line break followed by at least one SP or HTAB, used by the
+# obsolete line folding of header field values. RFC 7230 section 3.2.4 requires
+# a user agent to replace each received obs-fold with one or more SP octets
+# before interpreting the field value.
+_OBS_FOLD_RE = re.compile(r"(?:\r\n|\r|\n)[\t ]+")
+
+
+def _unfold_header_value(val: str) -> str:
+    """Replaces obs-folds in a header value with a single space (RFC 7230 3.2.4)."""
+    if isinstance(val, str) and ("\n" in val or "\r" in val):
+        return _OBS_FOLD_RE.sub(" ", val)
+    return val
+
+
 class _Sentinel(Enum):
     not_passed = auto()
 
