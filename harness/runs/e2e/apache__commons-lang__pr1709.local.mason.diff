new file mode 100644
index 000000000..668a3757c
--- /dev/null
+++ b/DebugTest.java
@@ -0,0 +1,18 @@
+import org.apache.commons.lang3.math.Fraction;
+
+public class DebugTest {
+    public static void main(String[] args) {
+        try {
+            Fraction f1 = Fraction.getFraction(Integer.MIN_VALUE, 5);
+            Fraction f2 = Fraction.getFraction(-1, 5);
+            System.out.println("f1 = " + f1 + ", numerator = " + f1.getNumerator() + ", denominator = " + f1.getDenominator());
+            System.out.println("f2 = " + f2 + ", numerator = " + f2.getNumerator() + ", denominator = " + f2.getDenominator());
+            
+            Fraction result = f1.add(f2);
+            System.out.println("Result = " + result);
+        } catch (Exception e) {
+            System.out.println("Exception: " + e.getClass().getSimpleName() + " - " + e.getMessage());
+            e.printStackTrace();
+        }
+    }
+}
