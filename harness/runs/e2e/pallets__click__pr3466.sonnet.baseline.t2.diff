+def _echo_shell_script(script: str) -> None:
+    """Write a shell script to stdout using ``\\n`` line endings only.
+
+    On Windows, the default text stream translates ``\\n`` to ``\\r\\n``
+    on write. Shell completion scripts are always POSIX shell syntax
+    (even when generated on Windows for use in a Bash/Zsh emulation
+    layer such as Git Bash or MSYS2), and the injected ``\\r`` bytes can
+    break the shell's parser. Write raw bytes to avoid the translation.
+    """
+    buffer = getattr(sys.stdout, "buffer", None)
+
+    if buffer is not None:
+        buffer.write(script.encode())
+        buffer.write(b"\n")
+        buffer.flush()
+    else:
+        echo(script)
+
