+import org.apache.commons.lang3.RandomStringUtils;
+import java.util.Random;
+
+public class TestFix {
+    public static void main(String[] args) {
+        Random rng = new Random(42);
+        
+        // Test case from the issue: this should NOT throw
+        try {
+            String result = RandomStringUtils.random(10, '0', 'A', true, true, null, rng);
+            System.out.println("✓ SUCCESS: random(10, '0', 'A', true, true, null, rng) = " + result);
+            System.out.println("  Result length: " + result.length());
+            System.out.println("  All characters are digits: " + result.matches("\\d+"));
+        } catch (IllegalArgumentException e) {
+            System.out.println("✗ FAILED: " + e.getMessage());
+        }
+        
+        // Compare with digits-only version (which was working before)
+        try {
+            rng = new Random(42);
+            String result2 = RandomStringUtils.random(10, '0', 'A', false, true, null, rng);
+            System.out.println("✓ digits-only version works: " + result2);
+        } catch (IllegalArgumentException e) {
+            System.out.println("✗ digits-only version failed: " + e.getMessage());
+        }
+    }
+}
