+    /**
+     * Variant of {@link #shouldIgnore(Object, Collection, Collection)} that, when
+     * {@code caseInsensitive} is enabled, matches property names without regard to
+     * case: needed so that properties ignored (or included) by name are handled the
+     * same way as properties are matched.
+     *
+     * @since 2.18.5
+     */
+    public static boolean shouldIgnore(String value, Collection<String> toIgnore,
+            Collection<String> toInclude, boolean caseInsensitive) {
+        if (!caseInsensitive) {
+            return shouldIgnore(value, toIgnore, toInclude);
+        }
+        if (toIgnore == null && toInclude == null) {
+            return false;
+        }
+        if (toInclude == null) {
+            return _containsIgnoreCase(toIgnore, value);
+        }
+        if (toIgnore == null) {
+            return !_containsIgnoreCase(toInclude, value);
+        }
+        // NOTE: conflict between both, JsonIncludeProperties will take priority.
+        return !_containsIgnoreCase(toInclude, value) || _containsIgnoreCase(toIgnore, value);
+    }
+
+    private static boolean _containsIgnoreCase(Collection<String> names, String value) {
+        if (names.contains(value)) {
+            return true;
+        }
+        for (String name : names) {
+            if ((name != null) && name.equalsIgnoreCase(value)) {
+                return true;
+            }
+        }
+        return false;
+    }
