+class _DeprecatedStorageClass:
+    """Descriptor for the deprecated ``*_storage_class`` attributes. Reading the
+    attribute emits a deprecation warning, while werkzeug's own code uses
+    :func:`_get_storage_class` to get the value without warning.
+    """
+
+    def __init__(self, value: t.Any) -> None:
+        self.value = value
+        self.name = ""
+
+    def __set_name__(self, owner: type, name: str) -> None:
+        self.name = name
+
+    def __get__(self, obj: t.Any, owner: type | None = None) -> t.Any:
+        import warnings
+
+        warnings.warn(
+            f"The '{self.name}' attribute is deprecated and will be removed in"
+            " Werkzeug 3.3.",
+            DeprecationWarning,
+            stacklevel=2,
+        )
+        return self.value
+
+
+def _get_storage_class(request: Request, name: str) -> t.Any:
+    """Get the value of a deprecated ``*_storage_class`` attribute, without
+    emitting a deprecation warning if it has not been overridden.
+    """
+    for klass in type(request).__mro__:
+        if name in vars(klass):
+            value = vars(klass)[name]
+
+            if isinstance(value, _DeprecatedStorageClass):
+                return value.value
+
+            return value
+
+    raise AttributeError(name)
+
+
