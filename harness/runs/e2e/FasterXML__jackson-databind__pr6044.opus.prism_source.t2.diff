+    /**
+     * Helper method called to eagerly fail on use of {@code JsonTypeInfo.As.EXTERNAL_PROPERTY}
+     * for Container types (Collections, Maps, arrays): this because external type id
+     * can only be used for properties of scalar and POJO (Bean) types -- with Containers
+     * the setting would be silently applied to contents (elements/values), producing
+     * output that cannot be read back.
+     *
+     * @since 3.2
+     */
+    // [databind#1127]
+    protected void _checkExternalPropertyForContainer(DatabindContext ctxt,
+            MapperConfig<?> config, Annotated ann, JavaType baseType)
+    {
+        // Reference types (like `Optional`, `AtomicReference`) are fine, only Containers problematic
+        if (!baseType.isContainerType()) {
+            return;
+        }
+        JsonTypeInfo.Value typeInfo = config.getAnnotationIntrospector()
+                .findPolymorphicTypeInfo(config, ann);
+        if ((typeInfo != null)
+                && (typeInfo.getInclusionType() == JsonTypeInfo.As.EXTERNAL_PROPERTY)) {
+            ctxt.reportBadDefinition(baseType, String.format(
+"Cannot use `@JsonTypeInfo(include=JsonTypeInfo.As.EXTERNAL_PROPERTY)` with Container type (%s): "
++"`EXTERNAL_PROPERTY` can only be used with scalar and POJO (Bean) types",
+                    ClassUtil.getTypeDescription(baseType)));
+        }
+    }
+
