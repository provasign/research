+package org.apache.commons.collections4.map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.Map;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test for Flat3Map EntrySet remove behavior.
+ */
+public class Flat3MapEntrySetRemoveTest {
+
+    @Test
+    public void testEntrySetRemoveWithWrongValue() {
+        final Flat3Map<String, String> map = new Flat3Map<>();
+        map.put("key1", "value1");
+        map.put("key2", "value2");
+        map.put("key3", "value3");
+        
+        // Create an entry with wrong value
+        final Map.Entry<String, String> entry = new MapEntry<>("key1", "wrongValue");
+        
+        // Should return false - the entry should not be removed
+        assertFalse(map.entrySet().remove(entry), "Should return false when removing entry with wrong value");
+        
+        // Map should still contain the original entry
+        assertTrue(map.containsKey("key1"), "Map should still contain key1");
+        assertEquals("value1", map.get("key1"), "Map should still contain correct value for key1");
+    }
+    
+    @Test
+    public void testEntrySetRemoveWithCorrectValue() {
+        final Flat3Map<String, String> map = new Flat3Map<>();
+        map.put("key1", "value1");
+        map.put("key2", "value2");
+        map.put("key3", "value3");
+        
+        // Create an entry with correct value
+        final Map.Entry<String, String> entry = new MapEntry<>("key1", "value1");
+        
+        // Should return true - the entry should be removed
+        assertTrue(map.entrySet().remove(entry), "Should return true when removing entry with correct value");
+        
+        // Map should no longer contain the entry
+        assertFalse(map.containsKey("key1"), "Map should not contain key1 after removal");
+        assertEquals(2, map.size(), "Map size should be 2 after removal");
+    }
+    
+    /**
+     * Simple Map.Entry implementation for testing.
+     */
+    private static class MapEntry<K, V> implements Map.Entry<K, V> {
+        private final K key;
+        private final V value;
+        
+        public MapEntry(K key, V value) {
+            this.key = key;
+            this.value = value;
+        }
+        
+        @Override
+        public K getKey() {
+            return key;
+        }
+        
+        @Override
+        public V getValue() {
+            return value;
+        }
+        
+        @Override
+        public V setValue(V value) {
+            throw new UnsupportedOperationException();
+        }
+        
+        @Override
+        public boolean equals(Object obj) {
+            if (this == obj) {
+                return true;
+            }
+            if (obj == null || getClass() != obj.getClass()) {
+                return false;
+            }
+            MapEntry<?, ?> that = (MapEntry<?, ?>) obj;
+            return key.equals(that.key) && value.equals(that.value);
+        }
+        
+        @Override
+        public int hashCode() {
+            return key.hashCode() * 31 + value.hashCode();
+        }
+    }
+}
