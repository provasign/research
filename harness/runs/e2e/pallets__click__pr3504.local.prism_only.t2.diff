+class FishComplete(ShellComplete):
+    """Fish shell completion."""
+
+    def format_completion(self, item: CompletionItem) -> str:
+        """Format a completion item for fish shell output.
+
+        :param item: The completion item to format.
+        :return: The formatted string.
+        """
+        help_text = item.help or "_"
+        # Escape newlines in help text so they don't break Fish completion parsing
+        # Fish uses 'string split \n' which expects type,value and help on consecutive lines
+        # If help contains literal newlines, it will be split incorrectly 
+        if "\n" in help_text:
+            # Replace newlines with space to preserve content while avoiding parsing issues
+            help_text = help_text.replace("\n", " ")
+        return f"{item.type},{item.value}\n{help_text}"on instructions (``source`` and ``complete``).
 
