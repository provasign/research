+#!/usr/bin/env python3
+
+import sys
+import os
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from click.utils import echo
+import io
+
+# Test the specific case mentioned in the issue
+try:
+    output = io.BytesIO()
+    echo(b'', output, nl=True)
+    print("Test passed: echo(b'', io.BytesIO(), nl=True) works correctly")
+except Exception as e:
+    print(f"Test failed: {e}")
+    sys.exit(1)
+
+# Test other cases to make sure we didn't break anything
+try:
+    # Test with string
+    output = io.StringIO()
+    echo('hello', output, nl=True)
+    print("Test passed: echo('hello', io.StringIO(), nl=True) works correctly")
+    
+    # Test with empty string
+    output = io.StringIO()
+    echo('', output, nl=True)
+    print("Test passed: echo('', io.StringIO(), nl=True) works correctly")
+    
+    # Test with bytes
+    output = io.BytesIO()
+    echo(b'hello', output, nl=True)
+    print("Test passed: echo(b'hello', io.BytesIO(), nl=True) works correctly")
+    
+    # Test with None
+    output = io.StringIO()
+    echo(None, output, nl=True)
+    print("Test passed: echo(None, io.StringIO(), nl=True) works correctly")
+    
+except Exception as e:
+    print(f"Other test failed: {e}")
+    sys.exit(1)
+
+print("All tests passed!")
