+import click
+import sys
+
+def test_confirm_with_ansi():
+    """Test that confirm properly handles ANSI codes in prompt text."""
+    
+    # Create a prompt with ANSI codes
+    prompt_text = click.style("Do you want to continue?", fg="red")
+    
+    print(f"Prompt text: {repr(prompt_text)}")
+    print(f"Prompt contains ANSI: {click._termui_impl._ansi_colors.get('red') is not None}")
+    
+    # This should work without error
+    try:
+        result = click.confirm(prompt_text, default=True)
+        print(f"Result: {result}")
+        return True
+    except Exception as e:
+        print(f"Error: {e}")
+        return False
+
+if __name__ == "__main__":
+    test_confirm_with_ansi()
