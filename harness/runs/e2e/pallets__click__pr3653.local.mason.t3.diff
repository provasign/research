+#!/usr/bin/env python3
+
+import sys
+import click
+
+# Test to see what happens with ANSI codes in prompts
+def test_ansi_in_prompt():
+    # This should work - prompt with ANSI styling
+    styled_prompt = click.style("Enter name: ", fg="green")
+    print(f"Styled prompt would be: {repr(styled_prompt)}")
+    
+    # But when we use input() on it, the terminal should interpret the ANSI codes
+    try:
+        # This is what happens in Click's visible_prompt_func
+        result = input(styled_prompt)
+        print(f"Input result: {repr(result)}")
+    except Exception as e:
+        print(f"Error: {e}")
+
+if __name__ == "__main__":
+    test_ansi_in_prompt()
