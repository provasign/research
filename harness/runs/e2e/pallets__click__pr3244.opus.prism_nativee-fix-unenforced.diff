@@ -107,15 +107,58 @@ class _NamedTextIOWrapper(io.TextIOWrapper):
         super().__init__(buffer, **kwargs)
         self._name = name
         self._mode = mode
+        self._fileno_file: t.IO[bytes] | None = None
+
+    def fileno(self) -> int:
+        """Return a real file descriptor for this stream.
+
+        The underlying buffer is in memory and has no descriptor, which
+        breaks APIs that need one, such as passing ``sys.stdout`` to
+        ``subprocess.run``. A temporary file is created on demand to act
+        as the descriptor; whatever is written to it is copied into the
+        captured output when this stream is flushed.
+
+        .. versionadded:: 8.3.3
+        """
+        if self._fileno_file is None:
+            self._fileno_file = tempfile.TemporaryFile()
+
+        return self._fileno_file.fileno()
+
+    def _copy_fileno_file(self) -> None:
+        """Move anything written to the descriptor returned by
+        :meth:`fileno` into the captured output, then reset it so further
+        writes are captured too.
+        """
+        f = self._fileno_file
+
+        if f is None:
+            return
+
+        f.flush()
+        f.seek(0)
+        data = f.read()
+
+        if data:
+            f.seek(0)
+            f.truncate()
+            self.buffer.write(data)
+
+    def flush(self) -> None:
+        super().flush()
+        self._copy_fileno_file()
 
