+    @classmethod
+    def strip_line_feed_styles(
+        cls, segments: Iterable["Segment"]
+    ) -> Iterable["Segment"]:
+        """Split segments containing line feeds, so that the line feeds are not styled.
+
+        A styled line feed would extend the background color beyond the end of the line.
+
+        Args:
+            segments (Iterable[Segment]): Segments potentially containing line feeds.
+
+        Yields:
+            Iterable[Segment]: Segments where no line feed is styled.
+        """
+        new_line_segment = cls("\n")
+        for segment in segments:
+            text, style, control = segment
+            if not style or control or "\n" not in text:
+                yield segment
+                continue
+            while text:
+                _text, new_line, text = text.partition("\n")
+                if _text:
+                    yield cls(_text, style)
+                if new_line:
+                    yield new_line_segment
+
