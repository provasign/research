-            if (digits && end <= ASCII_0 || letters && end <= ASCII_A) {
+            // Check if the requested character categories are actually reachable in the range
+            // The original check was: digits && end <= '0' || letters && end <= 'A'
+            // This incorrectly rejected ranges that contain one category but not the other
+            // For example, range ['0', 'A') contains digits but no letters, so it should be allowed
+            // when digits=true and letters=false
+            boolean hasDigits = false;
+            boolean hasLetters = false;
+            for (int i = Math.max(start, 0); i < Math.min(end, 128); i++) {
+                if (Character.isDigit(i)) {
+                    hasDigits = true;
+                }
+                if (Character.isLetter(i)) {
+                    hasLetters = true;
+                }
+                // Early exit if both categories are found
+                if (hasDigits && hasLetters) {
+                    break;
+                }
+            }
+            // Only reject if the requested categories are not reachable in the range
+            if ((digits && !hasDigits) || (letters && !hasLetters)) {
                 throw new IllegalArgumentException(
