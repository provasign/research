diff --git a/changelog/1352.bugfix.rst b/changelog/1352.bugfix.rst
new file mode 100644
index 00000000..8bb228d5
--- /dev/null
+++ b/changelog/1352.bugfix.rst
@@ -0,0 +1,2 @@
+Fixed response header values keeping obsolete line folding (a line break followed by
+whitespace). Each obs-fold is now replaced with a single space, as required by RFC 9110.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 443cb01b..dc574050 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -78,6 +78,11 @@ RECENT_DATE = datetime.date(2025, 1, 1)
 
 _CONTAINS_CONTROL_CHAR_RE = re.compile(r"[^-!#$%&'*+.^_`|~0-9a-zA-Z]")
 
+# Obsolete line folding (obs-fold), a line break followed by whitespace, may still
+# be produced by the header parser. RFC 9110, Section 5.5 requires that a received
+# obs-fold is replaced with one or more SP octets before interpreting the value.
+_OBS_FOLD_RE = re.compile(r"\r?\n[ \t]+")
+
 
 class HTTPConnection(_HTTPConnection):
     """
@@ -616,7 +621,10 @@ class HTTPConnection(_HTTPConnection):
                 exc_info=True,
             )
 
-        headers = HTTPHeaderDict(httplib_response.msg.items())
+        headers = HTTPHeaderDict(
+            (name, _OBS_FOLD_RE.sub(" ", value))
+            for name, value in httplib_response.msg.items()
+        )
 
         response = HTTPResponse(
             body=httplib_response,
