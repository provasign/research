         }
-        return getShortClassName(cls.getName());
+
+        // Handle primitives
+        if (cls.isPrimitive()) {
+            return cls.getName();
+        }
+
+        // Handle arrays: recursively get the component type, then append array notation
+        if (cls.isArray()) {
+            return getShortClassName(cls.getComponentType()) + "[]";
+        }
+
+        // For local and anonymous classes, fall back to string parsing
+        // since their names are compiler-generated with ordinal notation
+        if (cls.isLocalClass() || cls.isAnonymousClass()) {
+            return getShortClassName(cls.getName());
+        }
+
+        // For member and top-level classes, build the name from reflection metadata
+        // This correctly handles $ characters that are part of identifiers
+        final StringBuilder result = new StringBuilder();
+        Class<?> current = cls;
+
+        while (current != null) {
+            if (result.length() > 0) {
+                result.insert(0, '.');
+            }
+            result.insert(0, current.getSimpleName());
+            current = current.getEnclosingClass();
+        }
+
+        return result.toString();
