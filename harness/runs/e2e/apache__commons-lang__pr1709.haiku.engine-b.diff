@@ -0,0 +1,25 @@
+import org.apache.commons.lang3.math.Fraction;
+
+public class TestFix {
+    public static void main(String[] args) {
+        try {
+            // Test case from the issue: should work now
+            Fraction left = Fraction.getFraction(Integer.MAX_VALUE, 2);
+            Fraction right = Fraction.getFraction(-Integer.MAX_VALUE, 1);
+            Fraction result = left.add(right);
+            System.out.println("Result: " + result);
+            System.out.println("Numerator: " + result.getNumerator());
+            System.out.println("Denominator: " + result.getDenominator());
+            
+            // Expected: -2147483647/2
+            if (result.getNumerator() == -2147483647 && result.getDenominator() == 2) {
+                System.out.println("SUCCESS: Test passed!");
+            } else {
+                System.out.println("FAIL: Unexpected result");
+            }
+        } catch (Exception e) {
+            System.out.println("FAIL: Exception thrown: " + e.getMessage());
+            e.printStackTrace();
+        }
+    }
+}
