+class PowerShellComplete(ShellComplete):
+    """Shell completion for PowerShell (``pwsh`` and Windows PowerShell).
+
+    .. versionadded:: 8.5
+    """
+
+    name: t.ClassVar[str] = "pwsh"
+    source_template: t.ClassVar[str] = _SOURCE_POWERSHELL
+
+    def get_completion_args(self) -> tuple[list[str], str]:
+        cwords = split_arg_string(os.environ["COMP_WORDS"])
+        incomplete = os.environ["COMP_CWORD"]
+
+        if incomplete:
+            incomplete = split_arg_string(incomplete)[0]
+
+        args = cwords[1:]
+
+        # PowerShell passes the whole command line, which includes the
+        # partial word being completed. Remove it from the complete args.
+        if incomplete and args and args[-1] == incomplete:
+            args.pop()
+
+        return args, incomplete
+
+    def format_completion(self, item: CompletionItem[str]) -> str:
+        # Tab separated, since the completion script splits on tabs. Help
+        # text may be multi-line, collapse it to a single line.
+        help_ = item.help.replace("\t", " ").replace("\n", " ") if item.help else ""
+        return f"{item.type}\t{item.value}\t{help_}"
+
+
 _available_shells: t.Final[dict[str, type[ShellComplete]]] = {
     "bash": BashComplete,
     "fish": FishComplete,
     "zsh": ZshComplete,
+    "pwsh": PowerShellComplete,
+    "powershell": PowerShellComplete,
 }
 
