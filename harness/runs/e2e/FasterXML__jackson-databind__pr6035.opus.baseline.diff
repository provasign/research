+    /**
+     * Helper method for checking whether value of an incoming property that did match
+     * a Creator parameter should nonetheless be ignored (as per {@code [databind#4629]}).
+     *<p>
+     * Matching is done against the name of the Creator property itself, and not the
+     * incoming property name: the latter may have matched via {@code @JsonAlias}
+     * ({@code [databind#6031]}), in which case ignoral of an unrelated property that
+     * happens to have the same name as the alias must not block the Creator property.
+     *
+     * @since 3.2
+     */
+    protected boolean _shouldIgnoreCreatorProperty(SettableBeanProperty creatorProp) {
+        return IgnorePropertiesUtil.shouldIgnore(creatorProp.getName(),
+                _ignorableProps, _includableProps);
+    }
