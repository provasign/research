 class BytesIOCopy(io.BytesIO):
     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
+    Since ``io.BytesIO`` is purely in-memory, it has no real OS-level
+    file descriptor, so passing it (or a stream wrapping it, such as
+    ``sys.stdout``/``sys.stderr`` during :meth:`CliRunner.isolation`)
+    to APIs that need one, like :func:`subprocess.run`, raises
+    ``io.UnsupportedOperation`` from ``fileno()``. To support that use
+    case without giving up the cheap in-memory behavior for the common
+    case, a real backing temporary file is created lazily, the first
+    time ``fileno()`` is actually requested.
+
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._real_file: t.IO[bytes] | None = None
+
+    def fileno(self) -> int:
+        if self._real_file is None:
+            self._real_file = tempfile.TemporaryFile()
+            self._real_file.write(self.getvalue())
+            self._real_file.seek(self.tell())
+        return self._real_file.fileno()
 
     def flush(self) -> None:
         super().flush()
+        if self._real_file is not None:
+            self._real_file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
+        if self._real_file is not None:
+            self._real_file.write(b)
         self.copy_to.write(b)
         return super().write(b)
 
+    def getvalue(self) -> bytes:
+        if self._real_file is not None:
+            pos = self._real_file.tell()
+            self._real_file.seek(0)
+            try:
+                return self._real_file.read()
+            finally:
+                self._real_file.seek(pos)
+        return super().getvalue()
+
+    def close(self) -> None:
+        if self._real_file is not None:
+            self._real_file.close()
+        super().close()
+
 
