 class BytesIOCopy(io.BytesIO):
     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
+    This is also backed by a real, on-disk file so that code under test
+    which needs an object with a genuine file descriptor (for example,
+    passing ``sys.stdout``/``sys.stderr`` to :func:`subprocess.run`) keeps
+    working instead of raising ``io.UnsupportedOperation`` from
+    ``fileno()``.
+
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._file = tempfile.TemporaryFile()
+        self._file_pos = 0
+
+    def _sync_file(self) -> None:
+        # Pull in anything that was written directly to the backing file's
+        # file descriptor (e.g. by a subprocess), bypassing our ``write()``.
+        self._file.seek(self._file_pos)
+        data = self._file.read()
+        if data:
+            self._file_pos = self._file.tell()
+            super().write(data)
+            self.copy_to.write(data)
 
     def flush(self) -> None:
+        self._sync_file()
         super().flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
+        self._file.write(b)
+        self._file_pos = self._file.tell()
         self.copy_to.write(b)
         return super().write(b)
 
+    def fileno(self) -> int:
+        return self._file.fileno()
+
+    def close(self) -> None:
+        self._file.close()
+        super().close()
+
 
