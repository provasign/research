-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """A ``BytesIO``-like stream backed by a real OS-level temporary
+    file, so it has a valid file descriptor and can be used as the
+    ``stdout``/``stderr`` target of ``subprocess.run`` and similar
+    APIs. Writes are additionally copied to another stream.
 
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3.2
+        Backed by a real file instead of ``io.BytesIO`` so that
+        ``fileno()`` works, fixing ``subprocess.run(..., stdout=...)``
+        inside ``CliRunner.isolation()``.
     """
 
-    def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+    def __init__(self, copy_to: BytesIOCopy | None = None) -> None:
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
     def flush(self) -> None:
-        super().flush()
-        self.copy_to.flush()
+        self._file.flush()
+        if self.copy_to is not None:
+            self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
-        self.copy_to.write(b)
-        return super().write(b)
+        if self.copy_to is not None:
+            self.copy_to.write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def fileno(self) -> int:
+        return self._file.fileno()
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
+    def __del__(self) -> None:
+        # Ensure the backing temporary file is closed once this object
+        # (and therefore nothing else references it, e.g. a wrapping
+        # ``_NamedTextIOWrapper``) is garbage collected, to avoid
+        # ``ResourceWarning: unclosed file``.
+        try:
+            self._file.close()
+        except Exception:
+            pass
 
 
