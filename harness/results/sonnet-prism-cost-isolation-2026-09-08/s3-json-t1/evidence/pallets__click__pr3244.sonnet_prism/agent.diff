-class BytesIOCopy(io.BytesIO):
-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class SpooledBytesIO(tempfile.SpooledTemporaryFile):
+    """A ``BytesIO``-like stream that can be spilled to a real file on
+    disk. Unlike :class:`io.BytesIO`, calling :meth:`fileno` on this
+    stream works, since :class:`~tempfile.SpooledTemporaryFile` rolls
+    itself over to a real file when a file descriptor is requested.
+    This allows the streams used during :class:`CliRunner` isolation to
+    be passed to APIs like :func:`subprocess.run` that require a real
+    file descriptor.
+
+    .. versionadded:: 8.3.2
+    """
+
+    def __init__(self) -> None:
+        super().__init__(mode="w+b")
+
+    def getvalue(self) -> bytes:
+        pos = self.tell()
+        self.seek(0)
+        rv = self.read()
+        self.seek(pos)
+        return rv
+
+    def __del__(self) -> None:
+        # Unlike ``tempfile.SpooledTemporaryFile``, don't warn about being
+        # garbage collected while still open. ``io.BytesIO``, which this
+        # class otherwise behaves like, doesn't require an explicit
+        # ``close()`` either.
+        self.close()
+
+
+class BytesIOCopy(SpooledBytesIO):
+    """Patch ``SpooledBytesIO`` to let the written stream be copied to another.
 
     .. versionadded:: 8.2
     """
 
-    def __init__(self, copy_to: io.BytesIO) -> None:
+    def __init__(self, copy_to: SpooledBytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
 
