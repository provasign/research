-class BytesIOCopy(io.BytesIO):
-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """A binary stream backed by a real (temporary) file, so it exposes a
+    valid file descriptor via :meth:`fileno`. This allows it to be used as
+    the ``stdout``/``stderr`` target of :func:`subprocess.run` and similar
+    APIs during ``CliRunner`` isolation. Everything written to it is also
+    copied to another stream.
 
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.1.4
+        Backed by a temporary file instead of :class:`io.BytesIO` so that
+        :meth:`fileno` works.
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
+    def __del__(self) -> None:
+        # Make sure the backing temporary file is closed even if it was
+        # never explicitly closed, so we don't leak file descriptors or
+        # trigger ResourceWarning during garbage collection.
+        file = self.__dict__.get("_file")
+        if file is not None:
+            file.close()
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
 
 
