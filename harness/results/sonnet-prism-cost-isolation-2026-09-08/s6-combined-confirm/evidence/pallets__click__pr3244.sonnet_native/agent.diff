-class BytesIOCopy(io.BytesIO):
-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """A file-descriptor backed buffer that copies everything written to it
+    into another buffer.
+
+    Unlike :class:`io.BytesIO`, this is backed by a real (anonymous)
+    temporary file, so it has a working ``fileno()``. That allows it to be
+    used as the ``stdout``/``stderr`` argument to APIs such as
+    :func:`subprocess.run` while a command is being run through
+    :class:`CliRunner`.
 
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def __del__(self) -> None:
+        # Make sure the underlying temporary file's descriptor is closed
+        # explicitly, rather than relying on the file object's own
+        # finalizer, which emits a ResourceWarning if it wasn't closed.
+        file = self.__dict__.get("_file")
+        if file is not None:
+            file.close()
 
 
