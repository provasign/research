-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """Like ``io.BytesIO``, but backed by a real, on-disk file so that
+    :meth:`fileno` is supported. Everything written is also copied to
+    another stream.
+
+    Being backed by a real file allows this object to be used as the
+    ``stdout``/``stderr`` of a :class:`subprocess.Popen`, since child
+    processes need an actual file descriptor to write to.
 
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3.3
+        Back the buffer with a real file instead of an in-memory buffer
+        so ``fileno()`` is supported. :issue:`2296`
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def fileno(self) -> int:
+        return self._file.fileno()
+
+    def getvalue(self) -> bytes:
+        # Anything written directly to the file descriptor (for example
+        # by a subprocess using this object as its stdout/stderr) will
+        # also be picked up here, since it shares the same underlying
+        # file.
+        self._file.flush()
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
+    def __del__(self) -> None:
+        # Make sure the real, on-disk file backing this object is closed
+        # even if ``close()`` was never called explicitly, so it doesn't
+        # trigger a ``ResourceWarning`` for a leaked file descriptor.
+        try:
+            self._file.close()
+        except Exception:
+            pass
 
 
