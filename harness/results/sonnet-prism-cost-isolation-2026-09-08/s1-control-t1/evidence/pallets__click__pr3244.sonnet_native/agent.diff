+class BytesIOCopy:
+    """Like ``io.BytesIO``, but backed by a real OS-level file and lets the
+    written stream be copied to another buffer.
+
+    Being backed by a real file means the object has a genuine ``fileno()``,
+    so code under test that passes ``sys.stdout``/``sys.stderr`` to APIs such
+    as :func:`subprocess.run` (which need a real file descriptor) continues
+    to work when invoked through :class:`CliRunner`.
 
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.2.1
+        Backed by a real file instead of :class:`io.BytesIO` so that
+        ``fileno()`` works.
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file: t.BinaryIO = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def __del__(self) -> None:
+        self._file.close()
 
 
