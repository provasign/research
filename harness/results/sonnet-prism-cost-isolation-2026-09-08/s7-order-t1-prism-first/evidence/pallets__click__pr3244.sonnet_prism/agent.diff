-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """A binary stream backed by a real OS-level temporary file, so that
+    ``fileno()`` is available (e.g. so it can be passed to
+    :func:`subprocess.run`), while also copying everything written to it
+    into another stream.
 
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3.3
+        Backed by a real temporary file instead of :class:`io.BytesIO` so
+        that redirected streams support ``fileno()``.
     """
 
-    def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+    def __init__(self, copy_to: t.BinaryIO) -> None:
         self.copy_to = copy_to
+        self._file = tempfile.TemporaryFile()
 
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
+    def __del__(self) -> None:
+        self._file.close()
 
 
