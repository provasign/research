+class BytesIOCopy:
+    """A byte buffer, backed by a real file, that copies everything written
+    to it into another buffer.
+
+    Unlike ``io.BytesIO``, this is backed by a real (temporary) file, so it
+    has a usable file descriptor. This allows it to be handed to
+    subprocesses, e.g. via ``subprocess.run(..., stdout=sys.stdout)``, while
+    still being captured by :class:`CliRunner`.
 
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def write(self, b: ReadableBuffer) -> int:
+        self.copy_to.write(b)
+        return self._file.write(b)
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
-    def write(self, b: ReadableBuffer) -> int:
-        self.copy_to.write(b)
-        return super().write(b)
+    def fileno(self) -> int:
+        return self._file.fileno()
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
+    def __del__(self) -> None:
+        self._file.close()
 
 
