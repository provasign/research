-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """Like ``io.BytesIO``, but backed by a real temporary file so that
+    ``fileno()`` returns a valid file descriptor. This lets the captured
+    streams be passed directly to APIs such as :func:`subprocess.run`
+    (e.g. ``subprocess.run(cmd, stdout=sys.stderr)``) without raising
+    ``io.UnsupportedOperation``. Writes are also copied to another stream.
 
     .. versionadded:: 8.2
     """
 
-    def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+    def __init__(self, copy_to: t.BinaryIO) -> None:
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
+    def __del__(self) -> None:
+        # Ensure the backing temporary file is always released, even if
+        # ``close()`` was never called explicitly.
+        file = self.__dict__.get("_file")
+        if file is not None:
+            file.close()
+
+    def fileno(self) -> int:
+        return self._file.fileno()
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
 
 
