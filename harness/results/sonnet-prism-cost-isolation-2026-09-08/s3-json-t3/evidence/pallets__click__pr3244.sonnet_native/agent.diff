+class FileIOCopy:
+    """A real, file-descriptor backed stream that copies everything
+    written to it to another file-like object.
+
+    Unlike :class:`BytesIOCopy`, this is backed by an actual OS file,
+    so it has a working ``fileno()``. This lets code under test pass
+    ``sys.stdout``/``sys.stderr`` to APIs that require a real file
+    descriptor, such as :func:`subprocess.run`.
+
+    .. versionadded:: 8.3
+    """
+
+    def __init__(self, copy_to: io.BytesIO) -> None:
+        self._file = tempfile.TemporaryFile()
+        self.copy_to = copy_to
+
+    def write(self, b: ReadableBuffer) -> int:
+        self.copy_to.write(b)
+        return self._file.write(b)
+
+    def flush(self) -> None:
+        self._file.flush()
+        self.copy_to.flush()
+
+    def fileno(self) -> int:
+        return self._file.fileno()
+
+    def close(self) -> None:
+        self._file.close()
+
+    def __del__(self) -> None:
+        # Ensure the backing temporary file is closed even if it was
+        # never explicitly closed, so a garbage collected instance
+        # doesn't trigger a ResourceWarning for an unclosed file.
+        try:
+            self._file.close()
+        except Exception:
+            pass
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
+
