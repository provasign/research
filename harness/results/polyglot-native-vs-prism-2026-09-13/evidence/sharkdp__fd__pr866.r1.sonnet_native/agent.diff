+/// Returns a conservative estimate (in bytes) of the maximum combined length of the
+/// arguments that can be passed to a single invocation of a command, leaving some room
+/// for the environment and other overhead.
+fn max_arg_list_length() -> usize {
+    #[cfg(all(unix, not(target_os = "redox")))]
+    {
+        let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+        if arg_max > 0 {
+            // Leave some headroom for the environment variables that get passed along
+            // with the command, and for other overhead that the shell/OS might add.
+            return (arg_max as usize).saturating_sub(2048).max(4096);
         }
     }
+
+    // A conservative, portable fallback value.
+    128 * 1024
