        "old_string": "func WithPrAndIssueQueryParams(baseURL string, state IssueMetadataState) (string, error) {\n\tu, err := url.Parse(baseURL)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tq := u.Query()\n\tif state.Title != \"\" {\n\t\tq.Set(\"title\", state.Title)\n\t}\n\tif state.Body != \"\" {\n\t\tq.Set(\"body\", state.Body)\n\t}\n\tif len(state.Assignees) > 0 {\n\t\tq.Set(\"assignees\", strings.Join(state.Assignees, \",\"))\n\t}\n\tif len(state.Labels) > 0 {\n\t\tq.Set(\"labels\", strings.Join(state.Labels, \",\"))\n\t}\n\tif len(state.Projects) > 0 {\n\t\tq.Set(\"projects\", strings.Join(state.Projects, \",\"))\n\t}\n\tif len(state.Milestones) > 0 {\n\t\tq.Set(\"milestone\", state.Milestones[0])\n\t}\n\tu.RawQuery = q.Encode()\n\treturn u.String(), nil\n}",
        "new_string": "func WithPrAndIssueQueryParams(client *api.Client, baseRepo ghrepo.Interface, baseURL string, state IssueMetadataState) (string, error) {\n\tu, err := url.Parse(baseURL)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tq := u.Query()\n\tif state.Title != \"\" {\n\t\tq.Set(\"title\", state.Title)\n\t}\n\tif state.Body != \"\" {\n\t\tq.Set(\"body\", state.Body)\n\t}\n\tif len(state.Assignees) > 0 {\n\t\tq.Set(\"assignees\", strings.Join(state.Assignees, \",\"))\n\t}\n\tif len(state.Labels) > 0 {\n\t\tq.Set(\"labels\", strings.Join(state.Labels, \",\"))\n\t}\n\tif len(state.Projects) > 0 {\n\t\t// The GitHub UI expects project *paths* (e.g. \"owner/repo/1\"), not project\n\t\t// names, in the query string, so the names have to be resolved first.\n\t\tif err := fillMetadata(client, baseRepo, &state); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tprojectPaths, err := state.MetadataResult.ProjectsToPaths(state.Projects)\n\t\tif err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"could not add to project: %w\", err)\n\t\t}\n\t\tq.Set(\"projects\", strings.Join(projectPaths, \",\"))\n\t}\n\tif len(state.Milestones) > 0 {\n\t\tq.Set(\"milestone\", state.Milestones[0])\n\t}\n\tu.RawQuery = q.Encode()\n\treturn u.String(), nil\n}"
