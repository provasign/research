        "new_string": "\t\tif !found {\n\t\t\treturn nil, fmt.Errorf(\"'%s' not found\", projectName)\n\t\t}\n\t}\n\treturn ids, nil\n}\n\n// ProjectsToPaths resolves project names to the resource paths GitHub expects when\n// pre-filling a project via the web UI query parameters.\nfunc (m *RepoMetadataResult) ProjectsToPaths(names []string) ([]string, error) {\n\tvar paths []string\n\tfor _, projectName := range names {\n\t\tfound := false\n\t\tfor _, p := range m.Projects {\n\t\t\tif strings.EqualFold(projectName, p.Name) {\n\t\t\t\tpaths = append(paths, p.ResourcePath)\n\t\t\t\tfound = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn nil, fmt.Errorf(\"'%s' not found\", projectName)\n\t\t}\n\t}\n\treturn paths, nil\n}"
      },
