        "new_string": "        {\n            let &mut Space { ref mut dst, ref mut caps, ref mut matches } =\n                self.allocate(matcher)?;\n            dst.clear();\n            matches.clear();\n\n            // We can't use 'replace_with_captures_at' directly since it\n            // will happily copy any trailing bytes beyond 'range.end' (up\n            // to the end of 'subject', which may have been extended beyond\n            // 'range.end' above to account for multi-line look-ahead) into\n            // 'dst'. Instead, we iterate over matches ourselves, bail out\n            // once a match starts beyond 'range.end' and only copy the\n            // trailing non-matching bytes up to 'range.end'.\n            let mut last_match = range.start;\n            matcher\n                .captures_iter_at(subject, range.start, caps, |caps| {\n                    let m = caps.get(0).unwrap();\n                    if m.start() >= range.end {\n                        return false;\n                    }\n                    dst.extend(&subject[last_match..m.start()]);\n                    last_match = m.end();\n\n                    let start = dst.len();\n                    caps.interpolate(\n                        |name| matcher.capture_index(name),\n                        subject,\n                        replacement,\n                        dst,\n                    );\n                    let end = dst.len();\n                    matches.push(Match::new(start, end));\n                    true\n                })\n                .map_err(io::Error::error_message)?;\n            dst.extend(&subject[last_match..range.end]);\n        }"
