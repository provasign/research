        "old_string": "        {\n            let &mut Space { ref mut dst, ref mut caps, ref mut matches } =\n                self.allocate(matcher)?;\n            dst.clear();\n            matches.clear();\n\n            matcher\n                .replace_with_captures_at(\n                    subject,\n                    range.start,\n                    caps,\n                    dst,\n                    |caps, dst| {\n                        let start = dst.len();\n                        caps.interpolate(\n                            |name| matcher.capture_index(name),\n                            subject,\n                            replacement,\n                            dst,\n                        );\n                        let end = dst.len();\n                        matches.push(Match::new(start, end));\n                        true\n                    },\n                )\n                .map_err(io::Error::error_message)?;\n        }\n        Ok(())",
        "new_string": "        {\n            let &mut Space { ref mut dst, ref mut caps, ref mut matches } =\n                self.allocate(matcher)?;\n            dst.clear();\n            matches.clear();\n\n            // We cannot use Matcher::replace_with_captures_at directly here\n            // because, in multi-line mode, 'subject' has been extended with\n            // some extra data beyond 'range.end' (for handling look-ahead\n            // assertions). If we let the default implementation append\n            // everything following the final match to 'dst', then that\n            // extra look-ahead data would incorrectly end up in the\n            // replacement output. So we do our own version of the search\n            // and replace loop, being careful to only ever consider matches\n            // and unmatched text up to (and not beyond) 'range.end'.\n            let mut last_match = range.start;\n            matcher\n                .captures_iter_at(subject, range.start, caps, |caps| {\n                    let m = caps.get(0).unwrap();\n                    if m.start() >= range.end {\n                        return false;\n                    }\n                    dst.extend_from_slice(&subject[last_match..m.start()]);\n                    last_match = m.end();\n\n                    let start = dst.len();\n                    caps.interpolate(\n                        |name| matcher.capture_index(name),\n                        subject,\n                        replacement,\n                        dst,\n                    );\n                    let end = dst.len();\n                    matches.push(Match::new(start, end));\n                    true\n                })\n                .map_err(io::Error::error_message)?;\n            let tail_end =\n                std::cmp::max(last_match, range.end).min(subject.len());\n            dst.extend_from_slice(&subject[last_match..tail_end]);\n        }\n        Ok(())"
      },
