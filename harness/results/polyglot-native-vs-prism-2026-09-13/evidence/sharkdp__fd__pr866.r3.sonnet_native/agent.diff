+/// The maximum length (in bytes) of the argument/environment vector that is passed to a new
+/// process. Batches of paths are split up in order to stay below this threshold, similar to what
+/// `xargs` does.
+#[cfg(all(unix, not(target_os = "redox")))]
+fn max_command_line_length() -> usize {
+    static DEFAULT: usize = 128 * 1024;
+
+    let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+    if arg_max <= 0 {
+        return DEFAULT;
+    }
+    let arg_max = arg_max as usize;
+
+    // Reserve headroom for the environment (which counts against the same limit) and other
+    // overhead (e.g. alignment) that the OS also has to fit into the same limit.
+    let reserved = std::cmp::max(arg_max / 4, 4 * 1024);
+
+    arg_max.saturating_sub(reserved).max(4 * 1024)
+}
+
+#[cfg(not(all(unix, not(target_os = "redox"))))]
+fn max_command_line_length() -> usize {
