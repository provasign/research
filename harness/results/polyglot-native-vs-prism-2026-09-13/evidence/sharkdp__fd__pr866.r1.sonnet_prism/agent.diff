+/// The maximum length (in bytes) of the argument list that we are willing to pass to a single
+/// invocation of the executed command. This is used to split up very large batches of search
+/// results (`--exec-batch`/`-X`) into multiple invocations, in order to avoid hitting the
+/// operating system's limit on the total size of the command line (e.g. `argv`/`envp`), which
+/// would otherwise cause an "Argument list too long" error.
+fn max_command_line_length() -> usize {
+    // Leave some headroom for miscellaneous overhead that the OS also counts against the
+    // limit but that we don't account for explicitly.
+    const HEADROOM: usize = 2048;
+
+    #[cfg(all(unix, not(target_os = "redox")))]
+    let limit = {
+        let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+        if arg_max > 0 {
+            arg_max as usize
         } else {
-            ExitCode::Success
+            // Fall back to a conservative default (as used by e.g. GNU xargs) if the limit
+            // could not be determined.
+            128 * 1024
         }
-    }
+    };
+
+    #[cfg(not(all(unix, not(target_os = "redox"))))]
+    let limit = {
+        // Windows has a command line length limit of about 32768 characters. Use the same
+        // conservative default on other platforms (e.g. Redox) where we cannot query the limit.
+        32 * 1024
+    };
+
+    // The environment is also passed alongside argv and counts against the same limit on
+    // most Unix systems, so we need to subtract its size to get an accurate budget for argv.
+    let environ_size: usize = std::env::vars_os()
+        .map(|(key, value)| key.len() + value.len() + 2 + std::mem::size_of::<usize>())
+        .sum();
+
+    limit
+        .saturating_sub(environ_size)
+        .saturating_sub(HEADROOM)
+        .max(4096)
 }
 
