+// interactiveOwner prompts the user to choose an owner (their personal account or
+// one of the organizations they belong to) for a repository whose name was entered
+// without an owner prefix. It returns an empty string if the user has no organizations
+// to choose from, or if they select their personal account.
+func interactiveOwner(client *http.Client, hostname string, prompter iprompter) (string, error) {
+	apiClient := api.NewClientFromHTTP(client)
+
+	login, err := api.CurrentLoginName(apiClient, hostname)
+	if err != nil {
+		return "", err
+	}
+
+	orgs, err := api.CurrentUserOrgs(apiClient, hostname)
+	if err != nil {
+		return "", err
+	}
+	if len(orgs) == 0 {
+		return "", nil
+	}
+
+	owners := append([]string{login}, orgs...)
+	selected, err := prompter.Select("Repository owner", login, owners)
+	if err != nil {
+		return "", err
+	}
+	if owners[selected] == login {
+		return "", nil
+	}
+	return owners[selected], nil
+}
