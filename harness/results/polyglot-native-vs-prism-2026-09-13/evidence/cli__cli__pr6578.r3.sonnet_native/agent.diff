+// CurrentUserOrgs returns the list of organization logins that the
+// authenticated user is a member of.
+func CurrentUserOrgs(client *Client, hostname string) ([]string, error) {
+	type responseData struct {
+		Viewer struct {
+			Organizations struct {
+				Nodes []struct {
+					Login string
+				}
+				PageInfo struct {
+					HasNextPage bool
+					EndCursor   string
+				}
+			} `graphql:"organizations(first: 100, after: $endCursor)"`
+		}
+	}
+
+	var orgs []string
+	variables := map[string]interface{}{
+		"endCursor": (*githubv4.String)(nil),
+	}
+
+	for {
+		var query responseData
+		err := client.Query(hostname, "OrganizationList", &query, variables)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, node := range query.Viewer.Organizations.Nodes {
+			orgs = append(orgs, node.Login)
+		}
+
+		if !query.Viewer.Organizations.PageInfo.HasNextPage {
+			break
+		}
+		variables["endCursor"] = githubv4.String(query.Viewer.Organizations.PageInfo.EndCursor)
+	}
+
+	return orgs, nil
+}
