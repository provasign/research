        "old_string": "func CurrentUserID(client *Client, hostname string) (string, error) {\n\tvar query struct {\n\t\tViewer struct {\n\t\t\tID string\n\t\t}\n\t}\n\terr := client.Query(hostname, \"UserCurrent\", &query, nil)\n\treturn query.Viewer.ID, err\n}",
