        "old_string": "// name, description, and visibility\nfunc interactiveRepoInfo(prompter iprompter, defaultName string) (string, string, string, error) {\n\tname, err := prompter.Input(\"Repository name\", defaultName)\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", err\n\t}\n\n\tdescription, err := prompter.Input(\"Description\", defaultName)\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", err\n\t}\n\n\tvisibilityOptions := []string{\"Public\", \"Private\", \"Internal\"}\n\tselected, err := prompter.Select(\"Visibility\", \"Public\", visibilityOptions)\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", err\n\t}\n\n\treturn name, description, strings.ToUpper(visibilityOptions[selected]), nil\n}",
        "new_string": "// name, description, and visibility\nfunc interactiveRepoInfo(client *api.Client, hostname string, prompter iprompter, defaultName string) (string, string, string, error) {\n\tname, err := prompter.Input(\"Repository name\", defaultName)\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", err\n\t}\n\n\tif !strings.Contains(name, \"/\") {\n\t\towner, err := interactiveRepoOwner(client, hostname, prompter)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", err\n\t\t}\n\t\tif owner != \"\" {\n\t\t\tname = owner + \"/\" + name\n\t\t}\n\t}\n\n\tdescription, err := prompter.Input(\"Description\", defaultName)\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", err\n\t}\n\n\tvisibilityOptions := []string{\"Public\", \"Private\", \"Internal\"}\n\tselected, err := prompter.Select(\"Visibility\", \"Public\", visibilityOptions)\n\tif err != nil {\n\t\treturn \"\", \"\", \"\", err\n\t}\n\n\treturn name, description, strings.ToUpper(visibilityOptions[selected]), nil\n}\n\n// prompt for the owner of a to-be-created repository; returns an empty\n// string if the current user (rather than one of their organizations) is\n// selected as the owner\nfunc interactiveRepoOwner(client *api.Client, hostname string, prompter iprompter) (string, error) {\n\tlogin, orgs, err := api.CurrentLoginNameAndOrgs(client, hostname)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif len(orgs) == 0 {\n\t\treturn \"\", nil\n\t}\n\n\toptions := append([]string{login}, orgs...)\n\tselected, err := prompter.Select(\"Repository owner\", login, options)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif options[selected] == login {\n\t\treturn \"\", nil\n\t}\n\treturn options[selected], nil\n}"
