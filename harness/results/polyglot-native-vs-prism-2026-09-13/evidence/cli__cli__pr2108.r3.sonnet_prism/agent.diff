+// ProjectsToPaths resolves project names to their resource paths, which is what GitHub's
+// web UI expects to be passed as the "projects" query parameter.
+func (m *RepoMetadataResult) ProjectsToPaths(names []string) ([]string, error) {
+	var paths []string
+	for _, projectName := range names {
+		found := false
+		for _, p := range m.Projects {
+			if strings.EqualFold(projectName, p.Name) {
+				paths = append(paths, p.ResourcePath)
+				found = true
+				break
+			}
+		}
+		if !found {
+			return nil, fmt.Errorf("'%s' not found", projectName)
+		}
+	}
+	return paths, nil
+}
