+// ProjectsToPaths resolves project names into their resource paths so that they can be
+// used as the "projects" query parameter when opening the web browser, since the web UI
+// identifies projects by path rather than by name.
+func ProjectsToPaths(client *api.Client, baseRepo ghrepo.Interface, projectNames []string) ([]string, error) {
+	if len(projectNames) == 0 {
+		return nil, nil
+	}
+
+	metadataResult, err := api.RepoMetadata(client, baseRepo, api.RepoMetadataInput{Projects: true})
+	if err != nil {
+		return nil, err
+	}
+
+	return metadataResult.ProjectsToPaths(projectNames)
+}
