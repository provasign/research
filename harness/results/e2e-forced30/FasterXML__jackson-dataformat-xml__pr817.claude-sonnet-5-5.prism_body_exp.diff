         }
+        if (p instanceof FromXmlParser) {
+            FromXmlParser xp = (FromXmlParser) p;
+            String ws = xp.getWhitespaceOnlyText();
+            if (ws == null) {
+                if (p.currentToken() == JsonToken.START_OBJECT) {
+                    xp.expectTextProperty();
+                }
+            } else {
+                return _deserializeFromWhitespace(p, ctxt, ws);
+            }
+        }
         return _delegatee.deserialize(p,  ctxt);
     }
 
+    private Object _deserializeFromWhitespace(JsonParser p, DeserializationContext ctxt,
+            String ws)
+        throws JacksonException
+    {
+        try (TokenBuffer tb = ctxt.bufferForInputBuffering(p)) {
+            tb.writeStartObject();
+            tb.writeName(_xmlTextProperty.getName());
+            tb.writeString(ws);
+            tb.writeEndObject();
+            try (JsonParser syntheticParser = tb.asParserOnFirstToken(ctxt, p)) {
+                Object result = _delegatee.deserialize(syntheticParser, ctxt);
+                // consume the real END_OBJECT
+                p.nextToken();
+                return result;
+            }
+        }
+    }
