+package tools.jackson.dataformat.xml.lists;
+
+import java.util.*;
+
+import org.junit.jupiter.api.Test;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+
+import tools.jackson.dataformat.xml.XmlMapper;
+import tools.jackson.dataformat.xml.XmlTestUtil;
+import tools.jackson.dataformat.xml.XmlWriteFeature;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+// null element in polymorphic (wrapped) List
+public class NullInPolymorphicList_Test extends XmlTestUtil
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.CLASS, include = JsonTypeInfo.As.PROPERTY, property = "cl")
+    public static class Detail { }
+
+    public static class Master {
+        public List<Detail> details = new ArrayList<>();
+    }
+
+    @Test
+    public void testNullInList() throws Exception
+    {
+        XmlMapper mapper = mapperBuilder().enable(XmlWriteFeature.WRITE_NULLS_AS_XSI_NIL).build();
+        Master m = new Master();
+        m.details.add(null);
+        m.details.add(new Detail());
+        Master result = mapper.readValue(mapper.writeValueAsString(m), Master.class);
+        assertEquals(2, result.details.size());
+        assertNull(result.details.get(0));
+        assertNotNull(result.details.get(1));
+    }
+}
