        "old_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)",
        "new_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    Backed by a real (temporary) file rather than pure memory so that\n    ``fileno()`` is available. This allows code under test to pass\n    ``sys.stdout``/``sys.stderr`` to APIs such as :func:`subprocess.run`\n    that need an OS-level file descriptor.\n\n    .. versionadded:: 8.2\n\n    .. versionchanged:: 8.3.2\n        Backed by a real file so ``fileno()`` is supported.\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self._file = tempfile.TemporaryFile()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self._file.flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        self._file.write(b)\n        return super().write(b)\n\n    def fileno(self) -> int:\n        return self._file.fileno()\n\n    def close(self) -> None:\n        super().close()\n        self._file.close()"
      },
