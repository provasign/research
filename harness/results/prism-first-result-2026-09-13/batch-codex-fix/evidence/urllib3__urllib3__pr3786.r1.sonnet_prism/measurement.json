        "old_string": "        # cert_reqs depends on ssl_context so calculate last.\n        if cert_reqs is None:\n            if self.ssl_context is not None:\n                cert_reqs = self.ssl_context.verify_mode\n            else:\n                cert_reqs = resolve_cert_reqs(None)\n        self.cert_reqs = cert_reqs\n        self._connect_callback = None",
        "new_string": "        # cert_reqs depends on ssl_context so calculate last.\n        if cert_reqs is None:\n            if self.ssl_context is not None:\n                cert_reqs = self.ssl_context.verify_mode\n            else:\n                cert_reqs = resolve_cert_reqs(None)\n        self.cert_reqs = cert_reqs\n        self._connect_callback = None\n\n        # 'ssl_context' is used for the connection to the origin, however when\n        # forwarding through an HTTPS proxy the TLS connection is actually made\n        # to the proxy, so 'proxy_ssl_context' should be used instead.\n        if (\n            self.ssl_context is not None\n            and self.proxy is not None\n            and self.proxy.scheme == \"https\"\n            and self.proxy_config is not None\n            and self.proxy_config.use_forwarding_for_https\n        ):\n            if self.proxy_config.ssl_context is not None:\n                raise ValueError(\n                    \"Cannot specify both 'ssl_context' and 'proxy_ssl_context' \"\n                    \"when 'use_forwarding_for_https' is True. The connection \"\n                    \"to the proxy is made using 'proxy_ssl_context', so \"\n                    \"'ssl_context' shouldn't be specified in this case.\"\n                )\n            else:\n                raise ValueError(\n                    \"'ssl_context' shouldn't be used to configure the \"\n                    \"connection to an HTTPS proxy when \"\n                    \"'use_forwarding_for_https' is True, use \"\n                    \"'proxy_ssl_context' instead.\"\n                )"
      },
