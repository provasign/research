        "old_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)",
        "new_string": "class BytesIOCopy(io.RawIOBase):\n    \"\"\"A binary stream backed by a real file, whose written content is\n    also copied to another buffer.\n\n    Being backed by a real file (rather than :class:`io.BytesIO`) means\n    the stream exposes a genuine ``fileno()``, so it (and the\n    :class:`io.TextIOWrapper` built on top of it, e.g. ``sys.stdout``\n    during :meth:`CliRunner.isolation`) can be passed to APIs such as\n    :func:`subprocess.run` that require a real file descriptor.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n        self._file = tempfile.TemporaryFile()\n\n    def readable(self) -> bool:\n        return True\n\n    def writable(self) -> bool:\n        return True\n\n    def seekable(self) -> bool:\n        return True\n\n    def fileno(self) -> int:\n        return self._file.fileno()\n\n    def flush(self) -> None:\n        self._file.flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(bytes(b))\n        return self._file.write(b)\n\n    def getvalue(self) -> bytes:\n        self.flush()\n        pos = self._file.tell()\n        self._file.seek(0)\n        data = self._file.read()\n        self._file.seek(pos)\n        return data\n\n    def close(self) -> None:\n        self._file.close()\n        super().close()"
      },
