     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3.2
+        A real, file descriptor backed temporary file is created on demand
+        so the stream can also be passed to APIs (such as
+        :func:`subprocess.run`) that require a working ``fileno()``. The
+        temporary file is only created the first time ``fileno()`` is
+        called, so streams that are never used that way don't hold onto an
+        extra open file.
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._file: t.IO[bytes] | None = None
 
