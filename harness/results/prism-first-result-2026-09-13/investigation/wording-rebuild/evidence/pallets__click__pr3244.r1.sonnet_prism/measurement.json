        "old_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)",
        "new_string": "class BytesIOCopy:\n    \"\"\"Mimic ``io.BytesIO`` while backing the data with a real, file\n    descriptor based temporary file, and let the written stream be copied\n    to another.\n\n    A real file descriptor is required so that code under test can pass\n    this stream (or a :class:`io.TextIOWrapper` around it, as\n    ``sys.stdout``/``sys.stderr`` are) to APIs such as\n    :func:`subprocess.run` that call ``fileno()`` on their ``stdout`` or\n    ``stderr`` argument.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        self._file = tempfile.TemporaryFile()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        self._file.flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return self._file.write(b)\n\n    def getvalue(self) -> bytes:\n        pos = self._file.tell()\n        self._file.seek(0)\n        data = self._file.read()\n        self._file.seek(pos)\n        return data\n\n    def fileno(self) -> int:\n        return self._file.fileno()\n\n    def __getattr__(self, name: str) -> t.Any:\n        return getattr(self._file, name)"
      },
