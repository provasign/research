+    def fileno(self) -> int:
+        if self._fd_relay is None:
+            read_fd, write_fd = os.pipe()
+
+            def relay() -> None:
+                while True:
+                    try:
+                        chunk = os.read(read_fd, io.DEFAULT_BUFFER_SIZE)
+                    except OSError:
+                        break
+                    if not chunk:
+                        break
+                    self.write(chunk)
+
+            thread = threading.Thread(target=relay, daemon=True)
+            thread.start()
+            self._fd_relay = (read_fd, write_fd, thread)
+
+        return self._fd_relay[1]
+
+    def close_fd_relay(self) -> None:
+        """Stop the pipe relay thread started by :meth:`fileno`, if any.
+
+        .. versionadded:: 8.3.3
+        """
+        if self._fd_relay is not None:
+            read_fd, write_fd, thread = self._fd_relay
+            self._fd_relay = None
+            os.close(write_fd)
+            thread.join()
+            os.close(read_fd)
+
 
