            "old_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)",
            "new_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    .. versionadded:: 8.2\n\n    .. versionchanged:: 8.3.3\n        Supports :meth:`fileno` by lazily backing the stream with a real\n        pipe, so code that passes this object (or a wrapper around it) to\n        :class:`subprocess.Popen` as ``stdout``/``stderr`` works instead of\n        raising ``io.UnsupportedOperation``.\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n        self._fd_relay: tuple[int, int, threading.Thread] | None = None\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)\n\n    def fileno(self) -> int:\n        if self._fd_relay is None:\n            read_fd, write_fd = os.pipe()\n\n            def relay() -> None:\n                while True:\n                    try:\n                        chunk = os.read(read_fd, io.DEFAULT_BUFFER_SIZE)\n                    except OSError:\n                        break\n                    if not chunk:\n                        break\n                    self.write(chunk)\n\n            thread = threading.Thread(target=relay, daemon=True)\n            thread.start()\n            self._fd_relay = (read_fd, write_fd, thread)\n\n        return self._fd_relay[1]\n\n    def close_fd_relay(self) -> None:\n        \"\"\"Stop the pipe relay thread started by :meth:`fileno`, if any.\n\n        .. versionadded:: 8.3.3\n        \"\"\"\n        if self._fd_relay is not None:\n            read_fd, write_fd, thread = self._fd_relay\n            self._fd_relay = None\n            os.close(write_fd)\n            thread.join()\n            os.close(read_fd)"
