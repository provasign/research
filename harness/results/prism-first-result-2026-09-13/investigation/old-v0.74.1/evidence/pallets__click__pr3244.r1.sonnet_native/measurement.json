        "old_string": "class BytesIOCopy(tempfile.SpooledTemporaryFile):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    Backed by a :class:`~tempfile.SpooledTemporaryFile` (rather than a plain\n    ``io.BytesIO``) so that ``fileno()`` works, allowing the stream to be\n    used as ``stdout``/``stderr`` for :class:`subprocess.Popen`.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__(max_size=0, mode=\"w+b\")\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)\n\n    def getvalue(self) -> bytes:\n        pos = self.tell()\n        self.seek(0)\n        try:\n            return self.read()\n        finally:\n            self.seek(pos)",
        "new_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    .. versionadded:: 8.2\n\n    .. versionchanged:: 8.3\n        Supports ``fileno()`` by lazily backing itself with a real\n        temporary file, so the stream can be used as ``stdout``/``stderr``\n        for :class:`subprocess.Popen`. The temporary file is only created\n        the first time ``fileno()`` is requested, so instances that are\n        never used that way behave exactly like a plain ``io.BytesIO``.\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n        self._real_file: t.IO[bytes] | None = None\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n        if self._real_file is not None:\n            self._real_file.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        if self._real_file is not None:\n            self._real_file.write(b)\n        return super().write(b)\n\n    def fileno(self) -> int:\n        if self._real_file is None:\n            self._real_file = tempfile.TemporaryFile()\n            self._real_file.write(super().getvalue())\n            self._real_file.flush()\n        return self._real_file.fileno()\n\n    def getvalue(self) -> bytes:\n        if self._real_file is not None:\n            pos = self._real_file.tell()\n            self._real_file.seek(0)\n            try:\n                return self._real_file.read()\n            finally:\n                self._real_file.seek(pos)\n        return super().getvalue()\n\n    def close(self) -> None:\n        if self._real_file is not None:\n            self._real_file.close()\n        super().close()"
      },
