+    private boolean _isArrayElementTypeSafe(DatabindContext ctxt, Class<?> arrayClass)
+    {
+        Class<?> elementClass = arrayClass.getComponentType();
+        while (elementClass.isArray()) {
+            elementClass = elementClass.getComponentType();
+        }
+        // Non-final element types always get their own, separately validated type id
+        // for values stored in the array (default typing always includes a type id for
