+    // Helper method to recursively register transitive module dependencies
+    // (dependencies of dependencies), without replacing modules already added.
+    private void _addModuleDependency(JacksonModule module)
+    {
+        _verifyModuleMetadata(module);
+        final Object moduleId = module.getRegistrationId();
+        if (_modules.containsKey(moduleId)) {
+            return;
+        }
+        for (JacksonModule dep : module.getDependencies()) {
+            _addModuleDependency(dep);
+        }
+        _modules.putIfAbsent(moduleId, module);
+    }
