+    /**
+     * Proxy {@link TypeDeserializer} used for elements of a Collection-valued
+     * property whose external type id has already been resolved: every
+     * "typed from ..." variant forwards to the real (external-property based)
+     * type deserializer's {@link TypeDeserializer#deserializeTypedWithKnownTypeId}
+     * with the known id, regardless of whether the current element is an
+     * Object, Array, or scalar value. This lets the owning
+     * {@code CollectionDeserializer} keep doing its own per-element token
+     * dispatch (and single-value-as-array unwrapping) unmodified.
+     *
+     * @since 3.3 (fix for [databind#5993])
+     */
+    private static final class KnownTypeIdDeserializer extends TypeDeserializer
+    {
+        private final TypeDeserializer _delegate;
+        private final String _typeId;
+
+        KnownTypeIdDeserializer(TypeDeserializer delegate, String typeId) {
+            _delegate = delegate;
+            _typeId = typeId;
+        }
+
+        @Override
+        public TypeDeserializer forProperty(BeanProperty prop) {
+            TypeDeserializer d = _delegate.forProperty(prop);
+            return (d == _delegate) ? this : new KnownTypeIdDeserializer(d, _typeId);
+        }
+
+        @Override
+        public As getTypeInclusion() { return _delegate.getTypeInclusion(); }
+
+        @Override
+        public String getPropertyName() { return _delegate.getPropertyName(); }
+
+        @Override
+        public TypeIdResolver getTypeIdResolver() { return _delegate.getTypeIdResolver(); }
+
+        @Override
+        public Class<?> getDefaultImpl() { return _delegate.getDefaultImpl(); }
+
+        @Override
+        public Object deserializeTypedFromObject(JsonParser p, DeserializationContext ctxt) throws JacksonException {
+            return _delegate.deserializeTypedWithKnownTypeId(p, ctxt, _typeId);
+        }
+
+        @Override
+        public Object deserializeTypedFromArray(JsonParser p, DeserializationContext ctxt) throws JacksonException {
+            return _delegate.deserializeTypedWithKnownTypeId(p, ctxt, _typeId);
+        }
+
+        @Override
+        public Object deserializeTypedFromScalar(JsonParser p, DeserializationContext ctxt) throws JacksonException {
+            return _delegate.deserializeTypedWithKnownTypeId(p, ctxt, _typeId);
+        }
+
+        @Override
+        public Object deserializeTypedFromAny(JsonParser p, DeserializationContext ctxt) throws JacksonException {
+            return _delegate.deserializeTypedWithKnownTypeId(p, ctxt, _typeId);
+        }
+    }
 }
