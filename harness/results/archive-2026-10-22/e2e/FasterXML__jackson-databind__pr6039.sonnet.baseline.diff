+    // Applies same case-normalization as `getPropertyName()` to a collection of
+    // property names, so that comparisons against actual property names (as used
+    // in `withoutProperties()`) are consistent with this map's case-sensitivity.
+    private Collection<String> _normalizeNames(Collection<String> names) {
+        if (!_caseInsensitive || names == null || names.isEmpty()) {
+            return names;
+        }
+        ArrayList<String> result = new ArrayList<String>(names.size());
+        for (String name : names) {
+            result.add(name.toLowerCase(_locale));
+        }
+        return result;
+    }
