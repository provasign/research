+    /**
+     * Checks whether the {@code unary} and {@code stream} method descriptors describe the same
+     * underlying request/response types, i.e. the {@code stream} descriptor is the compiler
+     * generated {@link MethodDescriptor.RpcType#SERVER_STREAM} counterpart of the {@code unary}
+     * method rather than an unrelated, accidentally overloaded method sharing the same name.
+     */
+    private static boolean isGeneratedUnaryStreamPair(MethodDescriptor unary, MethodDescriptor stream) {
+        if (unary.getRpcType() != MethodDescriptor.RpcType.UNARY) {
+            return false;
+        }
+        Class<?>[] unaryParameterClasses = unary.getParameterClasses();
+        Class<?>[] streamActualRequestTypes = stream.getActualRequestTypes();
+        if (unaryParameterClasses.length != 1
+                || streamActualRequestTypes == null
+                || streamActualRequestTypes.length == 0) {
+            return false;
+        }
+        return Objects.equals(unaryParameterClasses[0], streamActualRequestTypes[0])
+                && Objects.equals(unary.getReturnClass(), stream.getActualResponseType());
+    }
