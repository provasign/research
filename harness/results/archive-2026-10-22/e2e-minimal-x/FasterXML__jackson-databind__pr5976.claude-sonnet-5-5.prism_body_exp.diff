+    // Ignoral names (from READ_ONLY access) that match a property with a creator
+    // parameter are rescued, like in _renameProperties() for [databind#2001]
+    private void _rescueCreatorPropertyIgnorals(Map<String, POJOPropertyBuilder> props)
+    {
+        if (_perPropertyIgnoredNames == null || _creatorProperties == null || isRecordType()) {
+            return;
+        }
+        for (POJOPropertyBuilder cprop : _creatorProperties) {
+            if (cprop == null || cprop.getConstructorParameter() == null
+                    || cprop.anyIgnorals()) {
+                continue;
+            }
+            final String name = cprop.getName();
+            if (props.get(name) == cprop && _perPropertyIgnoredNames.contains(name)) {
+                if (_nonRescuedIgnoredPropertyNames == null) {
+                    _nonRescuedIgnoredPropertyNames = new HashSet<>(_perPropertyIgnoredNames);
+                }
+                _perPropertyIgnoredNames.remove(name);
+            }
+        }
+    }
