+package tools.jackson.dataformat.xml.lists;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import tools.jackson.dataformat.xml.XmlMapper;
+import tools.jackson.dataformat.xml.XmlTestUtil;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+public class NullUnwrappedListTest extends XmlTestUtil
+{
+    static class Parent {
+        public List<String> children;
+    }
+
+    @Test
+    public void testNullListNoWrapperRoundTrip() throws Exception
+    {
+        XmlMapper mapper = XmlMapper.builder().defaultUseWrapper(false).build();
+        String xml = mapper.writeValueAsString(new Parent());
+        assertFalse(xml.contains("children"), xml);
+        assertNull(mapper.readValue(xml, Parent.class).children);
+    }
+}
