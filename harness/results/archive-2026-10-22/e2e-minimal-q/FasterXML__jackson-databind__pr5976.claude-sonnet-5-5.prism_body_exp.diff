+package tools.jackson.databind.deser.creators;
+
+import org.junit.jupiter.api.Test;
+
+import com.fasterxml.jackson.annotation.JsonProperty;
+
+import tools.jackson.databind.*;
+import tools.jackson.databind.cfg.MapperConfig;
+import tools.jackson.databind.introspect.*;
+import tools.jackson.databind.json.JsonMapper;
+import tools.jackson.databind.module.SimpleModule;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+// READ_ONLY property whose explicit name matches implicit creator param name
+public class ReadOnlyImplicitParamTest
+{
+    static class Bean {
+        private final String uri;
+
+        @JsonProperty(value = "uri", access = JsonProperty.Access.READ_ONLY)
+        public final String redactedUri;
+
+        public Bean(@JsonProperty(access = JsonProperty.Access.WRITE_ONLY) String uri) {
+            this.uri = uri;
+            this.redactedUri = uri == null ? null : uri.replace("password", "***");
+        }
+
+        public String getUri() { return uri; }
+    }
+
+    static class Intr extends NopAnnotationIntrospector {
+        @Override
+        public String findImplicitPropertyName(MapperConfig<?> config, AnnotatedMember member) {
+            return (member instanceof AnnotatedParameter) ? "uri" : null;
+        }
+    }
+
+    @Test
+    public void testReadOnlyWithImplicitParam() throws Exception {
+        SimpleModule module = new SimpleModule() {
+            @Override
+            public void setupModule(SetupContext context) {
+                context.appendAnnotationIntrospector(new Intr());
+            }
+        };
+        JsonMapper mapper = JsonMapper.builder().addModule(module).build();
+        Bean original = new Bean("my-password");
+        Bean result = mapper.readValue(mapper.writeValueAsString(original), Bean.class);
+        assertEquals(original.redactedUri, result.getUri());
+    }
+}
