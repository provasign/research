-func (f *failingReader) Read(p []byte) (int, error) {
-	if f.read >= f.failAt {
-		return 0, io.ErrUnexpectedEOF
-	}
-	remaining := f.failAt - f.read
-	if len(p) > remaining {
-		p = p[:remaining]
-	}
-	n, err := f.src.Read(p)
-	f.read += n
-	return n, err
-}
