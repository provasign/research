+/// Determine the maximum length (in bytes) that a batch command's arguments should not exceed,
+/// leaving some room for the executable name, environment variables and other overhead.
+#[cfg(all(unix, not(target_os = "redox")))]
+fn max_batch_command_length() -> usize {
+    let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+    if arg_max <= 0 {
+        // Could not be determined; fall back to a conservative default.
+        return 32 * 1024;
+    }
+    // Leave some headroom for environment variables and other overhead that the shell/OS
+    // will also count against the argument length limit.
+    (arg_max as usize).saturating_sub(2048).max(4096)
+}
+
+#[cfg(not(all(unix, not(target_os = "redox"))))]
