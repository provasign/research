+// prompt for the owner of a to-be-created repository; returns an empty
+// string if the current user (rather than one of their organizations) is
+// selected as the owner
+func interactiveRepoOwner(client *api.Client, hostname string, prompter iprompter) (string, error) {
+	login, orgs, err := api.CurrentLoginNameAndOrgs(client, hostname)
+	if err != nil {
+		return "", err
+	}
+	if len(orgs) == 0 {
+		return "", nil
+	}
+
+	options := append([]string{login}, orgs...)
+	selected, err := prompter.Select("Repository owner", login, options)
+	if err != nil {
+		return "", err
+	}
+	if options[selected] == login {
+		return "", nil
+	}
+	return options[selected], nil
+}
