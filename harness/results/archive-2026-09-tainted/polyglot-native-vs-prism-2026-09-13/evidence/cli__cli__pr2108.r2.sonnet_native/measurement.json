        "old_string": "import (\n\t\"fmt\"\n\t\"net/url\"\n\t\"strings\"\n\n\t\"github.com/cli/cli/api\"\n\t\"github.com/cli/cli/internal/ghrepo\"\n)\n\nfunc WithPrAndIssueQueryParams(baseURL string, state IssueMetadataState) (string, error) {\n\tu, err := url.Parse(baseURL)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tq := u.Query()\n\tif state.Title != \"\" {\n\t\tq.Set(\"title\", state.Title)\n\t}\n\tif state.Body != \"\" {\n\t\tq.Set(\"body\", state.Body)\n\t}\n\tif len(state.Assignees) > 0 {\n\t\tq.Set(\"assignees\", strings.Join(state.Assignees, \",\"))\n\t}\n\tif len(state.Labels) > 0 {\n\t\tq.Set(\"labels\", strings.Join(state.Labels, \",\"))\n\t}\n\tif len(state.Projects) > 0 {\n\t\tq.Set(\"projects\", strings.Join(state.Projects, \",\"))\n\t}\n\tif len(state.Milestones) > 0 {\n\t\tq.Set(\"milestone\", state.Milestones[0])\n\t}\n\tu.RawQuery = q.Encode()\n\treturn u.String(), nil\n}",
        "new_string": "import (\n\t\"fmt\"\n\t\"net/url\"\n\t\"strings\"\n\n\t\"github.com/cli/cli/api\"\n\t\"github.com/cli/cli/internal/ghrepo\"\n)\n\n// WithPrAndIssueQueryParams builds a URL that opens a pre-filled issue or pull\n// request creation page in the browser. The \"projects\" query parameter\n// requires project paths (e.g. \"OWNER/REPO/1\"), not project names, so any\n// project names in state.Projects are resolved via the API.\nfunc WithPrAndIssueQueryParams(client *api.Client, baseRepo ghrepo.Interface, baseURL string, state IssueMetadataState) (string, error) {\n\tu, err := url.Parse(baseURL)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tq := u.Query()\n\tif state.Title != \"\" {\n\t\tq.Set(\"title\", state.Title)\n\t}\n\tif state.Body != \"\" {\n\t\tq.Set(\"body\", state.Body)\n\t}\n\tif len(state.Assignees) > 0 {\n\t\tq.Set(\"assignees\", strings.Join(state.Assignees, \",\"))\n\t}\n\tif len(state.Labels) > 0 {\n\t\tq.Set(\"labels\", strings.Join(state.Labels, \",\"))\n\t}\n\tif len(state.Projects) > 0 {\n\t\tprojectPaths, err := ProjectNamesToPaths(client, baseRepo, state.Projects)\n\t\tif err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"could not add to project: %w\", err)\n\t\t}\n\t\tq.Set(\"projects\", strings.Join(projectPaths, \",\"))\n\t}\n\tif len(state.Milestones) > 0 {\n\t\tq.Set(\"milestone\", state.Milestones[0])\n\t}\n\tu.RawQuery = q.Encode()\n\treturn u.String(), nil\n}\n\n// ProjectNamesToPaths returns the paths (e.g. \"OWNER/REPO/1\") that\n// correspond to the given project names, resolving them via the API.\nfunc ProjectNamesToPaths(client *api.Client, baseRepo ghrepo.Interface, projectNames []string) ([]string, error) {\n\tmetadataResult, err := api.RepoMetadata(client, baseRepo, api.RepoMetadataInput{Projects: true})\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn metadataResult.ProjectsToPaths(projectNames)\n}"
