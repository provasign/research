        "old_string": "func (m *RepoMetadataResult) MilestoneToID(title string) (string, error) {",
        "new_string": "// ProjectsToPaths resolves project names to the paths GitHub uses to identify\n// them (e.g. in URL query parameters), such as \"OWNER/REPO/1\" or \"orgs/ORG/1\".\nfunc (m *RepoMetadataResult) ProjectsToPaths(names []string) ([]string, error) {\n\tvar paths []string\n\tfor _, projectName := range names {\n\t\tfound := false\n\t\tfor _, p := range m.Projects {\n\t\t\tif strings.EqualFold(projectName, p.Name) {\n\t\t\t\tpaths = append(paths, projectPath(p.ResourcePath))\n\t\t\t\tfound = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn nil, fmt.Errorf(\"'%s' not found\", projectName)\n\t\t}\n\t}\n\treturn paths, nil\n}\n\n// projectPath converts a project's GraphQL resourcePath (e.g.\n// \"/OWNER/REPO/projects/1\" or \"/orgs/ORG/projects/1\") into the path format\n// expected by the \"projects\" query parameter on GitHub (e.g. \"OWNER/REPO/1\"\n// or \"orgs/ORG/1\").\nfunc projectPath(resourcePath string) string {\n\treturn strings.Replace(strings.TrimPrefix(resourcePath, \"/\"), \"/projects/\", \"/\", 1)\n}\n\nfunc (m *RepoMetadataResult) MilestoneToID(title string) (string, error) {"
