+// ProjectsToPaths resolves project names to the paths GitHub uses to identify
+// them (e.g. in URL query parameters), such as "OWNER/REPO/1" or "orgs/ORG/1".
+func (m *RepoMetadataResult) ProjectsToPaths(names []string) ([]string, error) {
+	var paths []string
+	for _, projectName := range names {
+		found := false
+		for _, p := range m.Projects {
+			if strings.EqualFold(projectName, p.Name) {
+				paths = append(paths, projectPath(p.ResourcePath))
+				found = true
+				break
+			}
+		}
+		if !found {
+			return nil, fmt.Errorf("'%s' not found", projectName)
+		}
+	}
+	return paths, nil
+}
+
+// projectPath converts a project's GraphQL resourcePath (e.g.
+// "/OWNER/REPO/projects/1" or "/orgs/ORG/projects/1") into the path format
+// expected by the "projects" query parameter on GitHub (e.g. "OWNER/REPO/1"
+// or "orgs/ORG/1").
+func projectPath(resourcePath string) string {
+	return strings.Replace(strings.TrimPrefix(resourcePath, "/"), "/projects/", "/", 1)
+}
