+// interactiveOwner prompts the user to choose the owner (their personal
+// account or one of the organizations they belong to) for the repository
+// being created. It returns an empty string (with no error) if the owner
+// list could not be determined or the user has no organizations, in which
+// case the caller should leave the repository name unprefixed.
+func interactiveOwner(client *http.Client, hostname string, prompter iprompter) (string, error) {
+	apiClient := api.NewClientFromHTTP(client)
+	login, orgs, err := api.CurrentLoginNameAndOrgs(apiClient, hostname)
+	if err != nil || len(orgs) == 0 {
+		return "", nil
+	}
+
+	options := append([]string{login}, orgs...)
+	selected, err := prompter.Select("Repository owner", login, options)
+	if err != nil {
+		return "", err
+	}
+
+	owner := options[selected]
+	if owner == login {
+		return "", nil
+	}
+	return owner, nil
+}
