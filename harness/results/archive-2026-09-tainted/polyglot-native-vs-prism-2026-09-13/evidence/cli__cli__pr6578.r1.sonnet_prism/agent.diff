+// interactiveOwner prompts the user to select the owner (their personal account or one of
+// their organizations) for the repository being created. If the user is not a member of any
+// organization, or if the list of organizations could not be retrieved, no prompt is shown and
+// an empty owner is returned so the repository name is left un-prefixed.
+func interactiveOwner(client *http.Client, hostname string, prompter iprompter) (string, error) {
+	apiClient := api.NewClientFromHTTP(client)
+	login, orgs, err := api.CurrentLoginNameAndOrgs(apiClient, hostname)
+	if err != nil || len(orgs) == 0 {
+		return "", nil
+	}
+
+	options := append([]string{login}, orgs...)
+	selected, err := prompter.Select("Repository owner", login, options)
+	if err != nil {
+		return "", err
+	}
+
+	if options[selected] == login {
+		return "", nil
+	}
+	return options[selected], nil
+}
