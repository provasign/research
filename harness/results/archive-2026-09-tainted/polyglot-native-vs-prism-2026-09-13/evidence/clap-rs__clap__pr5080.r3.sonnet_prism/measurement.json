        "old_string": "    fn push_arg_values(\n        &self,\n        arg: &Arg,\n        raw_vals: Vec<OsString>,\n        matcher: &mut ArgMatcher,\n    ) -> ClapResult<()> {\n        debug!(\"Parser::push_arg_values: {raw_vals:?}\");\n\n        for raw_val in raw_vals {\n            // update the current index because each value is a distinct index to clap\n            self.cur_idx.set(self.cur_idx.get() + 1);\n            debug!(\n                \"Parser::add_single_val_to_arg: cur_idx:={}\",\n                self.cur_idx.get()\n            );\n            let value_parser = arg.get_value_parser();\n            let val = ok!(value_parser.parse_ref(self.cmd, Some(arg), &raw_val));",
        "new_string": "    fn push_arg_values(\n        &self,\n        arg: &Arg,\n        raw_vals: Vec<OsString>,\n        source: ValueSource,\n        matcher: &mut ArgMatcher,\n    ) -> ClapResult<()> {\n        debug!(\"Parser::push_arg_values: {raw_vals:?}\");\n\n        for raw_val in raw_vals {\n            // update the current index because each value is a distinct index to clap\n            self.cur_idx.set(self.cur_idx.get() + 1);\n            debug!(\n                \"Parser::add_single_val_to_arg: cur_idx:={}\",\n                self.cur_idx.get()\n            );\n            // Flag-like actions (`SetTrue`, `SetFalse`, `Count`) synthesize their own\n            // internal, non-user-facing values when the argument wasn't present on the\n            // command line (e.g. the implicit `false` default for `SetTrue`).  Route these\n            // through the action's own parser rather than the user's `value_parser`, as the\n            // latter may be intended purely for validating real command-line input (see\n            // `UnknownArgumentValueParser`) and shouldn't be run against synthetic values.\n            let value_parser = if source == ValueSource::DefaultValue && !arg.is_takes_value_set()\n            {\n                arg.get_action()\n                    .default_value_parser()\n                    .unwrap_or_else(|| arg.get_value_parser().clone())\n            } else {\n                arg.get_value_parser().clone()\n            };\n            let val = ok!(value_parser.parse_ref(self.cmd, Some(arg), &raw_val));"
