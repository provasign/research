        "new_string": "// ProjectsToPaths resolves project names to their resource paths, as expected by GitHub's\n// web UI query parameters.\nfunc (m *RepoMetadataResult) ProjectsToPaths(names []string) ([]string, error) {\n\tvar paths []string\n\tfor _, projectName := range names {\n\t\tfound := false\n\t\tfor _, p := range m.Projects {\n\t\t\tif strings.EqualFold(projectName, p.Name) {\n\t\t\t\tpaths = append(paths, strings.TrimPrefix(p.ResourcePath, \"/\"))\n\t\t\t\tfound = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn nil, fmt.Errorf(\"'%s' not found\", projectName)\n\t\t}\n\t}\n\treturn paths, nil\n}\n\nfunc (m *RepoMetadataResult) MilestoneToID(title string) (string, error) {"
