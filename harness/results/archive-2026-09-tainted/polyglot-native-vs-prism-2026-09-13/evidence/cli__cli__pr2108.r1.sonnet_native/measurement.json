        "new_string": "// WithPrAndIssueQueryParams builds a URL for creating an issue or pull request via GitHub's web\n// UI, encoding the provided metadata as query parameters. Note that the web UI expects projects\n// to be identified by their resource path (e.g. \"OWNER/REPO/projects/1\"), unlike the GraphQL API\n// which accepts project names, so project names are resolved to paths here.\nfunc WithPrAndIssueQueryParams(client *api.Client, baseRepo ghrepo.Interface, baseURL string, state IssueMetadataState) (string, error) {\n\tu, err := url.Parse(baseURL)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tq := u.Query()\n\tif state.Title != \"\" {\n\t\tq.Set(\"title\", state.Title)\n\t}\n\tif state.Body != \"\" {\n\t\tq.Set(\"body\", state.Body)\n\t}\n\tif len(state.Assignees) > 0 {\n\t\tq.Set(\"assignees\", strings.Join(state.Assignees, \",\"))\n\t}\n\tif len(state.Labels) > 0 {\n\t\tq.Set(\"labels\", strings.Join(state.Labels, \",\"))\n\t}\n\tif len(state.Projects) > 0 {\n\t\tif err := fillMetadata(client, baseRepo, &state); err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tprojectPaths, err := state.MetadataResult.ProjectsToPaths(state.Projects)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tq.Set(\"projects\", strings.Join(projectPaths, \",\"))\n\t}"
