        "old_string": "    fn push_arg_values(\n        &self,\n        arg: &Arg,\n        raw_vals: Vec<OsString>,\n        matcher: &mut ArgMatcher,\n    ) -> ClapResult<()> {\n        debug!(\"Parser::push_arg_values: {raw_vals:?}\");\n\n        for raw_val in raw_vals {\n            // update the current index because each value is a distinct index to clap\n            self.cur_idx.set(self.cur_idx.get() + 1);\n            debug!(\n                \"Parser::add_single_val_to_arg: cur_idx:={}\",\n                self.cur_idx.get()\n            );\n            let value_parser = arg.get_value_parser();\n            let val = ok!(value_parser.parse_ref(self.cmd, Some(arg), &raw_val));\n\n            matcher.add_val_to(arg.get_id(), val, raw_val);\n            matcher.add_index_to(arg.get_id(), self.cur_idx.get());\n        }\n\n        Ok(())\n    }",
        "new_string": "    fn push_arg_values(\n        &self,\n        arg: &Arg,\n        raw_vals: Vec<OsString>,\n        matcher: &mut ArgMatcher,\n    ) -> ClapResult<()> {\n        debug!(\"Parser::push_arg_values: {raw_vals:?}\");\n\n        for raw_val in raw_vals {\n            // update the current index because each value is a distinct index to clap\n            self.cur_idx.set(self.cur_idx.get() + 1);\n            debug!(\n                \"Parser::add_single_val_to_arg: cur_idx:={}\",\n                self.cur_idx.get()\n            );\n            let value_parser = arg.get_value_parser();\n            let val = ok!(value_parser.parse_ref(self.cmd, Some(arg), &raw_val));\n\n            matcher.add_val_to(arg.get_id(), val, raw_val);\n            matcher.add_index_to(arg.get_id(), self.cur_idx.get());\n        }\n\n        Ok(())\n    }\n\n    /// Like [`Self::push_arg_values`] but bypasses the user-provided (potentially\n    /// overridden) value parser in favor of the action's own default value parser.\n    ///\n    /// This is used for the synthetic values (e.g. `\"true\"`/`\"false\"` for\n    /// `ArgAction::SetTrue`/`SetFalse`) that clap generates internally, rather than\n    /// values that came from the user on the command line.  Running an overridden value\n    /// parser (like [`UnknownArgumentValueParser`][crate::builder::UnknownArgumentValueParser])\n    /// against these synthetic values doesn't make sense and would eagerly error out even\n    /// when the argument was never used.\n    fn push_arg_values_with_action_parser(\n        &self,\n        arg: &Arg,\n        raw_vals: Vec<OsString>,\n        matcher: &mut ArgMatcher,\n    ) -> ClapResult<()> {\n        debug!(\"Parser::push_arg_values_with_action_parser: {raw_vals:?}\");\n\n        let value_parser = arg\n            .get_action()\n            .default_value_parser()\n            .unwrap_or_else(|| arg.get_value_parser().clone());\n        for raw_val in raw_vals {\n            // update the current index because each value is a distinct index to clap\n            self.cur_idx.set(self.cur_idx.get() + 1);\n            debug!(\n                \"Parser::add_single_val_to_arg: cur_idx:={}\",\n                self.cur_idx.get()\n            );\n            let val = ok!(value_parser.parse_ref(self.cmd, Some(arg), &raw_val));\n\n            matcher.add_val_to(arg.get_id(), val, raw_val);\n            matcher.add_index_to(arg.get_id(), self.cur_idx.get());\n        }\n\n        Ok(())\n    }"
