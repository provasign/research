+/// Returns the maximum argument length supported by the current platform, as reported by
+/// the operating system where possible. Falls back to a conservative value otherwise.
+#[cfg(all(unix, not(target_os = "redox")))]
+fn get_arg_max() -> usize {
+    let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+    if arg_max > 0 {
+        arg_max as usize
+    } else {
+        262_144
+    }
+}
