        "old_string": "\t// If the user did not specify an owner prefix (e.g. \"owner/repo\"), offer\n\t// to select an owner from their personal account and any organizations\n\t// they belong to.\n\tif !strings.Contains(name, \"/\") {\n\t\towner, err := interactiveOwner(client, hostname)\n\t\tif err != nil {\n\t\t\treturn \"\", \"\", \"\", err\n\t\t}\n\t\tif owner != \"\" {\n\t\t\tapiClient := api.NewClientFromHTTP(client)\n\t\t\tlogin, orgs, err := api.CurrentLoginNameAndOrgs(apiClient, hostname)\n\t\t\tif err != nil {\n\t\t\t\treturn \"\", \"\", \"\", err\n\t\t\t}\n\t\t\tif len(orgs) > 0 {\n\t\t\t\toptions := append([]string{login}, orgs...)\n\t\t\t\tselected, err := prompter.Select(\"Repository owner\", login, options)\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn \"\", \"\", \"\", err\n\t\t\t\t}\n\t\t\t\tif options[selected] != login {\n\t\t\t\t\tname = options[selected] + \"/\" + name\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}",
        "new_string": "\t// If the user did not specify an owner prefix (e.g. \"owner/repo\"), offer\n\t// to select an owner from their personal account and any organizations\n\t// they belong to. This lookup is best-effort: if it fails, we silently\n\t// fall back to creating the repository under the default owner.\n\tif !strings.Contains(name, \"/\") {\n\t\tapiClient := api.NewClientFromHTTP(client)\n\t\tlogin, orgs, err := api.CurrentLoginNameAndOrgs(apiClient, hostname)\n\t\tif err == nil && len(orgs) > 0 {\n\t\t\toptions := append([]string{login}, orgs...)\n\t\t\tselected, err := prompter.Select(\"Repository owner\", login, options)\n\t\t\tif err != nil {\n\t\t\t\treturn \"\", \"\", \"\", err\n\t\t\t}\n\t\t\tif options[selected] != login {\n\t\t\t\tname = options[selected] + \"/\" + name\n\t\t\t}\n\t\t}\n\t}"
