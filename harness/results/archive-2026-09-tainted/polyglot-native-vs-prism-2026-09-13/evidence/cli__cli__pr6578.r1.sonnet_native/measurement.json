        "new_string": "// if the given repo name is not already prefixed with an owner, prompt the user to\n// choose which of their accounts (personal or organization) should own the new repo\nfunc interactiveRepoOwner(client *http.Client, hostname string, prompter iprompter, name string) (string, error) {\n\tif strings.Contains(name, \"/\") {\n\t\treturn name, nil\n\t}\n\n\tapiClient := api.NewClientFromHTTP(client)\n\tlogin, orgs, err := api.CurrentLoginNameAndOrgs(apiClient, hostname)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif len(orgs) == 0 {\n\t\treturn name, nil\n\t}\n\n\towners := append([]string{login}, orgs...)\n\tselected, err := prompter.Select(\"Repository owner\", login, owners)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\n\towner := owners[selected]\n\tif owner == login {\n\t\treturn name, nil\n\t}\n\treturn owner + \"/\" + name, nil\n}\n\n// name, description, and visibility\nfunc interactiveRepoInfo(client *http.Client, hostname string, prompter iprompter, defaultName string) (string, string, string, error) {"
