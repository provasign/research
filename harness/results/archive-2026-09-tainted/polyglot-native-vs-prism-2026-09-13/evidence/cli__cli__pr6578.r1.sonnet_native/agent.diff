+// if the given repo name is not already prefixed with an owner, prompt the user to
+// choose which of their accounts (personal or organization) should own the new repo
+func interactiveRepoOwner(client *http.Client, hostname string, prompter iprompter, name string) (string, error) {
+	if strings.Contains(name, "/") {
+		return name, nil
+	}
+
+	apiClient := api.NewClientFromHTTP(client)
+	login, orgs, err := api.CurrentLoginNameAndOrgs(apiClient, hostname)
+	if err != nil {
+		// Not being able to determine the list of organizations shouldn't
+		// prevent the user from creating a repository; just skip the prompt.
+		return name, nil
+	}
+	if len(orgs) == 0 {
+		return name, nil
+	}
+
+	owners := append([]string{login}, orgs...)
+	selected, err := prompter.Select("Repository owner", login, owners)
+	if err != nil {
+		return "", err
+	}
+
+	owner := owners[selected]
+	if owner == login {
+		return name, nil
+	}
+	return owner + "/" + name, nil
+}
