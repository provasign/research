+// ProjectsToPaths resolves project names to the path format expected by
+// GitHub's web UI query parameters (e.g. "OWNER/REPO/1").
+func (m *RepoMetadataResult) ProjectsToPaths(names []string) ([]string, error) {
+	var paths []string
+	for _, projectName := range names {
+		found := false
+		for _, p := range m.Projects {
+			if strings.EqualFold(projectName, p.Name) {
+				paths = append(paths, ProjectNameToURLPath(p.ResourcePath))
+				found = true
+				break
+			}
+		}
+		if !found {
+			return nil, fmt.Errorf("'%s' not found", projectName)
+		}
+	}
+	return paths, nil
+}
