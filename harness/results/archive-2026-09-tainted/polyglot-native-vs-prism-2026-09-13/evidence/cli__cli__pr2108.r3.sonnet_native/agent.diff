 type RepoProject struct {
-	ID   string
-	Name string
+	ID           string
+	Name         string
+	ResourcePath string
+}
+
+// ProjectNameToURLPath converts a GraphQL project resourcePath (e.g.
+// "/OWNER/REPO/projects/1" or "/OWNER/projects/1") into the path format
+// expected by GitHub's web UI query parameters (e.g. "OWNER/REPO/1").
+func ProjectNameToURLPath(resourcePath string) string {
+	parts := strings.Split(strings.Trim(resourcePath, "/"), "/")
+	if len(parts) < 2 {
+		return resourcePath
+	}
+	number := parts[len(parts)-1]
+	rest := parts[:len(parts)-2]
+	return strings.Join(append(rest, number), "/")
 }
 
