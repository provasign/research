@@ -680,6 +680,31 @@ class HTTPSConnection(HTTPConnection):
         self.cert_reqs = cert_reqs
         self._connect_callback = None
 
+        # 'ssl_context' is used for the connection to the origin, however when
+        # forwarding through an HTTPS proxy the TLS connection is actually made
+        # to the proxy, so 'proxy_ssl_context' should be used instead.
+        if (
+            self.ssl_context is not None
+            and self.proxy is not None
+            and self.proxy.scheme == "https"
+            and self.proxy_config is not None
+            and self.proxy_config.use_forwarding_for_https
+        ):
+            if self.proxy_config.ssl_context is not None:
+                raise ValueError(
+                    "Cannot specify both 'ssl_context' and 'proxy_ssl_context' "
+                    "when 'use_forwarding_for_https' is True. The connection "
+                    "to the proxy is made using 'proxy_ssl_context', so "
+                    "'ssl_context' shouldn't be specified in this case."
+                )
+            else:
+                raise ValueError(
+                    "'ssl_context' shouldn't be used to configure the "
+                    "connection to an HTTPS proxy when "
+                    "'use_forwarding_for_https' is True, use "
+                    "'proxy_ssl_context' instead."
+                )
+
