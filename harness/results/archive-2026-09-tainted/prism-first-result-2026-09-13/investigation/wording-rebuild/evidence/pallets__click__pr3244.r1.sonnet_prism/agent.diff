-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """Mimic ``io.BytesIO`` while backing the data with a real, file
+    descriptor based temporary file, and let the written stream be copied
+    to another.
+
+    A real file descriptor is required so that code under test can pass
+    this stream (or a :class:`io.TextIOWrapper` around it, as
+    ``sys.stdout``/``sys.stderr`` are) to APIs such as
+    :func:`subprocess.run` that call ``fileno()`` on their ``stdout`` or
+    ``stderr`` argument.
 
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def fileno(self) -> int:
+        return self._file.fileno()
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
+    def __del__(self) -> None:
+        # Make sure the backing temporary file is closed and removed even
+        # if the owner (e.g. a ``StreamMixer``) never explicitly closes it.
+        file = self.__dict__.get("_file")
+        if file is not None:
+            file.close()
 
 
