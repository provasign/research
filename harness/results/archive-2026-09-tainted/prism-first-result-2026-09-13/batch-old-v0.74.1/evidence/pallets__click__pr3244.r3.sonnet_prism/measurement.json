        "old_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)",
        "new_string": "class BytesIOCopy:\n    \"\"\"A binary stream backed by a real temporary file (so it has a\n    valid file descriptor, unlike ``io.BytesIO``), whose writes are\n    also copied to another stream.\n\n    .. versionadded:: 8.2\n\n    .. versionchanged:: 8.3\n        Backed by a real file instead of ``io.BytesIO`` so that\n        ``fileno()`` works, e.g. when used as ``stdout``/``stderr``\n        for :func:`subprocess.run`.\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        self._file: t.IO[bytes] = tempfile.TemporaryFile()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        self._file.flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return self._file.write(b)\n\n    def getvalue(self) -> bytes:\n        position = self._file.tell()\n        self._file.seek(0)\n        data = self._file.read()\n        self._file.seek(position)\n        return data\n\n    def __getattr__(self, name: str) -> t.Any:\n        return getattr(self._file, name)"
