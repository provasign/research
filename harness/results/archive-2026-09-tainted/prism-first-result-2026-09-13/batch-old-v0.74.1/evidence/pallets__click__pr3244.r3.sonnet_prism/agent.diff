         self.copy_to = copy_to
 
+    def __del__(self) -> None:
+        # Close the backing file explicitly so a garbage-collected,
+        # never-``close()``-d instance doesn't trigger a ResourceWarning
+        # for the underlying OS-level file descriptor.
+        try:
+            self._file.close()
+        except Exception:
+            pass
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
