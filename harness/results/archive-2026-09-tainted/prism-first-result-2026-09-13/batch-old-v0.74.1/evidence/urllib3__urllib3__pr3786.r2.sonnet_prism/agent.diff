diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 84e1dab..2f5fd0f 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -793,6 +793,27 @@ class HTTPSConnection(HTTPConnection):
             # Remove trailing '.' from fqdn hostnames to allow certificate validation
             server_hostname_rm_dot = server_hostname.rstrip(".")
 
+            # If we're connecting directly (forwarding, not tunneling) to an
+            # HTTPS proxy then the TLS handshake we're about to perform is
+            # with the proxy itself, not the origin. In that case we must
+            # use the proxy's TLS configuration (``proxy_ssl_context``, etc.)
+            # rather than the origin's, since ``self.ssl_context`` is meant
+            # for the origin server.
+            use_proxy_ssl_context = (
+                self.proxy is not None
+                and self.proxy.scheme == "https"
+                and self.proxy_is_forwarding
+            )
+            if use_proxy_ssl_context:
+                proxy_config = typing.cast(ProxyConfig, self.proxy_config)
+                ssl_context = proxy_config.ssl_context
+                assert_hostname = proxy_config.assert_hostname
+                assert_fingerprint = proxy_config.assert_fingerprint
+            else:
+                ssl_context = self.ssl_context
+                assert_hostname = self.assert_hostname
+                assert_fingerprint = self.assert_fingerprint
+
             sock_and_verified = _ssl_wrap_socket_and_match_hostname(
                 sock=sock,
                 cert_reqs=self.cert_reqs,
@@ -806,12 +827,14 @@ class HTTPSConnection(HTTPConnection):
                 key_file=self.key_file,
                 key_password=self.key_password,
                 server_hostname=server_hostname_rm_dot,
-                ssl_context=self.ssl_context,
+                ssl_context=ssl_context,
                 tls_in_tls=tls_in_tls,
-                assert_hostname=self.assert_hostname,
-                assert_fingerprint=self.assert_fingerprint,
+                assert_hostname=assert_hostname,
+                assert_fingerprint=assert_fingerprint,
             )
             self.sock = sock_and_verified.socket
+            if use_proxy_ssl_context:
+                self.proxy_is_verified = sock_and_verified.is_verified
 
         # If an error occurs during connection/handshake we may need to release
         # our lock so another connection can probe the origin.
diff --git a/src/urllib3/poolmanager.py b/src/urllib3/poolmanager.py
index 3914dec..04752cb 100644
--- a/src/urllib3/poolmanager.py
+++ b/src/urllib3/poolmanager.py
@@ -585,6 +585,21 @@ class ProxyManager(PoolManager):
             port = port_by_scheme.get(proxy.scheme, 80)
             proxy = proxy._replace(port=port)
 
+        if use_forwarding_for_https and "ssl_context" in connection_pool_kw:
+            if proxy_ssl_context is not None:
+                raise ValueError(
+                    "Cannot specify both 'ssl_context' and 'proxy_ssl_context' "
+                    "when 'use_forwarding_for_https' is True. 'ssl_context' is "
+                    "used for the origin server, not the proxy. Use only "
+                    "'proxy_ssl_context' to configure the TLS connection to "
+                    "the proxy."
+                )
+            raise ValueError(
+                "'ssl_context' should not be used when 'use_forwarding_for_https' "
+                "is True since it's ignored when connecting to the proxy. "
+                "Use 'proxy_ssl_context' instead."
+            )
+
         self.proxy = proxy
         self.proxy_headers = proxy_headers or {}
         self.proxy_ssl_context = proxy_ssl_context
