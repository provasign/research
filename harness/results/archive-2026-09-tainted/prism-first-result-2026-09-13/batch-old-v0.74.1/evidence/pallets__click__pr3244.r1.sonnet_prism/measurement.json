        "old_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)",
        "new_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    Backed by a real, OS-level temporary file (rather than an in-memory\n    buffer) so that ``fileno()`` returns a valid file descriptor. This lets\n    code under test pass ``sys.stdout``/``sys.stderr`` directly to APIs such\n    as :func:`subprocess.run` while running under :class:`CliRunner`.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n        self._file = tempfile.TemporaryFile()\n\n    def flush(self) -> None:\n        self._file.flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return self._file.write(b)\n\n    def getvalue(self) -> bytes:\n        pos = self._file.tell()\n        self._file.seek(0)\n        data = self._file.read()\n        self._file.seek(pos)\n        return data\n\n    def fileno(self) -> int:\n        return self._file.fileno()\n\n    def close(self) -> None:\n        self._file.close()\n        super().close()"
      },
