        "new_string": "        # Check whether the ssl_context and proxy_config are in conflict when\n        # forwarding requests to an HTTPS proxy, in which case the proxy\n        # should be using proxy_ssl_context instead.\n        if (\n            proxy_config is not None\n            and proxy_config.use_forwarding_for_https\n            and proxy is not None\n            and proxy.scheme == \"https\"\n            and ssl_context is not None\n        ):\n            if proxy_config.ssl_context is not None:\n                raise ValueError(\n                    \"Cannot specify both 'ssl_context' and 'proxy_ssl_context' \"\n                    \"when using 'use_forwarding_for_https=True'. Only \"\n                    \"'proxy_ssl_context' should be used to configure the \"\n                    \"connection to the HTTPS proxy.\"\n                )\n            raise ValueError(\n                \"'ssl_context' should not be used to configure the \"\n                \"connection to an HTTPS proxy when 'use_forwarding_for_https=True'. \"\n                \"Use 'proxy_ssl_context' instead.\"\n            )\n\n        self.key_file = key_file\n        self.cert_file = cert_file\n        self.key_password = key_password\n        self.ssl_context = ssl_context\n        self.server_hostname = server_hostname"
