@@ -657,6 +657,29 @@ class HTTPSConnection(HTTPConnection):
             proxy_config=proxy_config,
         )
 
+        # Check whether the ssl_context and proxy_config are in conflict when
+        # forwarding requests to an HTTPS proxy, in which case the proxy
+        # should be using proxy_ssl_context instead.
+        if (
+            proxy_config is not None
+            and proxy_config.use_forwarding_for_https
+            and proxy is not None
+            and proxy.scheme == "https"
+            and ssl_context is not None
+        ):
+            if proxy_config.ssl_context is not None:
+                raise ValueError(
+                    "Cannot specify both 'ssl_context' and 'proxy_ssl_context' "
+                    "when using 'use_forwarding_for_https=True'. Only "
+                    "'proxy_ssl_context' should be used to configure the "
+                    "connection to the HTTPS proxy."
+                )
+            raise ValueError(
+                "'ssl_context' should not be used to configure the "
+                "connection to an HTTPS proxy when 'use_forwarding_for_https=True'. "
+                "Use 'proxy_ssl_context' instead."
+            )
