 class BytesIOCopy(io.BytesIO):
     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
+    Backed by a real, file-descriptor-backed temporary file so that a
+    valid ``fileno()`` is available. This allows the stream to be used as
+    the ``stdout``/``stderr`` target of :func:`subprocess.run` and
+    similar APIs, instead of raising ``io.UnsupportedOperation`` when
+    they try to look up the file descriptor.
+
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._file = tempfile.TemporaryFile()
 
     def flush(self) -> None:
         super().flush()
         self.copy_to.flush()
+        self._file.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
+        self._file.write(b)
         return super().write(b)
 
+    def fileno(self) -> int:
+        return self._file.fileno()
+
+    def getvalue(self) -> bytes:
+        # ``self._file`` mirrors every write, including ones made
+        # directly against the file descriptor (e.g. by a child
+        # process), so it is the authoritative source of the content.
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def close(self) -> None:
+        super().close()
+        self._file.close()
+
 
