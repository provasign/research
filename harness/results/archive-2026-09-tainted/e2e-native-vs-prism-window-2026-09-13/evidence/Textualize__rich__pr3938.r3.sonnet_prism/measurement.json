        "old_string": "        for text, style, control in buffer:\n            if style:\n                append(\n                    style.render(\n                        text,\n                        color_system=color_system,\n                        legacy_windows=legacy_windows,\n                    )\n                )\n            elif not (not_terminal and control):\n                append(text)",
        "new_string": "        for text, style, control in buffer:\n            if style:\n                # Render each line separately so that any ANSI codes are\n                # reset *before* the newline, rather than after it. Some\n                # terminals will otherwise apply the (e.g. background)\n                # style to the following line when scrolling / wrapping.\n                append(\n                    \"\\n\".join(\n                        style.render(\n                            line,\n                            color_system=color_system,\n                            legacy_windows=legacy_windows,\n                        )\n                        for line in text.split(\"\\n\")\n                    )\n                    if \"\\n\" in text\n                    else style.render(\n                        text,\n                        color_system=color_system,\n                        legacy_windows=legacy_windows,\n                    )\n                )\n            elif not (not_terminal and control):\n                append(text)"
      },
