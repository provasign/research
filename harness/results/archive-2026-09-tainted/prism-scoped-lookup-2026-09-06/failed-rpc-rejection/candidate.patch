+	}
+	info, err := os.Stat(abs)
+	if err != nil {
+		return "", fmt.Errorf("scoped lookup file %q: %w", file, err)
+	}
+	if !info.Mode().IsRegular() {
+		return "", fmt.Errorf("scoped lookup file %q is not a regular file", file)
+	}
+	return rel, nil
