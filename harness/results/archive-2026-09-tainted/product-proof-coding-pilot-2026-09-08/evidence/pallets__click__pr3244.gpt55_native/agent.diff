+    def _sync_external_writes(self) -> None:
+        if self._file is None:
+            return
+
+        self._file.flush()
+        pos = self._file.tell()
+        self._file.seek(self._copy_pos)
+        chunk = self._file.read(pos - self._copy_pos)
+
+        if chunk:
+            super().write(chunk)
+            self.copy_to.write(chunk)
+
+        self._copy_pos = pos
+        self._file.seek(pos)
 
     def flush(self) -> None:
         super().flush()
+
+        if self._file is not None:
+            self._file.flush()
+
         self.copy_to.flush()
 
