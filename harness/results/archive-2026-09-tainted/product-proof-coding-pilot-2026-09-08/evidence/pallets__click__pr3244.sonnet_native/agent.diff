+    def fileno(self) -> int:
+        """Provide a real file descriptor backing this stream.
+
+        Some code (for example ``subprocess.run(..., stdout=sys.stdout)``)
+        needs an actual OS-level file descriptor rather than a Python
+        file-like object. Since this stream is normally backed by an
+        in-memory buffer, lazily back it with a temporary file the first
+        time a file descriptor is requested.
+        """
+        if self._fd_file is None:
+            self._fd_file = tempfile.TemporaryFile()
+        return self._fd_file.fileno()
+
+    def _sync_fd_file(self) -> None:
+        """Copy any bytes written directly to the file descriptor (for
+        example by a subprocess) into this buffer, so they show up in the
+        captured output.
+        """
+        if self._fd_file is None:
+            return
+        self._fd_file.flush()
+        end = self._fd_file.tell()
+        if end == self._fd_synced:
+            return
+        self._fd_file.seek(self._fd_synced)
+        data = self._fd_file.read(end - self._fd_synced)
+        self._fd_synced = end
+        self._fd_file.seek(end)
+        if data:
+            self.write(data)
+
+    def close(self) -> None:
+        if self._fd_file is not None:
+            self._fd_file.close()
+            self._fd_file = None
+        super().close()
+
 
