@@ -71,13 +71,22 @@ class BytesIOCopy(io.BytesIO):
     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3
+        Supports :meth:`fileno` by lazily backing the stream with a real
+        temporary file, so code under test (such as
+        ``subprocess.run(..., stdout=sys.stdout)``) can use it as a real
+        file descriptor. Bytes written directly to that descriptor (e.g.
+        by a subprocess) are merged back in when the stream is read.
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._fd_file: t.IO[bytes] | None = None
 
     def flush(self) -> None:
+        self._sync_fd()
