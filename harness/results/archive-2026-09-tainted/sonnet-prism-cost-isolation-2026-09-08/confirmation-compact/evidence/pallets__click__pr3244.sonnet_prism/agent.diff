-class BytesIOCopy(io.BytesIO):
-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """A binary stream backed by a real file, so ``fileno()`` works, that
+    also copies whatever is written to it to another stream.
+
+    Code under test may pass ``sys.stdout``/``sys.stderr`` to APIs that
+    need a real file descriptor, such as ``subprocess.run(..., stdout=...)``.
+    A plain ``io.BytesIO`` has no file descriptor and raises
+    ``io.UnsupportedOperation`` in that case, so this uses a
+    ``tempfile.TemporaryFile`` for its backing storage instead, while still
+    exposing a ``getvalue()`` method like ``io.BytesIO``.
 
     .. versionadded:: 8.2
     """
 
-    def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+    def __init__(self, copy_to: "BytesIOCopy | None" = None) -> None:
+        self._file: t.IO[bytes] = tempfile.TemporaryFile()
         self.copy_to = copy_to
+        # Ensure the real file behind this object is closed once this
+        # wrapper is garbage collected, even if nobody calls ``close()``
+        # explicitly. This avoids ``ResourceWarning: unclosed file``
+        # while still not requiring callers to manage the lifetime.
+        weakref.finalize(self, self._file.close)
 
-    def flush(self) -> None:
-        super().flush()
-        self.copy_to.flush()
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
 
     def write(self, b: ReadableBuffer) -> int:
-        self.copy_to.write(b)
-        return super().write(b)
+        if self.copy_to is not None:
+            self.copy_to.write(b)
+        return self._file.write(b)
+
+    def flush(self) -> None:
+        self._file.flush()
+        if self.copy_to is not None:
+            self.copy_to.flush()
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
 
 
