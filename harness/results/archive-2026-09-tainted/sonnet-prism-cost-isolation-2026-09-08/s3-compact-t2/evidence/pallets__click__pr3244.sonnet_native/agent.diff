+class _FDCapture:
+    """Redirect a real OS-level file descriptor to a temporary file.
+
+    Used so that code invoked through :class:`CliRunner` which relies on
+    ``fileno()`` (for example ``subprocess.run(..., stdout=sys.stdout)``)
+    keeps working, instead of raising :exc:`io.UnsupportedOperation`.
+    Saves the current target of ``targetfd`` via :func:`os.dup`, then
+    redirects it to a temporary file via :func:`os.dup2`. On :meth:`stop`,
+    restores the original fd and returns the captured bytes.
+
+    .. versionadded:: 8.2.1
+    """
+
+    def __init__(self, targetfd: int) -> None:
+        self._targetfd = targetfd
+        self._saved_fd: int | None = None
+        self._tmpfile: t.BinaryIO | None = None
+
+    def start(self) -> None:
+        try:
+            self._saved_fd = os.dup(self._targetfd)
+            self._tmpfile = tempfile.TemporaryFile()
+            os.dup2(self._tmpfile.fileno(), self._targetfd)
+        except (OSError, ValueError):
+            # The target fd doesn't exist or can't be duplicated (for
+            # example when the real stdout/stderr has already been
+            # replaced by something without a real fd). Fall back to no
+            # capturing rather than failing isolation altogether.
+            self._saved_fd = None
+            self._tmpfile = None
+
+    def stop(self) -> bytes:
+        if self._saved_fd is None or self._tmpfile is None:
+            return b""
+        os.dup2(self._saved_fd, self._targetfd)
+        os.close(self._saved_fd)
+        self._saved_fd = None
+        self._tmpfile.seek(0)
+        data = self._tmpfile.read()
+        self._tmpfile.close()
+        self._tmpfile = None
+        return data
+
+
