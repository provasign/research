     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
+    A real (temporary) file backing is lazily created the first time
+    :meth:`fileno` is requested, so that the stream can be passed to APIs
+    such as :func:`subprocess.run` as ``stdout``/``stderr`` without raising
+    ``io.UnsupportedOperation: fileno``. Streams that never need a file
+    descriptor keep behaving as plain in-memory ``io.BytesIO`` objects.
+
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._fd_file: t.BinaryIO | None = None
+
+    def fileno(self) -> int:
+        if self._fd_file is None:
+            self._fd_file = tempfile.TemporaryFile()
+            self._fd_file.write(super().getvalue())
+            self._fd_file.seek(self.tell())
+
+        return self._fd_file.fileno()
 
     def flush(self) -> None:
         super().flush()
         self.copy_to.flush()
 
+        if self._fd_file is not None:
+            self._fd_file.flush()
+
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        rv = super().write(b)
+
+        if self._fd_file is not None:
+            self._fd_file.write(b)
+
+        return rv
+
+    def getvalue(self) -> bytes:
+        if self._fd_file is not None:
+            pos = self._fd_file.tell()
+            self._fd_file.seek(0)
+            data = self._fd_file.read()
+            self._fd_file.seek(pos)
+            return data
+
+        return super().getvalue()
+
+    def close(self) -> None:
+        if self._fd_file is not None:
+            self._fd_file.close()
+
+        super().close()
 
 
