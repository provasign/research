+    def _drain_fd(self) -> None:
+        if self._readfd is None:
+            return
+        while True:
+            try:
+                chunk = os.read(self._readfd, 65536)
+            except BlockingIOError:
+                break
+            except OSError:
+                break
+            if not chunk:
+                break
+            self.write(chunk)
+
+    def close(self) -> None:
+        self._drain_fd()
+        if self._writefd is not None:
+            os.close(self._writefd)
+            self._writefd = None
+        if self._readfd is not None:
+            os.close(self._readfd)
+            self._readfd = None
+        super().close()
