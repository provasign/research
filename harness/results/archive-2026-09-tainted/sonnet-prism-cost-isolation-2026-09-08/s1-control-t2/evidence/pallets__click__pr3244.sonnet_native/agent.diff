+    def fileno(self) -> int:
+        """Return a real OS-level file descriptor backed by a pipe.
+
+        This allows the stream to be used with APIs that require an
+        actual file descriptor, such as passing it as ``stdout`` or
+        ``stderr`` to :class:`subprocess.Popen`. Anything written to
+        the returned descriptor is copied into this stream the next
+        time it is flushed (or closed).
+
+        .. versionadded:: 8.3
