+            # When forwarding to an HTTPS proxy (as opposed to tunneling) the
+            # only TLS connection made over this socket is directly to the
+            # proxy itself, so the proxy's SSL context/hostname/fingerprint
+            # must be used instead of the ones configured for the origin.
+            # See: https://github.com/urllib3/urllib3/issues/2577
+            forwarding_for_https_proxy = (
