+    def getvalue(self) -> bytes:
+        pos = self.tell()
+        self.seek(0)
+        data = self.read()
+        self.seek(pos)
+        return data
+
+    def __del__(self) -> None:
+        # Silently close instead of the base class's behavior of warning
+        # about an unclosed file. These streams are an internal
