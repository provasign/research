-class BytesIOCopy(io.BytesIO):
-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """Mimic ``io.BytesIO``, but back it with a real, ``fileno()``-capable
+    file so that code under test which passes ``sys.stdout``/``sys.stderr``
+    to :func:`subprocess.run` (or similar APIs that require a real file
+    descriptor) doesn't fail with :exc:`io.UnsupportedOperation`. Writes are
+    additionally copied to another stream.
 
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3
+        Backed by a real temporary file instead of :class:`io.BytesIO` so
+        that ``fileno()`` works.
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file: t.BinaryIO = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        rv = self._file.read()
+        self._file.seek(pos)
+        return rv
+
+    def __del__(self) -> None:
+        # Make sure the real, fd-backed temp file is closed even if the
+        # ``CliRunner`` isolation cleanup didn't run, so it doesn't linger
+        # around to be closed (with a ``ResourceWarning``) by its own
+        # finalizer later.
+        try:
+            self._file.close()
+        except Exception:
+            pass
 
 
