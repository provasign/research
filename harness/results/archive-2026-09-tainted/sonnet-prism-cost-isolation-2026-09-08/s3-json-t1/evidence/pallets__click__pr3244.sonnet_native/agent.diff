+class BytesIOCopy:
+    """A binary stream that copies everything written to it into another
+    stream, while being backed by a real OS-level file.
+
+    Being backed by a real file (rather than an in-memory ``io.BytesIO``)
+    means it has a valid ``fileno()``, so it can be used as the
+    ``stdout``/``stderr`` target of :func:`subprocess.run` and similar APIs,
+    e.g. ``subprocess.run(..., stdout=sys.stderr)`` inside a command invoked
+    through :class:`CliRunner`.
 
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3.3
+        Backed by a real file so ``fileno()`` works, fixing
+        ``io.UnsupportedOperation`` when passed to :func:`subprocess.run`.
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
 
 
