+class BytesIOCopy(tempfile.SpooledTemporaryFile):
     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
+    This is backed by a :class:`tempfile.SpooledTemporaryFile` instead of
+    a plain :class:`io.BytesIO` so that it exposes a real file descriptor
+    (through ``fileno()``) once needed. This allows code under test to pass
+    ``sys.stdout``/``sys.stderr`` to APIs such as :func:`subprocess.run`
+    without raising ``io.UnsupportedOperation``.
+
     .. versionadded:: 8.2
     """
 
@@ -85,6 +91,20 @@ class BytesIOCopy(io.BytesIO):
         self.copy_to.write(b)
         return super().write(b)
 
+    def getvalue(self) -> bytes:
+        pos = self.tell()
+        self.seek(0)
+        try:
+            return self.read()
+        finally:
+            self.seek(pos)
+
+    def __del__(self) -> None:
+        # Silently close instead of using SpooledTemporaryFile's default
+        # behavior of emitting a ResourceWarning, since instances of this
+        # class are commonly left for the garbage collector to clean up.
+        self.close()
+
 
