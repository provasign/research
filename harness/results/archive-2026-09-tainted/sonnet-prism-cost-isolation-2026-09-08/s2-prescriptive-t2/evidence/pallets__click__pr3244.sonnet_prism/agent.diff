-class BytesIOCopy(io.BytesIO):
-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """A binary buffer that copies everything written to it to another
+    stream.
+
+    Backed by an :class:`io.BytesIO` buffer so no real file descriptor is
+    allocated (and nothing needs to be closed) unless ``fileno()`` is
+    actually requested, e.g. by :func:`subprocess.run`. In that case, the
+    buffer's contents are transparently migrated to a real temporary file so
+    a usable file descriptor can be handed out.
 
     .. versionadded:: 8.2
+    .. versionchanged:: 8.3
+        Support ``fileno()`` by lazily backing the stream with a real
+        temporary file when a file descriptor is requested.
     """
 
-    def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+    def __init__(self, copy_to: t.BinaryIO) -> None:
+        self._buffer: t.BinaryIO = io.BytesIO()
+        self._file: t.BinaryIO | None = None
         self.copy_to = copy_to
 
+    @property
+    def _target(self) -> t.BinaryIO:
+        return self._buffer if self._file is None else self._file
+
+    def fileno(self) -> int:
+        if self._file is None:
+            file = tempfile.TemporaryFile()
+            file.write(self._buffer.getvalue())
+            self._file = file
+        return self._file.fileno()
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._target, name)
+
     def flush(self) -> None:
-        super().flush()
+        self._target.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._target.write(b)
+
+    def getvalue(self) -> bytes:
+        target = self._target
+        pos = target.tell()
+        target.seek(0)
+        data = target.read()
+        target.seek(pos)
+        return data
+
+    def close(self) -> None:
+        if self._file is not None:
+            self._file.close()
+        self._buffer.close()
 
 
