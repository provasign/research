 class BytesIOCopy(io.BytesIO):
     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
+    ``fileno()`` is unsupported on a plain ``io.BytesIO``, which breaks
+    code under test that passes ``sys.stdout``/``sys.stderr`` to APIs
+    such as :func:`subprocess.run` that require a real file descriptor.
+    To support that while avoiding the cost (and open-file-descriptor
+    lifetime concerns) of always backing the buffer with a real file,
+    a real temporary file is only allocated lazily, the first time
+    ``fileno()`` is actually requested.
+
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3.2
+        ``fileno()`` is now supported by lazily backing the buffer with
+        a real temporary file on first use.
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._real_file: t.BinaryIO | None = None
 
     def flush(self) -> None:
         super().flush()
         self.copy_to.flush()
+        if self._real_file is not None:
+            self._real_file.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
+        if self._real_file is not None:
+            return self._real_file.write(b)
         return super().write(b)
 
+    def fileno(self) -> int:
+        if self._real_file is None:
+            # Move the data captured so far into a real, file-descriptor
+            # backed temporary file so that ``fileno()`` works.
+            real_file = t.cast("t.BinaryIO", tempfile.TemporaryFile())
+            real_file.write(super().getvalue())
+            real_file.seek(self.tell())
+            self._real_file = real_file
+
+        return self._real_file.fileno()
+
+    def getvalue(self) -> bytes:
+        if self._real_file is not None:
+            pos = self._real_file.tell()
+            self._real_file.seek(0)
+            data = self._real_file.read()
+            self._real_file.seek(pos)
+            return data
+
+        return super().getvalue()
+
+    def close(self) -> None:
+        if self._real_file is not None:
+            self._real_file.close()
+        super().close()
+
 
