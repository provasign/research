-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """A binary stream backed by a real (fileno-capable) temporary file,
+    with everything written to it also copied to another buffer.
+
+    Unlike :class:`io.BytesIO`, this exposes a valid file descriptor via
+    ``fileno()``, so code under test can pass ``sys.stdout``/``sys.stderr``
+    to APIs such as :func:`subprocess.run` that require it.
 
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def __del__(self) -> None:
+        # Ensure the backing temporary file is released even if the
+        # owner forgets to close it explicitly.
+        file = self.__dict__.get("_file")
+        if file is not None:
+            file.close()
 
 
