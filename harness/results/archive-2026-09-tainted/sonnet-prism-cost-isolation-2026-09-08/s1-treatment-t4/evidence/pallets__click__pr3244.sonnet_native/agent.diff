+class BytesIOCopy:
+    """A binary stream that copies everything written to it to another
+    stream, while also being backed by a real OS-level file. This allows
+    the stream to be used as the ``stdout``/``stderr`` target of
+    :func:`subprocess.run` (or similar APIs that require a ``fileno()``),
+    which is not possible with a plain ``io.BytesIO``.
 
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3
+        Backed by a real file (via :func:`tempfile.TemporaryFile`) instead
+        of ``io.BytesIO``, so ``fileno()`` works as expected.
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file: t.IO[bytes] = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def fileno(self) -> int:
+        return self._file.fileno()
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
+    def __del__(self) -> None:
+        # Make sure the backing OS-level file is always closed, even if
+        # this object is garbage collected without an explicit ``close()``.
+        file = self.__dict__.get("_file")
+
+        if file is not None:
+            file.close()
 
 
