 class BytesIOCopy(io.BytesIO):
     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
+    Backed by a real, unbuffered temporary file (instead of only an
+    in-memory buffer) so that code invoked through :class:`CliRunner`,
+    such as :func:`subprocess.run`, can use it as ``stdout``/``stderr``
+    and call :meth:`fileno` on it without raising
+    :exc:`io.UnsupportedOperation`.
+
     .. versionadded:: 8.2
+    .. versionchanged:: 8.3.3
+        Back the stream with a real file descriptor so ``fileno()`` works.
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._tmpfile = tempfile.TemporaryFile(buffering=0)
+
+    def fileno(self) -> int:
+        return self._tmpfile.fileno()
+
+    def close(self) -> None:
+        self._tmpfile.close()
+        super().close()
 
     def flush(self) -> None:
         super().flush()
         self.copy_to.flush()
+        self._tmpfile.flush()
 
     def write(self, b: ReadableBuffer) -> int:
+        self._tmpfile.write(b)
         self.copy_to.write(b)
         return super().write(b)
 
+    def getvalue(self) -> bytes:
+        # Merge in anything written directly to the underlying file
+        # descriptor (for example, by a child process) that bypassed
+        # ``write()``.
+        self._tmpfile.seek(0)
+        data = self._tmpfile.read()
+        self._tmpfile.seek(0, os.SEEK_END)
+        if len(data) > super().tell():
+            super().truncate(0)
+            super().seek(0)
+            super().write(data)
+            super().seek(0, os.SEEK_END)
+        return super().getvalue()
+
 
