+        self._fd_file: t.IO[bytes] | None = None
+        self._fd_pos = 0
+
+    def fileno(self) -> int:
+        """Return a real file descriptor for this stream.
+
+        The wrapped buffer is an in-memory ``BytesIO``, which has no file
+        descriptor. Writable streams are therefore backed by a lazily
+        created temporary file, so code such as
+        ``subprocess.run(..., stdout=sys.stderr)`` works during isolation.
+        Anything written to the descriptor is copied back into the buffer
+        by :meth:`flush`, so it is still captured in the result.
+
+        .. versionadded:: 8.3.2
+        """
+        if "w" not in self._mode:
+            return super().fileno()
+
+        if self._fd_file is None:
+            # Flush pending text first so ordering is preserved.
+            super().flush()
+            self._fd_file = tempfile.TemporaryFile()
+
+        return self._fd_file.fileno()
+
+    def flush(self) -> None:
+        # Text written before ``fileno()`` handed out the descriptor was
+        # already flushed there, so descriptor output comes first.
+        self._sync_fd_file()
+        super().flush()
+
+    def _sync_fd_file(self) -> None:
+        """Copy anything written to the file descriptor returned by
+        :meth:`fileno` into the wrapped buffer.
+        """
+        if self._fd_file is None:
+            return
+
+        self._fd_file.seek(self._fd_pos)
+        data = self._fd_file.read()
+        self._fd_pos = self._fd_file.tell()
+
+        if data:
+            self.buffer.write(data)
+
+    def _close_fd_file(self) -> None:
+        """Copy any remaining descriptor output and release the temporary
+        file backing :meth:`fileno`.
+        """
+        if self._fd_file is None:
+            return
+
+        self._sync_fd_file()
+        self._fd_file.close()
+        self._fd_file = None
 
