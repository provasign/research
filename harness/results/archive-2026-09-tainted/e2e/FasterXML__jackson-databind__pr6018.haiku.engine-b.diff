+     */
+    private BeanSerializerBase _asBeanSerializer(ValueSerializer<?> ser) {
+        for (int i = 0; i < 100; i++) {
+            if (ser instanceof BeanSerializerBase bean) {
+                return bean;
+            }
+            ValueSerializer<?> delegatee = ser.getDelegatee();
+            if (delegatee == null || delegatee == ser) {
+                return null;
+            }
+            ser = delegatee;
+        }
+        return null;
+    }
