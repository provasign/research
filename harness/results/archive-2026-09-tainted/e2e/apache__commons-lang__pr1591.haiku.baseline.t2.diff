      *
      * @param cls the class to get the short name for.
@@ -1024,7 +1030,29 @@ public static String getShortClassName(final Class<?> cls) {
         if (cls == null) {
             return StringUtils.EMPTY;
         }
-        return getShortClassName(cls.getName());
+
+        // Handle array types using string-based logic
+        if (cls.isArray()) {
+            return getShortClassName(cls.getName());
+        }
+
+        // For local and anonymous classes, fall back to string-based logic
+        // to preserve compiler-generated ordinal naming
+        if (cls.isLocalClass() || cls.isAnonymousClass()) {
+            return getShortClassName(cls.getName());
+        }
+
+        // For top-level and member/nested classes, build using reflection metadata
+        final List<String> names = new ArrayList<>();
+        Class<?> current = cls;
+
+        while (current != null) {
+            names.add(current.getSimpleName());
+            current = current.getEnclosingClass();
+        }
+
+        Collections.reverse(names);
+        return String.join(".", names);
     }
 
