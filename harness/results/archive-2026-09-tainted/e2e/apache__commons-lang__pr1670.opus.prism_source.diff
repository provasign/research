+    /**
+     * Tests whether the given class name consists solely of the array marker {@code "[]"} repeated from the given index to the end.
+     *
+     * @param className the class name to test.
+     * @param fromIndex the index of the first array marker.
+     * @return whether the tail of the class name is a well-formed sequence of array markers.
+     */
+    private static boolean isArrayMarkerSuffix(final String className, final int fromIndex) {
+        final int len = className.length();
+        if ((len - fromIndex) % 2 != 0) {
+            return false;
+        }
+        for (int i = fromIndex; i < len; i += 2) {
+            if (className.charAt(i) != '[' || className.charAt(i + 1) != ']') {
+                return false;
+            }
+        }
+        return true;
+    }
