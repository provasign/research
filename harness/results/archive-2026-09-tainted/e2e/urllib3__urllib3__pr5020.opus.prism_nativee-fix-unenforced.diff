index 00000000..00afa547
--- /dev/null
+++ b/changelog/1367.bugfix.rst
@@ -0,0 +1 @@
+Replaced obs-fold (a CRLF followed by whitespace) in received response header values with a single space, as required by RFC 7230 Section 3.2.4, instead of keeping the CRLF in the header value.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 443cb01b..1eb006b6 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -78,6 +78,11 @@ RECENT_DATE = datetime.date(2025, 1, 1)
 
 _CONTAINS_CONTROL_CHAR_RE = re.compile(r"[^-!#$%&'*+.^_`|~0-9a-zA-Z]")
 
+# An obs-fold (RFC 7230 Section 3.2.4): a CRLF followed by at least one SP or HTAB.
+# A user agent MUST replace each received obs-fold with one or more SP octets
+# before interpreting the field value.
+_OBS_FOLD_RE = re.compile(r"\r?\n[ \t]+")
+
 
 class HTTPConnection(_HTTPConnection):
     """
@@ -616,7 +621,10 @@ class HTTPConnection(_HTTPConnection):
                 exc_info=True,
             )
 
-        headers = HTTPHeaderDict(httplib_response.msg.items())
+        headers = HTTPHeaderDict(
+            (key, _OBS_FOLD_RE.sub(" ", value))
+            for key, value in httplib_response.msg.items()
+        )
 
         response = HTTPResponse(
             body=httplib_response,
