diff --git a/changelog/3398.bugfix.rst b/changelog/3398.bugfix.rst
new file mode 100644
index 00000000..01baff78
--- /dev/null
+++ b/changelog/3398.bugfix.rst
@@ -0,0 +1,3 @@
+Fixed connecting to an HTTPS proxy with a ``proxy_ssl_context`` that verifies
+certificates while the target ``ssl_context`` uses ``CERT_NONE``. The target
+connection's verification mode is no longer applied to the proxy connection.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 8a89488d..3f709d20 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -915,9 +915,16 @@ class HTTPSConnection(HTTPConnection):
         # `_connect_tls_proxy` is called when self._tunnel_host is truthy.
         proxy_config = typing.cast(ProxyConfig, self.proxy_config)
         ssl_context = proxy_config.ssl_context
+        # The proxy connection is configured by the proxy's own SSLContext, so
+        # its verification requirements must not be overridden by the ones
+        # meant for the target connection (``self.ssl_context``).
+        if ssl_context is not None:
+            cert_reqs = ssl_context.verify_mode
+        else:
+            cert_reqs = self.cert_reqs
         sock_and_verified = _ssl_wrap_socket_and_match_hostname(
             sock,
-            cert_reqs=self.cert_reqs,
+            cert_reqs=cert_reqs,
             ssl_version=self.ssl_version,
             ssl_minimum_version=self.ssl_minimum_version,
             ssl_maximum_version=self.ssl_maximum_version,
