+package org.apache.commons.collections4.multiset;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Simple demonstration of the fix for clamping at Integer.MAX_VALUE.
+ */
+public class ClampDemo {
+    public static void main(String[] args) {
+        // Create a simple map-based multiset like AbstractMapMultiSet
+        Map<String, MutableInteger> map = new HashMap<>();
+        
+        String element = "test";
+        
+        // Add to reach near Integer.MAX_VALUE
+        map.put(element, new MutableInteger(Integer.MAX_VALUE - 10));
+        System.out.println("Before adding 20: " + map.get(element).value);
+        
+        // This would previously cause overflow and become negative
+        // Now it clamps at Integer.MAX_VALUE
+        final int value = map.get(element).value + 20;
+        map.get(element).value = Math.min(value, Integer.MAX_VALUE);
+        System.out.println("After adding 20: " + map.get(element).value);
+        
+        // Add even more to verify clamping works
+        final int value2 = map.get(element).value + 1000000;
+        map.get(element).value = Math.min(value2, Integer.MAX_VALUE);
+        System.out.println("After adding 1000000: " + map.get(element).value);
+        
+        System.out.println("Test completed successfully - clamping works!");
+    }
+    
+    static class MutableInteger {
+        int value;
+        
+        MutableInteger(int value) {
+            this.value = value;
+        }
+    }
+}
