diff --git a/changelog/3468.bugfix.rst b/changelog/3468.bugfix.rst
new file mode 100644
index 00000000..429cad4a
--- /dev/null
+++ b/changelog/3468.bugfix.rst
@@ -0,0 +1,3 @@
+Fixed the target connection's ``ssl_context`` verification mode leaking into the
+TLS handshake with an HTTPS proxy, which made it impossible to verify the proxy
+via ``proxy_ssl_context`` while skipping verification of the tunneled target.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 8a89488d..3c853b0e 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -915,9 +915,17 @@ class HTTPSConnection(HTTPConnection):
         # `_connect_tls_proxy` is called when self._tunnel_host is truthy.
         proxy_config = typing.cast(ProxyConfig, self.proxy_config)
         ssl_context = proxy_config.ssl_context
+        # The connection's ``cert_reqs`` applies to the target, not to the
+        # proxy. When a proxy SSL context is given it dictates its own
+        # verification mode, otherwise the connection's value is used.
+        cert_reqs: int | str | None
+        if ssl_context is not None:
+            cert_reqs = ssl_context.verify_mode
+        else:
+            cert_reqs = self.cert_reqs
         sock_and_verified = _ssl_wrap_socket_and_match_hostname(
             sock,
-            cert_reqs=self.cert_reqs,
+            cert_reqs=cert_reqs,
             ssl_version=self.ssl_version,
             ssl_minimum_version=self.ssl_minimum_version,
             ssl_maximum_version=self.ssl_maximum_version,
