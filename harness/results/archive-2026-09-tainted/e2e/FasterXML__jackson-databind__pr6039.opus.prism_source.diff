+    /**
+     * Helper method for checking whether given (unmatched) property name is to be
+     * ignored (or, with "includable" properties, not included) by name.
+     *<p>
+     * Note that when properties are matched case-insensitively, ignoral by name
+     * is matched case-insensitively as well (see [databind#5962]): otherwise
+     * a property removed from the property map could get through as "unknown".
+     *
+     * @since 2.18
+     */
+    protected boolean _shouldIgnoreByName(String propName)
+    {
+        if (IgnorePropertiesUtil.shouldIgnore(propName, _ignorableProps, _includableProps)) {
+            return true;
+        }
+        if ((_ignorableProps != null) && (_beanProperties != null)
+                && _beanProperties.isCaseInsensitive()) {
+            for (String ignorable : _ignorableProps) {
+                if (ignorable.equalsIgnoreCase(propName)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
