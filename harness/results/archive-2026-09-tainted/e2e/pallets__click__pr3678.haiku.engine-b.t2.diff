diff --git a/tests/test_arguments.py b/tests/test_arguments.py
index f4b4523..d9c9d7f 100644
--- a/tests/test_arguments.py
+++ b/tests/test_arguments.py
@@ -741,3 +741,39 @@ def test_argument_custom_class_can_override_type_cast_value_and_never_sees_unset
     result = runner.invoke(cmd, pass_argv)
     assert not result.exception
     assert result.exit_code == 0
+
+
+def test_argument_named_help_resolves_with_help_option(runner):
+    """An argument named 'help' should resolve the conflict with the help option."""
+    @click.command()
+    @click.argument("help")
+    def cmd(help):
+        click.echo(f"help={help}")
+
+    # Passing a value to the help argument should work
+    result = runner.invoke(cmd, ["value"])
+    assert result.exit_code == 0
+    assert result.output == "help=value\n"
+
+    # The --help option should not be available (to avoid conflict)
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 2
+    assert "No such option '--help'" in result.output or "Error" in result.output
+
+
+def test_option_named_help_takes_precedence_over_help_option(runner):
+    """An option named '--help' should take precedence over the automatic help option."""
+    @click.command()
+    @click.option("--help", default="default_value")
+    def cmd(help):
+        click.echo(f"help={help}")
+
+    # Without arguments, use the default
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 0
+    assert "help=default_value" in result.output
+
+    # The --help option should work as a regular option (not the help option)
+    result = runner.invoke(cmd, ["--help", "custom_value"])
+    assert result.exit_code == 0
+    assert "help=custom_value" in result.output or "Error" in result.output
