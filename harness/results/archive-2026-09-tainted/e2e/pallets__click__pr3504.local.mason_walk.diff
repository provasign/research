+#!/usr/bin/env python3
+"""
+Test script to verify that multi-line help text in fish shell completion works correctly.
+This tests the fix for the issue where newlines in help text would cause fish completion errors.
+"""
+
+import sys
+import os
+
+# Add the click source to path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'src'))
+
+from click.shell_completion import FishComplete, CompletionItem
+
+
+def test_multiline_help_escaping():
+    """Test that multiline help text is properly escaped for fish completion."""
+    
+    # Create a completion item with multiline help text (like the issue example)
+    item = CompletionItem(
+        value='--at',
+        type='plain', 
+        help='Attachment with explicit mimetype,\n--at image.jpg image/jpeg'
+    )
+
+    # Create FishComplete instance
+    fc = FishComplete(None, {}, 'test', '_TEST_COMPLETE')
+    
+    # Get the formatted completion
+    result = fc.format_completion(item)
+    
+    print("Raw result:")
+    print(repr(result))
+    print()
+    print("Formatted result:")
+    print(result)
+    print()
+    
+    # Verify that newlines are properly escaped
+    lines = result.split('\n')
+    print(f"Lines: {lines}")
+    
+    # Should have 3 lines: type, value, help
+    assert len(lines) == 3, f"Expected 3 lines, got {len(lines)}"
+    assert lines[0] == 'plain'
+    assert lines[1] == '--at'
+    
+    # The help line should contain escaped newlines (\n)
+    help_line = lines[2]
+    print(f"Help line: {repr(help_line)}")
+    
+    # Should contain the escaped newline
+    assert '\\n' in help_line, "Help text should contain escaped newlines"
+    
+    # Should contain the example text
+    assert 'image.jpg' in help_line.replace('\\n', ' ')
+    
+    print("✓ Test passed: multiline help text is properly escaped")
+    return True
+
+
+def test_normal_help_text():
+    """Test that normal (single line) help text still works."""
+    
+    item = CompletionItem(
+        value='--normal',
+        type='plain', 
+        help='Normal single line help text'
+    )
+
+    fc = FishComplete(None, {}, 'test', '_TEST_COMPLETE')
+    result = fc.format_completion(item)
+    
+    print("Normal help test:")
+    print(repr(result))
+    print()
+    
+    lines = result.split('\n')
+    assert len(lines) == 3
+    assert lines[0] == 'plain'
+    assert lines[1] == '--normal'
+    assert lines[2] == 'Normal single line help text'
+    
+    print("✓ Test passed: normal help text works correctly")
+    return True
+
+
+if __name__ == "__main__":
+    print("Testing fish completion multiline help escaping...")
+    print()
+    
+    try:
+        test_multiline_help_escaping()
+        print()
+        test_normal_help_text()
+        print()
+        print("All tests passed! ✓")
+        
+    except Exception as e:
+        print(f"Test failed: {e}")
+        sys.exit(1)
