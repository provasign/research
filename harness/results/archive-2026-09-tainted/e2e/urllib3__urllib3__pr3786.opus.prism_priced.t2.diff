@@ -780,6 +780,17 @@ class HTTPSConnection(HTTPConnection):
             if self.server_hostname is not None:
                 server_hostname = self.server_hostname
 
+            # When forwarding the TLS handshake is with the proxy, not the origin,
+            # so the proxy's own TLS configuration applies. See:
+            # https://github.com/urllib3/urllib3/issues/2577
+            ssl_context = self.ssl_context
+            assert_hostname = self.assert_hostname
+            assert_fingerprint = self.assert_fingerprint
+            if self.proxy_is_forwarding and self.proxy_config is not None:
+                ssl_context = self.proxy_config.ssl_context
+                assert_hostname = self.proxy_config.assert_hostname
+                assert_fingerprint = self.proxy_config.assert_fingerprint
+
             is_time_off = datetime.date.today() < RECENT_DATE
             if is_time_off:
