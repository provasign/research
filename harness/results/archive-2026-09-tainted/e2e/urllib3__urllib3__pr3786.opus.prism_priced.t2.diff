             )
             self.sock = sock_and_verified.socket
 
diff --git a/src/urllib3/poolmanager.py b/src/urllib3/poolmanager.py
index 3914dec2..32d311b4 100644
--- a/src/urllib3/poolmanager.py
+++ b/src/urllib3/poolmanager.py
@@ -585,6 +585,24 @@ class ProxyManager(PoolManager):
             port = port_by_scheme.get(proxy.scheme, 80)
             proxy = proxy._replace(port=port)
 
+        # In forwarding mode the TLS connection is established with the proxy,
+        # so 'ssl_context' (which configures the origin) is never used.
+        if (
+            use_forwarding_for_https
+            and connection_pool_kw.get("ssl_context") is not None
+        ):
+            if proxy_ssl_context is not None:
+                raise ValueError(
+                    "Can't specify both 'ssl_context' and 'proxy_ssl_context' "
+                    "when 'use_forwarding_for_https' is True, use only "
+                    "'proxy_ssl_context' to configure the connection to the proxy"
+                )
+            raise ValueError(
+                "Can't specify 'ssl_context' when 'use_forwarding_for_https' is True, "
+                "use 'proxy_ssl_context' instead to configure the connection "
+                "to the proxy"
+            )
+
         self.proxy = proxy
         self.proxy_headers = proxy_headers or {}
         self.proxy_ssl_context = proxy_ssl_context
