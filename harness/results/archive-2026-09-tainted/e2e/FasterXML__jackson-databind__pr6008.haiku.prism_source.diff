+    /**
+     * Helper method to detect if a deserializer has custom unwrapping logic.
+     *
+     * @since 3.1
+     */
+    private boolean _hasCustomUnwrappingDeserializer(ValueDeserializer<?> deser) {
+        // If unwrappingDeserializer() returns a different instance, it has custom logic
+        try {
+            ValueDeserializer<?> unwrapped = deser.unwrappingDeserializer(null, null);
+            return unwrapped != deser;
+        } catch (Exception e) {
+            // Defensive: if anything goes wrong, assume no custom unwrapping
+            return false;
+        }
+    }
