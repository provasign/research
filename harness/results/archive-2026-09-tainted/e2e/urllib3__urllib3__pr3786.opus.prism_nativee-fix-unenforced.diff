diff --git a/changelog/2577.bugfix.rst b/changelog/2577.bugfix.rst
new file mode 100644
index 00000000..afc6f0d0
--- /dev/null
+++ b/changelog/2577.bugfix.rst
@@ -0,0 +1,3 @@
+Fixed HTTPS proxies in forwarding mode (``use_forwarding_for_https=True``) using ``ssl_context``
+instead of ``proxy_ssl_context`` for the TLS connection to the proxy. Specifying ``ssl_context``
+together with ``use_forwarding_for_https=True`` now raises a ``ValueError``.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 84e1dab9..908919e3 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -793,6 +793,18 @@ class HTTPSConnection(HTTPConnection):
             # Remove trailing '.' from fqdn hostnames to allow certificate validation
             server_hostname_rm_dot = server_hostname.rstrip(".")
 
+            # When using a forwarding proxy the TLS connection is established
+            # with the proxy and not with the origin, so the proxy's own TLS
+            # configuration must be used instead of the origin's.
+            if self.proxy_is_forwarding and self.proxy_config is not None:
+                ssl_context = self.proxy_config.ssl_context
+                assert_hostname = self.proxy_config.assert_hostname
+                assert_fingerprint = self.proxy_config.assert_fingerprint
+            else:
+                ssl_context = self.ssl_context
+                assert_hostname = self.assert_hostname
+                assert_fingerprint = self.assert_fingerprint
+
             sock_and_verified = _ssl_wrap_socket_and_match_hostname(
                 sock=sock,
                 cert_reqs=self.cert_reqs,
@@ -806,10 +818,10 @@ class HTTPSConnection(HTTPConnection):
                 key_file=self.key_file,
                 key_password=self.key_password,
                 server_hostname=server_hostname_rm_dot,
-                ssl_context=self.ssl_context,
+                ssl_context=ssl_context,
                 tls_in_tls=tls_in_tls,
-                assert_hostname=self.assert_hostname,
-                assert_fingerprint=self.assert_fingerprint,
+                assert_hostname=assert_hostname,
+                assert_fingerprint=assert_fingerprint,
             )
             self.sock = sock_and_verified.socket
 
diff --git a/src/urllib3/poolmanager.py b/src/urllib3/poolmanager.py
index 3914dec2..b729eb8d 100644
--- a/src/urllib3/poolmanager.py
+++ b/src/urllib3/poolmanager.py
@@ -585,6 +585,25 @@ class ProxyManager(PoolManager):
             port = port_by_scheme.get(proxy.scheme, 80)
             proxy = proxy._replace(port=port)
 
+        # When forwarding to an HTTPS proxy the TLS connection is established
+        # with the proxy, so it must be configured with 'proxy_ssl_context'.
+        if (
+            proxy.scheme == "https"
+            and use_forwarding_for_https
+            and connection_pool_kw.get("ssl_context") is not None
+        ):
+            if proxy_ssl_context is not None:
+                raise ValueError(
+                    "Can't specify both 'ssl_context' and 'proxy_ssl_context' "
+                    "when 'use_forwarding_for_https' is True, only "
+                    "'proxy_ssl_context' is used to connect to the proxy"
+                )
+            raise ValueError(
+                "Can't specify 'ssl_context' when 'use_forwarding_for_https' "
+                "is True, use 'proxy_ssl_context' instead to configure the "
+                "TLS connection to the proxy"
+            )
+
         self.proxy = proxy
         self.proxy_headers = proxy_headers or {}
         self.proxy_ssl_context = proxy_ssl_context
