+    @classmethod
+    def unstyle_new_lines(cls, segments: Iterable["Segment"]) -> Iterable["Segment"]:
+        """Split segments so that line breaks are not styled.
+
+        This prevents styles (such as background colors) from bleeding on to the
+        following line.
+
+        Args:
+            segments (Iterable[Segment]): Segments potentially containing line feeds.
+
+        Yields:
+            Segment: Segments where no line break carries a style.
+        """
+        new_line_segment = cls("\n")
+        for segment in segments:
+            text, style, control = segment
+            if style is None or control or "\n" not in text:
+                yield segment
+            else:
+                while text:
+                    _text, new_line, text = text.partition("\n")
+                    if _text:
+                        yield cls(_text, style)
+                    if new_line:
+                        yield new_line_segment
+
