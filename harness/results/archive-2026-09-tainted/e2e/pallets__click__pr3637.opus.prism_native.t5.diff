 "(%(complete_func)s)";
 """
 
+# PowerShell passes the word being completed and the command line as an AST,
+# which map onto the COMP_CWORD and COMP_WORDS vars the other shells use.
+_SOURCE_PWSH = """\
+# PowerShell completion script for %(prog_name)s.
+# It calls %(prog_name)s with %(complete_var)s=pwsh_complete
+# (%(complete_var)s=powershell_complete also works) and turns each line of the
+# response into a completion result.
+Register-ArgumentCompleter -Native -CommandName %(prog_name)s -ScriptBlock {
+    param($wordToComplete, $commandAst, $cursorPosition);
+
+    $env:%(complete_var)s = 'pwsh_complete';
+    $env:COMP_WORDS = $commandAst.ToString();
+    $env:COMP_CWORD = $wordToComplete;
+    $prevEncoding = [Console]::OutputEncoding;
+    [Console]::OutputEncoding = [System.Text.Encoding]::UTF8;
+
+    try {
+        %(prog_name)s | ForEach-Object {
+            $type, $rest = $_ -split ',', 2;
+            $value, $help = $rest -split "`t", 2;
+
+            if (-not $help) {
+                $help = $value;
+            }
+
+            if ($type -eq 'plain') {
+                [System.Management.Automation.CompletionResult]::new(
+                    $value, $value, 'ParameterValue', $help
+                );
+            }
+        };
+    }
+    finally {
+        [Console]::OutputEncoding = $prevEncoding;
+        Remove-Item Env:%(complete_var)s;
+        Remove-Item Env:COMP_WORDS;
+        Remove-Item Env:COMP_CWORD;
+    };
+};
+"""
+
 
 class _SourceVarsDict(t.TypedDict):
     complete_func: str
@@ -456,9 +497,43 @@ class FishComplete(ShellComplete):
