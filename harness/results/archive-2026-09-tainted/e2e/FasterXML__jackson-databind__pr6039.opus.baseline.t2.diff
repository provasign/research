+    /**
+     * Helper method for checking whether given (unmatched) property should be
+     * quietly ignored, considering "ignorable" and "includable" property names.
+     *<p>
+     * NOTE: [databind#5962]: if case-insensitive property matching is enabled,
+     * ignorals need to be matched case-insensitively as well; otherwise a
+     * differently-cased variant of an ignored property would be reported as an
+     * unknown property.
+     *
+     * @since 2.18.9
+     */
+    protected boolean _shouldIgnoreProperty(String propName)
+    {
+        if (IgnorePropertiesUtil.shouldIgnore(propName, _ignorableProps, _includableProps)) {
+            return true;
+        }
+        if ((_ignorableProps != null) && (_beanProperties != null)
+                && _beanProperties.isCaseInsensitive()) {
+            for (String ignorable : _ignorableProps) {
+                if (ignorable.equalsIgnoreCase(propName)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
