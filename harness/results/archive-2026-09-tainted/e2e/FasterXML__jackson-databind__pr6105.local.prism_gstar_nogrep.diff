+    protected BasicBeanDescription _findStdTypeDesc(MapperConfig<?> config, JavaType type)
+    {
+        // Ensure proper resolution of primitive types and their wrappers
+        if (type.isPrimitive()) {
+            // For primitives, resolve to wrapper types for consistent handling
+            Class<?> raw = type.getRawClass();
+            if (raw == Boolean.TYPE) {
+                return BOOLEAN_DESC;
+            } else if (raw == Integer.TYPE) {
+                return INT_DESC;
+            } else if (raw == Long.TYPE) {
+                return LONG_DESC;
+            }
+        } else {
+            // Handle common non-primitive types for optimized resolution
+            Class<?> raw = type.getRawClass();
+            if (raw == String.class) {
+                return STRING_DESC;
+            } else if (raw == Object.class) {
+                return OBJECT_DESC;
+            }
+        }
+        return null;
+    }
