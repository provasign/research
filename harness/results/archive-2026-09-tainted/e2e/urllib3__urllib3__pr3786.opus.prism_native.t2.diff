diff --git a/changelog/2577.bugfix.rst b/changelog/2577.bugfix.rst
new file mode 100644
index 00000000..74714304
--- /dev/null
+++ b/changelog/2577.bugfix.rst
@@ -0,0 +1,4 @@
+Fixed HTTPS proxies configured with ``use_forwarding_for_https=True`` using the
+origin's ``ssl_context`` instead of ``proxy_ssl_context`` to establish the TLS
+connection to the proxy. Passing ``ssl_context`` together with
+``use_forwarding_for_https=True`` now raises a ``ValueError``.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 84e1dab9..af2bb55d 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -793,6 +793,24 @@ class HTTPSConnection(HTTPConnection):
             # Remove trailing '.' from fqdn hostnames to allow certificate validation
             server_hostname_rm_dot = server_hostname.rstrip(".")
 
+            # If we're forwarding through a proxy the TLS connection we're
+            # establishing is with the proxy itself, not the origin, so the
+            # proxy's own TLS configuration must be used.
+            if self.proxy_is_forwarding and self.proxy_config is not None:
+                proxy_config = self.proxy_config
+                ssl_context = proxy_config.ssl_context
+                assert_hostname = proxy_config.assert_hostname
+                assert_fingerprint = proxy_config.assert_fingerprint
+                # Features that aren't implemented for proxies yet:
+                cert_file = key_file = key_password = None
+            else:
+                ssl_context = self.ssl_context
+                assert_hostname = self.assert_hostname
+                assert_fingerprint = self.assert_fingerprint
+                cert_file = self.cert_file
+                key_file = self.key_file
+                key_password = self.key_password
+
             sock_and_verified = _ssl_wrap_socket_and_match_hostname(
                 sock=sock,
                 cert_reqs=self.cert_reqs,
@@ -802,14 +820,14 @@ class HTTPSConnection(HTTPConnection):
                 ca_certs=self.ca_certs,
                 ca_cert_dir=self.ca_cert_dir,
                 ca_cert_data=self.ca_cert_data,
-                cert_file=self.cert_file,
-                key_file=self.key_file,
-                key_password=self.key_password,
+                cert_file=cert_file,
+                key_file=key_file,
+                key_password=key_password,
                 server_hostname=server_hostname_rm_dot,
-                ssl_context=self.ssl_context,
+                ssl_context=ssl_context,
                 tls_in_tls=tls_in_tls,
-                assert_hostname=self.assert_hostname,
-                assert_fingerprint=self.assert_fingerprint,
+                assert_hostname=assert_hostname,
+                assert_fingerprint=assert_fingerprint,
             )
             self.sock = sock_and_verified.socket
 
diff --git a/src/urllib3/poolmanager.py b/src/urllib3/poolmanager.py
index 3914dec2..3a49348d 100644
--- a/src/urllib3/poolmanager.py
+++ b/src/urllib3/poolmanager.py
@@ -585,6 +585,22 @@ class ProxyManager(PoolManager):
             port = port_by_scheme.get(proxy.scheme, 80)
             proxy = proxy._replace(port=port)
 
+        # When forwarding to an HTTPS proxy the only TLS connection we make is
+        # to the proxy itself, so 'ssl_context' (which configures TLS with the
+        # origin) can't be honored. See: urllib3/urllib3#2577
+        if use_forwarding_for_https and connection_pool_kw.get("ssl_context"):
+            if proxy_ssl_context is not None:
+                raise ValueError(
+                    "Can't specify both 'ssl_context' and 'proxy_ssl_context' "
+                    "when 'use_forwarding_for_https' is True, only "
+                    "'proxy_ssl_context' is used to connect to the proxy"
+                )
+            raise ValueError(
+                "Can't specify 'ssl_context' when 'use_forwarding_for_https' "
+                "is True, use 'proxy_ssl_context' instead to configure TLS "
+                "with the proxy"
+            )
+
         self.proxy = proxy
         self.proxy_headers = proxy_headers or {}
         self.proxy_ssl_context = proxy_ssl_context
