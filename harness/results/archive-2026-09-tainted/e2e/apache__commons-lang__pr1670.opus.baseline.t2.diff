+    /**
+     * Tests whether the given class name ends with a well-formed sequence of {@code "[]"} array markers starting at the given index.
+     *
+     * @param className the class name to test.
+     * @param startIndex the index of the first {@code '['}.
+     * @return whether everything from {@code startIndex} on is a sequence of {@code "[]"} pairs.
+     */
+    private static boolean isArraySuffix(final String className, final int startIndex) {
+        final int len = className.length();
+        if ((len - startIndex) % 2 != 0) {
+            return false;
+        }
+        for (int i = startIndex; i < len; i += 2) {
+            if (className.charAt(i) != '[' || className.charAt(i + 1) != ']') {
+                return false;
+            }
+        }
+        return true;
+    }
