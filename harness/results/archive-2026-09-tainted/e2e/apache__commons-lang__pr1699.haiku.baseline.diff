diff --git a/TestFix.java b/TestFix.java
new file mode 100644
index 000000000..c0df795f9
--- /dev/null
+++ b/TestFix.java
@@ -0,0 +1,26 @@
+import org.apache.commons.lang3.StringUtils;
+import org.apache.commons.lang3.text.StrBuilder;
+
+public class TestFix {
+    public static void main(String[] args) {
+        System.out.println("Testing StringUtils.mid() with Integer.MAX_VALUE:");
+        try {
+            String result = StringUtils.mid("foobar", 3, Integer.MAX_VALUE);
+            System.out.println("  Result: \"" + result + "\"");
+            System.out.println("  Expected: \"bar\"");
+            System.out.println("  Pass: " + "bar".equals(result));
+        } catch (Exception e) {
+            System.out.println("  ERROR: " + e.getMessage());
+        }
+        
+        System.out.println("\nTesting StrBuilder.midString() with Integer.MAX_VALUE:");
+        try {
+            String result = new StrBuilder("hello goodbye hello").midString(14, Integer.MAX_VALUE);
+            System.out.println("  Result: \"" + result + "\"");
+            System.out.println("  Expected: \"hello\"");
+            System.out.println("  Pass: " + "hello".equals(result));
+        } catch (Exception e) {
+            System.out.println("  ERROR: " + e.getMessage());
+        }
+    }
+}
