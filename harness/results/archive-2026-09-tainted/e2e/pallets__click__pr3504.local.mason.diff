+#!/usr/bin/env python3
+
+import click
+from click.shell_completion import FishComplete, CompletionItem
+
+# Test the exact case from the failing test to see if there's an issue with control characters
+cli = click.Command(
+    "cli",
+    params=[
+        click.Option(
+            ["--at", "--attachment-type"],
+            type=(str, str),
+            multiple=True,
+            help=(
+                "\b\nAttachment with explicit mimetype,\n--at image.jpg image/jpeg"
+            ),
+        ),
+        click.Option(["--other"], help="Normal help"),
+    ],
+)
+
+# Create FishComplete instance
+fish_complete = FishComplete(cli, {}, "cli", "_CLI_COMPLETE")
+
+# Test what happens when we format a completion item with multiline help
+item = CompletionItem("--at", help="\b\nAttachment with explicit mimetype,\n--at image.jpg image/jpeg")
+result = fish_complete.format_completion(item)
+print("Raw result:")
+print(repr(result))
+print("\nFormatted result:")
+print(result)
+
+# Now simulate how Fish would parse this
+lines = result.split('\n')
+print(f"\nParsed lines:")
+for i, line in enumerate(lines):
+    print(f"  {i}: {repr(line)}")
+
+# The fish script expects:
+# Line 0: type (plain)
+# Line 1: value (--at) 
+# Line 2: help text with escaped newlines
+
+print(f"\nExpected Fish parsing:")
+print(f"Type: {lines[0]}")
+print(f"Value: {lines[1]}")
+print(f"Help: {lines[2]}")
+
+# Check if the help contains literal newlines vs escaped ones
+help_text = lines[2]
+print(f"\nHelp text analysis:")
+print(f"  Contains '\\n': {'\\n' in help_text}")
+print(f"  Contains actual newline: {'\n' in help_text}")
+
+# The key question is whether Fish can properly handle the backspace character
+# that's part of the original help text
+print(f"\nHelp text contains backspace character (\\x08): {chr(0x08) in help_text}")
