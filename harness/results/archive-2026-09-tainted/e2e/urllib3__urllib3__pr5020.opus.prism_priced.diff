@@ -0,0 +1 @@
+Fixed response header values containing an obs-fold (a line break followed by whitespace) keeping the line break. Each obs-fold is now replaced with a space, as required by RFC 7230, Section 3.2.4.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 443cb01b..c3d49a7a 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -78,6 +78,11 @@ RECENT_DATE = datetime.date(2025, 1, 1)
 
 _CONTAINS_CONTROL_CHAR_RE = re.compile(r"[^-!#$%&'*+.^_`|~0-9a-zA-Z]")
 
+# An obs-fold: a line break followed by whitespace, used by legacy senders to
+# continue a header value onto the next line. RFC 7230, Section 3.2.4 requires a
+# user agent to replace each obs-fold it receives with one or more SP octets.
+_OBS_FOLD_RE = re.compile(r"\r?\n[ \t]+")
+
 
 class HTTPConnection(_HTTPConnection):
     """
@@ -616,7 +621,10 @@ class HTTPConnection(_HTTPConnection):
                 exc_info=True,
             )
 
-        headers = HTTPHeaderDict(httplib_response.msg.items())
+        headers = HTTPHeaderDict(
+            (name, _OBS_FOLD_RE.sub(" ", value))
+            for name, value in httplib_response.msg.items()
+        )
 
         response = HTTPResponse(
             body=httplib_response,
