+    /**
+     * Moves a difference index back by one when it would split a surrogate pair, that is, when the character at the index
+     * is a low surrogate and the preceding (common) character is a high surrogate.
+     *
+     * @param index the index of the first difference, may be negative.
+     * @param css   the sequences that were compared, not null and containing no nulls.
+     * @return the index of the start of the surrogate pair, or {@code index} if no pair is split.
+     */
+    private static int adjustForSurrogatePair(final int index, final CharSequence... css) {
+        if (index <= 0 || !Character.isHighSurrogate(css[0].charAt(index - 1))) {
+            return index;
+        }
+        for (final CharSequence cs : css) {
+            if (index < cs.length() && Character.isLowSurrogate(cs.charAt(index))) {
+                return index - 1;
+            }
+        }
+        return index;
+    }
