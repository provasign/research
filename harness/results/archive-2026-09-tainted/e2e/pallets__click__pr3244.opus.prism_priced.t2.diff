@@ -107,6 +107,55 @@ class _NamedTextIOWrapper(io.TextIOWrapper):
         super().__init__(buffer, **kwargs)
         self._name = name
         self._mode = mode
+        self._fd_file: t.IO[bytes] | None = None
+        self._fd_pos = 0
+
+    def fileno(self) -> int:
+        """Return a real OS file descriptor for this stream.
+
+        The underlying buffer is a :class:`io.BytesIO`, which has no
+        descriptor, so anything handing the stream to a subprocess (such as
+        ``subprocess.run(..., stdout=sys.stderr)``) would fail. Back the
+        descriptor with a temporary file instead; whatever is written to it
+        is copied into the captured buffer on :meth:`flush`.
+
+        .. versionadded:: 8.3.3
+        """
+        if "w" not in self._mode:
+            # Input streams keep the previous behavior of the buffer.
+            return super().fileno()
+
+        if self._fd_file is None:
+            self._fd_file = tempfile.TemporaryFile("w+b")
+
+        # Writes already buffered here must land before anything the
+        # descriptor's user writes.
+        self.flush()
+        return self._fd_file.fileno()
+
+    def _drain_fd(self) -> None:
+        """Copy data written to the descriptor into the captured buffer."""
+        if self._fd_file is None:
+            return
+
+        self._fd_file.seek(self._fd_pos)
+        data = self._fd_file.read()
+        self._fd_pos = self._fd_file.tell()
+
+        if data:
+            self.buffer.write(data)
+
+    def flush(self) -> None:
+        # Drain first: anything the descriptor's user wrote happened before
+        # the text still buffered here is written out.
+        self._drain_fd()
+        super().flush()
+
+    def _close_fd(self) -> None:
+        if self._fd_file is not None:
+            self._drain_fd()
+            self._fd_file.close()
+            self._fd_file = None
 
