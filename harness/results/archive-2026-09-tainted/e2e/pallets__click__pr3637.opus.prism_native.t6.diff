+class PowerShellComplete(ShellComplete):
+    """Shell completion for PowerShell.
+
+    .. versionadded:: 8.3
+    """
+
+    name: t.ClassVar[str] = "pwsh"
+    source_template: t.ClassVar[str] = _SOURCE_PWSH
+
+    def get_completion_args(self) -> tuple[list[str], str]:
+        completion_args = os.environ.get("COMP_WORDS", "")
+        incomplete = os.environ.get("INCOMPLETE", "")
+        cwords = split_arg_string(completion_args)
+        args = cwords[1:]
+        return args, incomplete
+
+    def format_completion(self, item: CompletionItem[str]) -> str:
+        return f"{item.type},{item.value},{item.help if item.help else ' '}"
+
+
