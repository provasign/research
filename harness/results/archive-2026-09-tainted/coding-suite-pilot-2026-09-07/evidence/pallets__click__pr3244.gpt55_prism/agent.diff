+    def fileno(self) -> int:
+        if self._write_fd is None:
+            self._read_fd, self._write_fd = os.pipe()
+            self._pipe_reader = threading.Thread(target=self._forward_pipe, daemon=True)
+            self._pipe_reader.start()
+
+        return self._write_fd
+
+    def _forward_pipe(self) -> None:
+        assert self._read_fd is not None
+
+        while True:
+            chunk = os.read(self._read_fd, 8192)
+
+            if not chunk:
+                break
+
+            self.write(chunk)
+
+    def _wait_for_pipe_reader(self) -> None:
+        if self._pipe_reader is None:
+            return
+
+        # Give the reader thread a chance to forward data written through
+        # the file descriptor before the test result snapshots the buffer.
+        for _ in range(100):
+            size = len(super().getvalue())
+            time.sleep(0.001)
+
+            if len(super().getvalue()) == size:
+                break
+
+    def getvalue(self) -> bytes:
+        self._wait_for_pipe_reader()
+        return super().getvalue()
+
+    def close_fd(self) -> None:
+        if self._write_fd is not None:
+            os.close(self._write_fd)
+            self._write_fd = None
+
+        if self._pipe_reader is not None:
+            self._pipe_reader.join(timeout=1)
+            self._pipe_reader = None
+
+        if self._read_fd is not None:
+            os.close(self._read_fd)
+            self._read_fd = None
 
