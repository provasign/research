+#[cfg(unix)]
+fn os_string_size(s: &OsStr) -> usize {
+    use std::os::unix::ffi::OsStrExt;
+
+    s.as_bytes().len() + 1 + std::mem::size_of::<usize>()
+}
+
+#[cfg(windows)]
+fn os_string_size(s: &OsStr) -> usize {
+    s.to_string_lossy().encode_utf16().count() + 1 + std::mem::size_of::<usize>()
+}
+
+#[cfg(all(unix, not(target_os = "redox")))]
+fn max_argument_size() -> usize {
+    let env_size = env::vars_os()
+        .map(|(key, value)| os_string_size(&key) + os_string_size(&value))
+        .sum::<usize>();
+    let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+
+    if arg_max > 0 {
+        (arg_max as usize)
+            .saturating_sub(env_size)
+            .saturating_sub(2048)
+    } else {
+        128 * 1024
+    }
+}
+
+#[cfg(not(all(unix, not(target_os = "redox"))))]
+fn max_argument_size() -> usize {
+    let _ = env::vars_os;
+    128 * 1024
