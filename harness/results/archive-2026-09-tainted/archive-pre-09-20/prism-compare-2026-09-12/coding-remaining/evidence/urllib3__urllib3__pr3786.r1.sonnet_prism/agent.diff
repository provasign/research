+                    "'proxy_ssl_context' to configure the connection to the "
+                    "HTTPS proxy."
+                )
+            raise ValueError(
+                "'ssl_context' should not be used to configure the connection "
+                "to the HTTPS proxy when 'use_forwarding_for_https' is True, "
+                "use 'proxy_ssl_context' instead."
+            )
+
         self.proxy = proxy
         self.proxy_headers = proxy_headers or {}
         self.proxy_ssl_context = proxy_ssl_context
