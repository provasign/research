        "new_string": "            # Remove trailing '.' from fqdn hostnames to allow certificate validation\n            server_hostname_rm_dot = server_hostname.rstrip(\".\")\n\n            # When forwarding to an HTTPS proxy this connection is actually made\n            # to the proxy itself, not the destination, so we must use the\n            # proxy's SSL context/identity settings rather than the ones meant\n            # for verifying the destination.\n            if self.proxy_is_forwarding:\n                proxy_config = typing.cast(ProxyConfig, self.proxy_config)\n                connect_ssl_context = proxy_config.ssl_context\n                connect_assert_hostname = proxy_config.assert_hostname\n                connect_assert_fingerprint = proxy_config.assert_fingerprint\n            else:\n                connect_ssl_context = self.ssl_context\n                connect_assert_hostname = self.assert_hostname\n                connect_assert_fingerprint = self.assert_fingerprint\n\n            sock_and_verified = _ssl_wrap_socket_and_match_hostname(\n                sock=sock,\n                cert_reqs=self.cert_reqs,\n                ssl_version=self.ssl_version,\n                ssl_minimum_version=self.ssl_minimum_version,\n                ssl_maximum_version=self.ssl_maximum_version,\n                ca_certs=self.ca_certs,\n                ca_cert_dir=self.ca_cert_dir,\n                ca_cert_data=self.ca_cert_data,\n                cert_file=self.cert_file,\n                key_file=self.key_file,\n                key_password=self.key_password,\n                server_hostname=server_hostname_rm_dot,\n                ssl_context=connect_ssl_context,\n                tls_in_tls=tls_in_tls,\n                assert_hostname=connect_assert_hostname,\n                assert_fingerprint=connect_assert_fingerprint,\n            )"
      },
