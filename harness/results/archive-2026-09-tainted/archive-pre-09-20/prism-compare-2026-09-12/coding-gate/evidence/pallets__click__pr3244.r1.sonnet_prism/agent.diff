-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """A file-like binary stream that copies everything written to it
+    into another stream.
+
+    Unlike :class:`io.BytesIO`, this is backed by a real temporary
+    file, so it has an OS-level file descriptor. This lets code being
+    tested pass ``sys.stdout``/``sys.stderr`` to APIs such as
+    :func:`subprocess.run` that require a real file descriptor.
 
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3
+        Backed by a temporary file instead of :class:`io.BytesIO` so
+        that the stream has a valid ``fileno()``.
     """
 
-    def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+    def __init__(self, copy_to: BytesIOCopy | None) -> None:
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
-    def flush(self) -> None:
-        super().flush()
-        self.copy_to.flush()
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
 
     def write(self, b: ReadableBuffer) -> int:
-        self.copy_to.write(b)
-        return super().write(b)
+        if self.copy_to is not None:
+            self.copy_to.write(b)
+        return self._file.write(b)
+
+    def flush(self) -> None:
+        self._file.flush()
+        if self.copy_to is not None:
+            self.copy_to.flush()
+
+    def fileno(self) -> int:
+        return self._file.fileno()
+
+    def __del__(self) -> None:
+        # The underlying temporary file holds a real OS file descriptor.
+        # Close it explicitly so it doesn't trigger a ``ResourceWarning``
+        # when garbage collected, matching the previous ``io.BytesIO``
+        # behavior which needed no explicit close.
+        try:
+            self._file.close()
+        except Exception:
+            pass
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
 
 
