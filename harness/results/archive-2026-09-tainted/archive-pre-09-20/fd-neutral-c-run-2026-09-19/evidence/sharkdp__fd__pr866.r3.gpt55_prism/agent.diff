+#[cfg(unix)]
+fn command_arg_size_limit() -> usize {
+    use std::os::unix::ffi::OsStrExt;
+
+    let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+    let arg_max = if arg_max > 0 {
+        arg_max as usize
+    } else {
+        128 * 1024
+    };
+
+    let env_size = env::vars_os()
+        .map(|(key, value)| {
+            key.as_os_str().as_bytes().len()
+                + value.as_os_str().as_bytes().len()
+                + 2
+                + mem::size_of::<usize>()
+        })
+        .sum::<usize>();
+
+    arg_max.saturating_sub(env_size + 2048).max(4096)
+}
+
+#[cfg(not(unix))]
+fn command_arg_size_limit() -> usize {
+    32 * 1024
+}
+
+#[cfg(unix)]
+fn argument_size(arg: &OsStr) -> usize {
+    use std::os::unix::ffi::OsStrExt;
+
+    arg.as_bytes().len() + 1 + mem::size_of::<usize>()
+}
+
+#[cfg(not(unix))]
+fn argument_size(arg: &OsStr) -> usize {
+    arg.to_string_lossy().len() + 1
 }
 
