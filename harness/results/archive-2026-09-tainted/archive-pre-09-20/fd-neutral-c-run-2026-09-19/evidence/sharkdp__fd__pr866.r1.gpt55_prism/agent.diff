+
+const ARG_HEADROOM: usize = 2048;
+
+fn execute_batch_command(
+    command: &OsStr,
+    prefix_args: &[OsString],
+    path_args: &[OsString],
+    suffix_args: &[OsString],
+    buffer_output: bool,
+) -> ExitCode {
+    let mut cmd = Command::new(command);
+    cmd.stdin(Stdio::inherit());
+    cmd.stdout(Stdio::inherit());
+    cmd.stderr(Stdio::inherit());
+    cmd.args(prefix_args);
+    cmd.args(path_args);
+    cmd.args(suffix_args);
+
+    execute_command(cmd, &Mutex::new(()), buffer_output)
+}
+
+fn command_size(command: &OsStr, prefix_args: &[OsString], suffix_args: &[OsString]) -> usize {
+    argument_size(command)
+        + prefix_args
+            .iter()
+            .chain(suffix_args)
+            .map(|arg| argument_size(arg))
+            .sum::<usize>()
+}
+
+fn argument_size(arg: &OsStr) -> usize {
+    osstr_to_bytes(arg).len() + 1 + mem::size_of::<usize>()
+}
+
+fn environment_size() -> usize {
+    env::vars_os()
+        .map(|(key, value)| argument_size(&key) + osstr_to_bytes(&value).len() + 1)
+        .sum()
+}
+
+fn available_command_size() -> usize {
+    max_command_size()
+        .saturating_sub(environment_size())
+        .saturating_sub(ARG_HEADROOM)
+}
+
+#[cfg(all(unix, not(target_os = "redox")))]
+fn max_command_size() -> usize {
+    match unsafe { libc::sysconf(libc::_SC_ARG_MAX) } {
+        max if max > 0 => max as usize,
+        _ => 128 * 1024,
     }
 }
 
+#[cfg(any(windows, target_os = "redox"))]
+fn max_command_size() -> usize {
+    32 * 1024
+}
