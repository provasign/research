+
+fn execute_batch_command(
+    executable: &OsStr,
+    batch_args: &[BatchArgument],
+    path_args: &[OsString],
+    buffer_output: bool,
+) -> ExitCode {
+    let mut cmd = Command::new(executable);
+    cmd.stdin(Stdio::inherit());
+    cmd.stdout(Stdio::inherit());
+    cmd.stderr(Stdio::inherit());
+    for arg in batch_args {
+        match arg {
+            BatchArgument::Fixed(arg) => {
+                cmd.arg(arg);
+            }
+            BatchArgument::Paths => {
+                cmd.args(path_args);
+            }
+        }
+    }
+
+    execute_command(cmd, &Mutex::new(()), buffer_output)
+}
+
+enum BatchArgument {
+    Fixed(OsString),
+    Paths,
+}
+
+fn command_size(executable: &OsStr, args: &[BatchArgument]) -> usize {
+    argument_size(executable)
+        + args
+            .iter()
+            .map(|arg| match arg {
+                BatchArgument::Fixed(arg) => argument_size(arg),
+                BatchArgument::Paths => 0,
+            })
+            .sum::<usize>()
+}
+
+fn argument_size(arg: &OsStr) -> usize {
+    os_str_len(arg) + 1 + mem::size_of::<usize>()
+}
+
+#[cfg(unix)]
+fn os_str_len(arg: &OsStr) -> usize {
+    use std::os::unix::ffi::OsStrExt;
+
+    arg.as_bytes().len()
+}
+
+#[cfg(not(unix))]
+fn os_str_len(arg: &OsStr) -> usize {
+    arg.to_string_lossy().len()
+}
+
+fn command_size_limit() -> usize {
+    const FALLBACK_LIMIT: usize = 128 * 1024;
+    const MIN_LIMIT: usize = 4 * 1024;
+    const HEADROOM: usize = 2 * 1024;
+
+    platform_arg_max()
+        .unwrap_or(FALLBACK_LIMIT)
+        .saturating_sub(environment_size())
+        .saturating_sub(HEADROOM)
+        .max(MIN_LIMIT)
+}
+
+fn environment_size() -> usize {
+    env::vars_os()
+        .map(|(key, value)| argument_size(&key) + argument_size(&value))
+        .sum()
+}
+
+#[cfg(all(unix, not(target_os = "redox")))]
+fn platform_arg_max() -> Option<usize> {
+    let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+    if arg_max > 0 {
+        Some(arg_max as usize)
+    } else {
+        None
     }
 }
 
+#[cfg(any(not(unix), target_os = "redox"))]
+fn platform_arg_max() -> Option<usize> {
+    None
+}
