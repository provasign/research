+fn command_line_limit() -> usize {
+    command_line_limit_impl().unwrap_or(COMMAND_LINE_LIMIT_FALLBACK)
+}
+
+#[cfg(all(unix, not(target_os = "redox")))]
+fn command_line_limit_impl() -> Option<usize> {
+    let limit = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+
+    if limit > 0 {
+        Some(limit as usize)
+    } else {
+        None
     }
 }
 
+#[cfg(windows)]
+fn command_line_limit_impl() -> Option<usize> {
