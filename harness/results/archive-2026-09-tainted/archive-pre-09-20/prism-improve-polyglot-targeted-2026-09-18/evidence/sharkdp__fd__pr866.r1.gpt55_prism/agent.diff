+
+#[cfg(any(not(any(unix, windows)), target_os = "redox"))]
+fn command_line_limit_impl() -> Option<usize> {
+    None
+}
+
+fn inherited_environment_size() -> usize {
+    std::env::vars_os()
+        .map(|(key, value)| argument_size(&key) + os_string_length(&value) + 1)
+        .sum()
+}
+
+fn argument_size(arg: &OsStr) -> usize {
+    os_string_length(arg) + 1 + mem::size_of::<usize>()
+}
+
+#[cfg(unix)]
+fn os_string_length(value: &OsStr) -> usize {
+    use std::os::unix::ffi::OsStrExt;
+
+    value.as_bytes().len()
+}
+
+#[cfg(windows)]
+fn os_string_length(value: &OsStr) -> usize {
+    use std::os::windows::ffi::OsStrExt;
+
+    value.encode_wide().count()
+}
+
+#[cfg(not(any(unix, windows)))]
+fn os_string_length(value: &OsStr) -> usize {
+    value.to_string_lossy().len()
+}
