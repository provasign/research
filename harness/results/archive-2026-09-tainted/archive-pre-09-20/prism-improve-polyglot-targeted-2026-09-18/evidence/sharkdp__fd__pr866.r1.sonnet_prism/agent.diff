+/// Returns the maximum combined size (in bytes) of the arguments that should be passed to a
+/// single invocation of a batch command, leaving some room for the environment and other
+/// overhead so that the OS's `ARG_MAX` limit (see `getconf ARG_MAX`) is not exceeded.
+fn batch_size_limit() -> usize {
+    #[cfg(all(unix, not(target_os = "redox")))]
+    {
+        let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+        let arg_max = if arg_max > 0 { arg_max as usize } else { 128 * 1024 };
+        let env_size: usize = std::env::vars_os()
+            .map(|(key, value)| key.len() + value.len() + 2)
+            .sum();
+        arg_max.saturating_sub(env_size).saturating_sub(4096).max(4096)
+    }
+    #[cfg(not(all(unix, not(target_os = "redox"))))]
+    {
+        // Conservative default for platforms without a way to query the limit (e.g. Windows'
+        // command line length limit is around 32767 characters).
+        16 * 1024
+    }
+}
