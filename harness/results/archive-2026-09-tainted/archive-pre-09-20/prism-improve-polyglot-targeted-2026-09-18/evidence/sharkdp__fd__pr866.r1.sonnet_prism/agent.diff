+/// Splits a slice into chunks so that the total "size" (as computed by `size_of`) of each chunk
+/// does not exceed `limit`. A single oversized element is still placed alone in its own chunk.
+trait ChunksBySize<T> {
+    fn chunks_by_size<F>(&self, limit: usize, size_of: F) -> ChunkBySizeIter<'_, T, F>
+    where
+        F: FnMut(&T) -> usize;
+}
+
+impl<T> ChunksBySize<T> for [T] {
+    fn chunks_by_size<F>(&self, limit: usize, size_of: F) -> ChunkBySizeIter<'_, T, F>
+    where
+        F: FnMut(&T) -> usize,
+    {
+        ChunkBySizeIter {
+            items: self,
+            limit,
+            size_of,
         }
     }
 }
 
+struct ChunkBySizeIter<'a, T, F> {
+    items: &'a [T],
+    limit: usize,
+    size_of: F,
+}
+
+impl<'a, T, F> Iterator for ChunkBySizeIter<'a, T, F>
+where
+    F: FnMut(&T) -> usize,
+{
+    type Item = &'a [T];
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.items.is_empty() {
+            return None;
+        }
+
+        let mut total = 0;
+        let mut end = 0;
+
+        for item in self.items {
+            let size = (self.size_of)(item);
+            if end > 0 && total + size > self.limit {
+                break;
+            }
+            total += size;
+            end += 1;
+        }
+
+        let (chunk, rest) = self.items.split_at(end);
+        self.items = rest;
+        Some(chunk)
+    }
+}
