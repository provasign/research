 class BytesIOCopy(io.BytesIO):
     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
+    Backed by a real (temporary) file so that it exposes a working
+    ``fileno()``. This lets code under test pass ``sys.stdout``/
+    ``sys.stderr`` directly to APIs such as :func:`subprocess.run` without
+    raising ``io.UnsupportedOperation``.
+
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._file = tempfile.TemporaryFile()
+
+    def fileno(self) -> int:
+        return self._file.fileno()
 
     def flush(self) -> None:
         super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
+        self._file.write(b)
         return super().write(b)
 
+    def close(self) -> None:
+        self._file.close()
+        super().close()
+
 
