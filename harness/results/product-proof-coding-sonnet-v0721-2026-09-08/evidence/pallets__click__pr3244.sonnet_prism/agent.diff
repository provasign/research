 class BytesIOCopy(io.BytesIO):
     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
+    Also supports ``fileno()`` on demand: the first time it is requested (for
+    example, by :func:`subprocess.run` when this stream is passed as
+    ``stdout``/``stderr``) the in-memory data is transferred to a real,
+    file-descriptor-backed temporary file, and further reads/writes are
+    delegated to it. Until ``fileno()`` is called, this behaves like a plain
+    ``io.BytesIO`` and never touches the filesystem.
+
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._fd_file: t.IO[bytes] | None = None
 
     def flush(self) -> None:
         super().flush()
         self.copy_to.flush()
+        if self._fd_file is not None:
+            self._fd_file.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
+
+        if self._fd_file is not None:
+            return self._fd_file.write(b)
+
         return super().write(b)
 
+    def getvalue(self) -> bytes:
+        if self._fd_file is not None:
+            pos = self._fd_file.tell()
+            try:
+                self._fd_file.seek(0)
+                return self._fd_file.read()
+            finally:
+                self._fd_file.seek(pos)
+
+        return super().getvalue()
+
+    def fileno(self) -> int:
+        if self._fd_file is None:
+            self._fd_file = tempfile.TemporaryFile()
+            self._fd_file.write(super().getvalue())
+            self._fd_file.seek(self.tell())
+
+        return self._fd_file.fileno()
+
+    def close(self) -> None:
+        if self._fd_file is not None:
+            self._fd_file.close()
+
+        super().close()
+
 
