+fn execute_batch_command(
+    executable: &OsStr,
+    args_before_paths: &[OsString],
+    paths: &[OsString],
+    args_after_paths: &[OsString],
+    buffer_output: bool,
+) -> ExitCode {
+    let mut cmd = Command::new(executable);
+    cmd.stdin(Stdio::inherit());
+    cmd.stdout(Stdio::inherit());
+    cmd.stderr(Stdio::inherit());
+
+    cmd.args(args_before_paths);
+    cmd.args(paths);
+    cmd.args(args_after_paths);
+
+    execute_command(cmd, &Mutex::new(()), buffer_output)
+}
+
+fn command_args_size_limit() -> usize {
+    let arg_max = platform_arg_max();
+    let env_size = env::vars_os()
+        .map(|(key, value)| os_str_len(&key) + os_str_len(&value) + 2 + mem::size_of::<usize>())
+        .sum::<usize>();
+
+    arg_max.saturating_sub(env_size).saturating_sub(2048)
+}
+
+#[cfg(all(unix, not(target_os = "redox")))]
+fn platform_arg_max() -> usize {
+    match unsafe { libc::sysconf(libc::_SC_ARG_MAX) } {
+        n if n > 0 => n as usize,
+        _ => 128 * 1024,
+    }
+}
+
+#[cfg(any(not(unix), target_os = "redox"))]
+fn platform_arg_max() -> usize {
+    32 * 1024
+}
+
+fn command_arg_size(arg: &OsStr) -> usize {
+    os_str_len(arg) + 1 + mem::size_of::<usize>()
+}
+
+#[cfg(unix)]
+fn os_str_len(s: &OsStr) -> usize {
+    s.as_bytes().len()
+}
+
+#[cfg(not(unix))]
+fn os_str_len(s: &OsStr) -> usize {
+    s.to_string_lossy().len()
+}
