+}
+
+fn command_arg_size(arg: &OsStr) -> usize {
+    os_str_len(arg) + 1 + std::mem::size_of::<usize>()
+}
+
+#[cfg(unix)]
+fn os_str_len(arg: &OsStr) -> usize {
+    use std::os::unix::ffi::OsStrExt;
