+fn execute_batch_command(
+    executable: &OsStr,
+    args_before_placeholder: &[OsString],
+    path_args: &[OsString],
+    args_after_placeholder: &[OsString],
+    buffer_output: bool,
+) -> ExitCode {
+    let mut cmd = Command::new(executable);
+    cmd.stdin(Stdio::inherit());
+    cmd.stdout(Stdio::inherit());
+    cmd.stderr(Stdio::inherit());
+    cmd.args(args_before_placeholder);
+    cmd.args(path_args);
+    cmd.args(args_after_placeholder);
+    execute_command(cmd, &Mutex::new(()), buffer_output)
+}
+
+fn args_size(args: &[OsString]) -> usize {
+    args.iter().map(|arg| command_size(arg)).sum()
+}
+
+#[cfg(unix)]
+fn command_size(arg: &OsStr) -> usize {
+    arg.as_bytes().len() + 1 + std::mem::size_of::<usize>()
+}
+
+#[cfg(not(unix))]
+fn command_size(arg: &OsStr) -> usize {
+    arg.to_string_lossy().len() + 1 + std::mem::size_of::<usize>()
+}
+
+fn command_size_limit(
+    executable: &OsStr,
+    args_before_placeholder: &[OsString],
+    args_after_placeholder: &[OsString],
+) -> usize {
+    const FALLBACK_ARG_MAX: usize = 32 * 1024;
+    const HEADROOM: usize = 2 * 1024;
+
+    let arg_max = system_arg_max();
+    let env_size = env::vars_os()
+        .map(|(key, value)| command_size(&key) + command_size(&value))
+        .sum::<usize>();
+    let fixed_size = command_size(executable)
+        + args_size(args_before_placeholder)
+        + args_size(args_after_placeholder);
+
+    let limit = arg_max.saturating_sub(env_size).saturating_sub(HEADROOM);
+    if limit > fixed_size {
+        limit
+    } else {
+        fixed_size.saturating_add(FALLBACK_ARG_MAX)
+    }
+}
+
+#[cfg(all(unix, not(target_os = "redox")))]
+fn system_arg_max() -> usize {
+    let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+    if arg_max > 0 {
+        arg_max as usize
+    } else {
+        32 * 1024
+    }
+}
+
+#[cfg(any(not(unix), target_os = "redox"))]
+fn system_arg_max() -> usize {
+    32 * 1024
+}
