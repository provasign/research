-class BytesIOCopy(io.BytesIO):
-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """A real, file descriptor backed buffer that copies everything written
+    to it into another buffer.
+
+    Being backed by a real file (rather than :class:`io.BytesIO`) means it
+    has a working ``fileno()``, so it can be passed to APIs such as
+    :func:`subprocess.run` that require an actual file descriptor.
 
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
 
 
