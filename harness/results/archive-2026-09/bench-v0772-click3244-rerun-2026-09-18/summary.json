            "old_string": "class BytesIOCopy(io.BufferedRandom):\n    \"\"\"A stream backed by a real temporary file (so it has a working\n    ``fileno()``, unlike :class:`io.BytesIO`) that also copies everything\n    written to it to another stream.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__(t.cast(\"t.BinaryIO\", tempfile.TemporaryFile()))\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)\n\n    def getvalue(self) -> bytes:\n        pos = self.tell()\n        self.flush()\n        self.seek(0)\n        data = self.read()\n        self.seek(pos)\n        return data",
            "new_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    A real, OS-backed file is created lazily the first time ``fileno()``\n    is accessed (for example by :func:`subprocess.run`), so the common\n    case of only reading/writing in memory never opens a file descriptor.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n        self._real_file: t.IO[bytes] | None = None\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n        if self._real_file is not None:\n            self._real_file.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        if self._real_file is not None:\n            self._real_file.write(b)\n        return super().write(b)\n\n    def fileno(self) -> int:\n        if self._real_file is None:\n            self._real_file = tempfile.TemporaryFile()\n            self._real_file.write(super().getvalue())\n            self._real_file.flush()\n        return self._real_file.fileno()\n\n    def getvalue(self) -> bytes:\n        if self._real_file is None:\n            return super().getvalue()\n        self._real_file.flush()\n        pos = self._real_file.tell()\n        self._real_file.seek(0)\n        data = self._real_file.read()\n        self._real_file.seek(pos)\n        return data\n\n    def close(self) -> None:\n        if self._real_file is not None:\n            self._real_file.close()\n        super().close()"
