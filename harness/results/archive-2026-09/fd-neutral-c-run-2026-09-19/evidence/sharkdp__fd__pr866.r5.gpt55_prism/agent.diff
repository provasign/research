+fn command_size(executable: &OsStr) -> usize {
+    osstr_size(executable) + env_size()
+}
+
+fn osstr_size(value: &OsStr) -> usize {
+    osstr_len(value) + 1 + std::mem::size_of::<usize>()
+}
+
+#[cfg(unix)]
+fn osstr_len(value: &OsStr) -> usize {
+    value.as_bytes().len()
+}
+
+#[cfg(not(unix))]
+fn osstr_len(value: &OsStr) -> usize {
+    value.to_string_lossy().len()
+}
+
+fn env_size() -> usize {
+    std::env::vars_os()
+        .map(|(key, value)| osstr_size(&key) + osstr_size(&value))
+        .sum()
+}
