+fn execute_batch_command(
+    executable: &OsStr,
+    prefix_args: &[OsString],
+    path_args: &[OsString],
+    suffix_args: &[OsString],
+    buffer_output: bool,
+) -> ExitCode {
+    let mut cmd = Command::new(executable);
+    cmd.stdin(Stdio::inherit());
+    cmd.stdout(Stdio::inherit());
+    cmd.stderr(Stdio::inherit());
+    cmd.args(prefix_args);
+    cmd.args(path_args);
+    cmd.args(suffix_args);
+
+    execute_command(cmd, &Mutex::new(()), buffer_output)
+}
+
+fn command_size_limit() -> usize {
+    let limit = platform_arg_max()
+        .saturating_sub(environment_size())
+        .saturating_sub(ARG_MAX_HEADROOM);
+
+    if limit == 0 {
+        DEFAULT_ARG_MAX / 4
+    } else {
+        limit
+    }
+}
+
+#[cfg(unix)]
+fn platform_arg_max() -> usize {
+    let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+    if arg_max > 0 {
+        arg_max as usize
+    } else {
+        DEFAULT_ARG_MAX
     }
 }
 
+#[cfg(not(unix))]
+fn platform_arg_max() -> usize {
+    DEFAULT_ARG_MAX
+}
+
+fn environment_size() -> usize {
+    std::env::vars_os()
+        .map(|(key, value)| os_str_len(&key) + os_str_len(&value) + 2 + pointer_size())
+        .sum()
+}
+
+fn argument_size(arg: &OsStr) -> usize {
+    os_str_len(arg) + 1 + pointer_size()
+}
+
+fn pointer_size() -> usize {
+    std::mem::size_of::<usize>()
+}
+
+#[cfg(unix)]
+fn os_str_len(s: &OsStr) -> usize {
+    use std::os::unix::ffi::OsStrExt;
+    s.as_bytes().len()
+}
+
+#[cfg(not(unix))]
+fn os_str_len(s: &OsStr) -> usize {
+    s.to_string_lossy().len()
+}
