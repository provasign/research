+fn execute_batch_command(
+    program: &OsStr,
+    leading_args: &[OsString],
+    batch: &[OsString],
+    trailing_args: &[OsString],
+    buffer_output: bool,
+) -> ExitCode {
+    let mut cmd = Command::new(program);
+    cmd.stdin(Stdio::inherit());
+    cmd.stdout(Stdio::inherit());
+    cmd.stderr(Stdio::inherit());
+    cmd.args(leading_args);
+    cmd.args(batch);
+    cmd.args(trailing_args);
+
+    execute_command(cmd, &Mutex::new(()), buffer_output)
+}
+
+#[cfg(all(unix, not(target_os = "redox")))]
+fn max_arg_size() -> usize {
+    let env_size = std::env::vars_os()
+        .map(|(key, value)| argument_size(&key) + argument_size(&value))
+        .sum::<usize>();
+    let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+    let arg_max = if arg_max > 0 {
+        arg_max as usize
+    } else {
+        128 * 1024
+    };
+
+    arg_max.saturating_sub(env_size).saturating_sub(2048)
+}
+
+#[cfg(any(not(unix), target_os = "redox"))]
+fn max_arg_size() -> usize {
+    128 * 1024
+}
+
+#[cfg(unix)]
+fn argument_size(arg: &OsStr) -> usize {
+    arg.as_bytes().len() + 1
+}
+
+#[cfg(not(unix))]
+fn argument_size(arg: &OsStr) -> usize {
+    arg.to_string_lossy().len() + 1
+}
