+fn fixed_command_size(args: &[OsString], path_arg: usize) -> usize {
+    let fixed_args = args.len() - 1;
+
+    args.iter()
+        .enumerate()
+        .filter(|(i, _)| *i != path_arg)
+        .map(|(_, arg)| os_string_size(arg))
+        .sum::<usize>()
+        + (fixed_args + env::vars_os().count() + 2) * std::mem::size_of::<usize>()
+}
+
+fn max_command_size() -> usize {
+    command_size_limit().saturating_sub(environment_size() + ARG_HEADROOM)
+}
+
+#[cfg(all(unix, not(target_os = "redox")))]
+fn command_size_limit() -> usize {
+    let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+
+    if arg_max > 0 {
+        arg_max as usize
+    } else {
+        DEFAULT_ARG_MAX
+    }
+}
+
+#[cfg(any(not(unix), target_os = "redox"))]
+fn command_size_limit() -> usize {
+    DEFAULT_ARG_MAX
+}
+
+fn environment_size() -> usize {
+    env::vars_os()
+        .map(|(key, value)| os_str_size(&key) + os_str_size(&value) + 1)
+        .sum()
+}
+
+fn os_string_size(value: &OsString) -> usize {
+    os_str_size(value.as_os_str())
+}
+
+#[cfg(any(unix, target_os = "redox"))]
+fn os_str_size(value: &OsStr) -> usize {
+    value.as_bytes().len() + 1
+}
+
+#[cfg(not(any(unix, target_os = "redox")))]
+fn os_str_size(value: &OsStr) -> usize {
+    value.len() + 1
+}
