+/// Determine the maximum length (in bytes) that should be used for a batch of
+/// command-line arguments, leaving some headroom below the platform's actual
+/// maximum to account for the executable path and the environment.
+fn max_command_arg_length() -> usize {
+    #[cfg(all(unix, not(target_os = "redox")))]
+    fn platform_arg_max() -> usize {
+        let arg_max = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+        if arg_max <= 0 {
+            // Fall back to a conservative default (POSIX minimum is 4096, but
+            // most systems support much more).
+            128 * 1024
         } else {
-            ExitCode::Success
+            arg_max as usize
         }
     }
+
+    #[cfg(not(all(unix, not(target_os = "redox"))))]
+    fn platform_arg_max() -> usize {
+        // Windows' CreateProcess has a command-line length limit of ~32767
+        // characters. Other platforms without a known limit use a
+        // conservative default as well.
+        32 * 1024
+    }
+
+    // Reserve half of the available space for the environment and other
+    // fixed overhead, similar to what GNU xargs does.
+    platform_arg_max() / 2
