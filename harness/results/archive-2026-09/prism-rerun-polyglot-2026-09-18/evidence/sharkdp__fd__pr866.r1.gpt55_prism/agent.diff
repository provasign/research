+fn execute_batch_command(
+    executable: &OsStr,
+    fixed_args_before: &[OsString],
+    path_args: &[OsString],
+    fixed_args_after: &[OsString],
+    buffer_output: bool,
+) -> ExitCode {
+    let mut cmd = Command::new(executable);
+    cmd.stdin(Stdio::inherit());
+    cmd.stdout(Stdio::inherit());
+    cmd.stderr(Stdio::inherit());
+    cmd.args(fixed_args_before);
+    cmd.args(path_args);
+    cmd.args(fixed_args_after);
+    execute_command(cmd, &Mutex::new(()), buffer_output)
+}
+
+fn command_arg_size(arg: &OsStr) -> usize {
+    os_str_len(arg) + 1 + mem::size_of::<usize>()
+}
+
+fn batch_command_size_limit() -> usize {
+    argument_size_limit()
+        .unwrap_or(DEFAULT_BATCH_COMMAND_SIZE_LIMIT)
+        .saturating_sub(environment_size())
+        .saturating_sub(BATCH_COMMAND_SIZE_MARGIN)
+        .max(1)
+}
+
+#[cfg(all(unix, not(target_os = "redox")))]
+fn argument_size_limit() -> Option<usize> {
+    let limit = unsafe { libc::sysconf(libc::_SC_ARG_MAX) };
+    if limit > 0 {
+        Some(limit as usize)
+    } else {
+        None
+    }
+}
+
+#[cfg(not(all(unix, not(target_os = "redox"))))]
+fn argument_size_limit() -> Option<usize> {
+    None
+}
+
+fn environment_size() -> usize {
+    std::env::vars_os()
+        .map(|(key, value)| os_str_len(&key) + os_str_len(&value) + 2 + mem::size_of::<usize>())
+        .sum::<usize>()
+        + mem::size_of::<usize>()
+}
+
+#[cfg(unix)]
+fn os_str_len(value: &OsStr) -> usize {
+    use std::os::unix::ffi::OsStrExt;
+    value.as_bytes().len()
+}
+
+#[cfg(windows)]
+fn os_str_len(value: &OsStr) -> usize {
+    use std::os::windows::ffi::OsStrExt;
+    value.encode_wide().count()
+}
+
+#[cfg(not(any(unix, windows)))]
+fn os_str_len(value: &OsStr) -> usize {
+    value.to_string_lossy().len()
+}
