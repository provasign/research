@@ -590,8 +590,19 @@ class HTTPAdapter(BaseAdapter):
             using_socks_proxy = proxy_scheme.startswith("socks")
 
         url = request.path_url
-        if url.startswith("//"):  # Don't confuse urllib3
-            url = f"/{url.lstrip('/')}"
+        if url.startswith("//"):
+            # A URL with excess leading "/" (path-separator)s can cause
+            # urllib3 to misinterpret it as a scheme-relative URL with its
+            # own "//host:port" authority (see #6643). Only trim the extra
+            # slashes when the remainder actually looks like such an
+            # authority (i.e. its first path segment contains a ":"),
+            # otherwise leave them alone -- paths that intentionally start
+            # with "/" (e.g. presigned S3 URLs for keys beginning with "/")
+            # must not be modified or their signature will no longer match.
+            remainder = url.lstrip("/")
+            first_segment = remainder.split("/", 1)[0]
+            if ":" in first_segment:
+                url = f"/{remainder}"
 
         if is_proxied_http_request and not using_socks_proxy:
             url = urldefragauth(request.url)
