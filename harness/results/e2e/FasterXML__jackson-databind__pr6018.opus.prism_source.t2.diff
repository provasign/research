+    /*
+    /**********************************************************************
+    /* Mutant factories
+    /**********************************************************************
+     */
+
+    /**
+     * Overridden to support {@code @JsonUnwrapped} by delegating unwrapping to the
+     * serializer of the converted ("delegate") value: if that serializer supports
+     * unwrapping, so does this one.
+     *
+     * @since 3.2
+     */
+    @Override
+    public ValueSerializer<Object> unwrappingSerializer(NameTransformer unwrapper) {
+        // For "dynamic" case (delegate type only known at runtime) we have nothing
+        // to delegate to, so cannot unwrap
+        if (_delegateSerializer == null) {
+            return this;
+        }
+        ValueSerializer<Object> unwrappingDelegate = _delegateSerializer.unwrappingSerializer(unwrapper);
+        if (unwrappingDelegate == _delegateSerializer) {
+            return this;
+        }
+        return withDelegate(_converter, _delegateType, unwrappingDelegate, _property);
+    }
+
     /*
     /**********************************************************************
     /* Accessors
     /**********************************************************************
      */
 
+    // @since 3.2
+    @Override
+    public boolean isUnwrappingSerializer() {
+        return (_delegateSerializer != null) && _delegateSerializer.isUnwrappingSerializer();
+    }
+
     public Converter<Object, ?> getConverter() {
         return _converter;
     }
