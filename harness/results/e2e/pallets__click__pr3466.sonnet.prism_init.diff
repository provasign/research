+def _echo_posix_lines(message: str) -> None:
+    """Write ``message`` to stdout using ``\\n`` line endings only.
+
+    Shell completion scripts and completion responses are consumed by
+    POSIX-style shells (including on Windows, e.g. through Git Bash or
+    MSYS2's zsh). If they were written through :func:`echo`, Python's
+    text-mode stdout would translate ``\\n`` to ``os.linesep`` on
+    Windows, corrupting the script with ``\\r`` characters and breaking
+    shell keywords like ``elif``/``fi``.
+    """
+    stream = _default_text_stdout()
+    buffer = getattr(stream, "buffer", None)
+
+    if buffer is None:
+        echo(message)
+        return
+
+    buffer.write(message.encode(stream.encoding or "utf-8"))
+    buffer.write(b"\n")
+    buffer.flush()
+
