+// addMethodAllowed appends method to the list of methods allowed for the
+// current route, skipping it if it's already present.
+func (x *Context) addMethodAllowed(method methodTyp) {
+	for _, m := range x.methodsAllowed {
+		if m == method {
+			return
+		}
+	}
+	x.methodsAllowed = append(x.methodsAllowed, method)
+}
