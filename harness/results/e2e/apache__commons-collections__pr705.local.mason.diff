+package org.apache.commons.collections4.multiset;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.Arrays;
+
+import org.apache.commons.collections4.MultiSet;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Tests for integer overflow in AbstractMapMultiSet.
+ */
+public class AbstractMapMultiSetOverflowTest {
+
+    @Test
+    public void testAddLargeOccurrences() {
+        final MultiSet<String> multiset = new HashMultiSet<>();
+        
+        // Add a large number of occurrences to cause potential overflow
+        final int largeNumber = 1000000;
+        multiset.add("test", largeNumber);
+        
+        // Should not cause integer overflow - the count should be correct
+        assertEquals(largeNumber, multiset.getCount("test"));
+        
+        // Add even more to potentially cause overflow
+        multiset.add("test", largeNumber);
+        assertEquals(2 * largeNumber, multiset.getCount("test"));
+    }
+
+    @Test
+    public void testAddVeryLargeOccurrences() {
+        final MultiSet<String> multiset = new HashMultiSet<>();
+        
+        // Add a very large number of occurrences that could cause overflow
+        final int veryLargeNumber = Integer.MAX_VALUE - 1000;
+        multiset.add("test", veryLargeNumber);
+        
+        assertEquals(veryLargeNumber, multiset.getCount("test"));
+        
+        // Add more to potentially cause overflow
+        multiset.add("test", 1000);
+        assertEquals(veryLargeNumber + 1000, multiset.getCount("test"));
+    }
+    
+    @Test
+    public void testIntegerOverflowScenario() {
+        final MultiSet<String> multiset = new HashMultiSet<>();
+        
+        // This should cause integer overflow when we add to a value that's already close to MAX_VALUE
+        final int initialValue = Integer.MAX_VALUE - 100;
+        multiset.add("test", initialValue);
+        
+        assertEquals(initialValue, multiset.getCount("test"));
+        
+        // Now try to add more - this should not cause an overflow exception but should handle it gracefully
+        multiset.add("test", 200);  // This would overflow: (Integer.MAX_VALUE - 100) + 200 = Integer.MAX_VALUE + 100
+        
+        // The count should be clamped to Integer.MAX_VALUE, not negative
+        final int actualCount = multiset.getCount("test");
+        assertEquals(Integer.MAX_VALUE, actualCount, "Count should be clamped to MAX_VALUE, not overflow to negative");
+    }
+    
+    @Test
+    public void testMultipleOverflowScenarios() {
+        final MultiSet<String> multiset = new HashMultiSet<>();
+        
+        // Add a value close to MAX_VALUE
+        multiset.add("test", Integer.MAX_VALUE - 10);
+        assertEquals(Integer.MAX_VALUE - 10, multiset.getCount("test"));
+        
+        // Add more to cause overflow
+        multiset.add("test", 20);  // Should overflow to MAX_VALUE
+        assertEquals(Integer.MAX_VALUE, multiset.getCount("test"));
+        
+        // Add even more
+        multiset.add("test", Integer.MAX_VALUE);  // Should still be MAX_VALUE
+        assertEquals(Integer.MAX_VALUE, multiset.getCount("test"));
+    }
+}
