+    /**
+     * Property writer used for unwrapped (no wrapper element) Collection/array
+     * properties: suppresses output entirely for {@code null} values since,
+     * without a wrapper, a null placeholder element would be indistinguishable,
+     * on deserialization, from a single-element (empty) collection.
+     */
+    private static class NullSuppressingPropertyWriter extends BeanPropertyWriter
+        implements java.io.Serializable
+    {
+        private static final long serialVersionUID = 1L;
+
+        public NullSuppressingPropertyWriter(BeanPropertyWriter wrapped) {
+            super(wrapped);
+        }
+
+        @Override
+        public void serializeAsProperty(Object bean, JsonGenerator g, SerializationContext ctxt)
+            throws Exception
+        {
+            if (get(bean) == null) {
+                return;
+            }
+            super.serializeAsProperty(bean, g, ctxt);
+        }
+    }
