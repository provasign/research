+_SOURCE_PWSH = """\
+Register-ArgumentCompleter -Native -CommandName %(prog_name)s -ScriptBlock {
+    param($wordToComplete, $commandAst, $cursorPosition)
+
+    $env:%(complete_var)s = "pwsh_complete"
+    $env:COMP_WORDS = $commandAst.ToString()
+    $env:COMP_CWORD = $wordToComplete
+
+    %(prog_name)s | ForEach-Object {
+        $type, $value, $help = $_ -split ',', 3
+
+        if ($type -eq "plain") {
+            [System.Management.Automation.CompletionResult]::new(
+                $value, $value, 'ParameterValue', $(
+                    if ($help -eq "_") { $value } else { $help }
+                )
+            )
+        }
+        elseif ($type -eq "dir" -or $type -eq "file") {
+            $matches = Get-ChildItem -Path "$value*" -ErrorAction SilentlyContinue
+
+            if ($type -eq "dir") {
+                $matches = $matches | Where-Object { $_.PSIsContainer }
+            }
+
+            $matches | ForEach-Object {
+                [System.Management.Automation.CompletionResult]::new(
+                    $_.Name, $_.Name, 'ParameterValue', $_.Name
+                )
+            }
+        }
+    }
+
+    Remove-Item Env:\\%(complete_var)s
+    Remove-Item Env:\\COMP_WORDS
+    Remove-Item Env:\\COMP_CWORD
+}
+"""
+
 
