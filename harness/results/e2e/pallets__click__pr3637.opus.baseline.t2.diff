+class PwshComplete(ShellComplete):
+    """Shell completion for PowerShell (``pwsh`` and Windows PowerShell).
+
+    .. versionadded:: 8.5
+    """
+
+    name: t.ClassVar[str] = "pwsh"
+    source_template: t.ClassVar[str] = _SOURCE_PWSH
+
+    def get_completion_args(self) -> tuple[list[str], str]:
+        cwords = split_arg_string(os.environ["COMP_WORDS"])
+        incomplete = os.environ["COMP_CWORD"]
+
+        if incomplete:
+            incomplete = split_arg_string(incomplete)[0]
+
+        args = cwords[1:]
+
+        # PowerShell passes the partial word in both the command line and
+        # the word being completed, remove it from the complete args.
+        if incomplete and args and args[-1] == incomplete:
+            args.pop()
+
+        return args, incomplete
+
+    def format_completion(self, item: CompletionItem[str]) -> str:
+        return f"{item.type},{item.value},{item.help or '_'}"
+
+
 _available_shells: t.Final[dict[str, type[ShellComplete]]] = {
     "bash": BashComplete,
     "fish": FishComplete,
+    "pwsh": PwshComplete,
+    "powershell": PwshComplete,
     "zsh": ZshComplete,
 }
 
