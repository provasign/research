+public class TestAnalysis {
+    public static void main(String[] args) {
+        // Let's trace through what happens with "java.util.Map$Entry"
+        String className = "java.util.Map$Entry";
+        
+        System.out.println("Input: " + className);
+        
+        final char PACKAGE_SEPARATOR_CHAR = '.';
+        final char INNER_CLASS_SEPARATOR_CHAR = '$';
+        
+        final int lastDotIdx = className.lastIndexOf(PACKAGE_SEPARATOR_CHAR);
+        System.out.println("lastDotIdx: " + lastDotIdx); // Should be 10 (position of last dot before "Map$Entry")
+        
+        final int innerIdx = className.indexOf(INNER_CLASS_SEPARATOR_CHAR, lastDotIdx == -1 ? 0 : lastDotIdx + 1);
+        System.out.println("innerIdx: " + innerIdx); // Should be 13 (position of $)
+        
+        String out = className.substring(lastDotIdx + 1);
+        System.out.println("out before replacement: " + out); // Should be "Map$Entry"
+        
+        if (innerIdx != -1) {
+            out = out.replace(INNER_CLASS_SEPARATOR_CHAR, PACKAGE_SEPARATOR_CHAR);
+            System.out.println("out after replacement: " + out); // Should be "Map.Entry"
+        }
+        
+        System.out.println("Final result: " + out);
+    }
+}
