+import org.apache.commons.lang3.ClassUtils;
+
+public class TestGetShortClassName {
+    public static void main(String[] args) {
+        // Test with Map.Entry which has a $ in its name
+        System.out.println("Map.Entry.class.getName(): " + java.util.Map.Entry.class.getName());
+        System.out.println("getShortClassName(Map.Entry.class): " + ClassUtils.getShortClassName(java.util.Map.Entry.class));
+        System.out.println("getShortClassName(Map.Entry.class.getName()): " + ClassUtils.getShortClassName(java.util.Map.Entry.class.getName()));
+        
+        // Test with a class that has $ in its name but is not an inner class
+        try {
+            Class<?> clazz = Class.forName("java.util.HashMap$Entry");
+            System.out.println("HashMap$Entry.class.getName(): " + clazz.getName());
+            System.out.println("getShortClassName(HashMap$Entry.class): " + ClassUtils.getShortClassName(clazz));
+            System.out.println("getShortClassName(HashMap$Entry.class.getName()): " + ClassUtils.getShortClassName(clazz.getName()));
+        } catch (Exception e) {
+            System.out.println("HashMap$Entry not found: " + e.getMessage());
+        }
+    }
+}
