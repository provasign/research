diff --git a/changelog/3454.bugfix.rst b/changelog/3454.bugfix.rst
new file mode 100644
index 00000000..9e3331e3
--- /dev/null
+++ b/changelog/3454.bugfix.rst
@@ -0,0 +1,3 @@
+Fixed a bug where the target connection's ``ssl_context`` verify mode was applied to the
+proxy connection, making it impossible to combine a verified ``proxy_ssl_context`` with
+an unverified ``ssl_context``.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 8a89488d..97fe7c1e 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -915,9 +915,16 @@ class HTTPSConnection(HTTPConnection):
         # `_connect_tls_proxy` is called when self._tunnel_host is truthy.
         proxy_config = typing.cast(ProxyConfig, self.proxy_config)
         ssl_context = proxy_config.ssl_context
+        if ssl_context is not None:
+            # The proxy connection is configured entirely by the user-provided
+            # 'proxy_ssl_context'. The target connection's 'cert_reqs' (which may
+            # come from a separate 'ssl_context') must not be applied to it.
+            cert_reqs: int | str | None = ssl_context.verify_mode
+        else:
+            cert_reqs = self.cert_reqs
         sock_and_verified = _ssl_wrap_socket_and_match_hostname(
             sock,
-            cert_reqs=self.cert_reqs,
+            cert_reqs=cert_reqs,
             ssl_version=self.ssl_version,
             ssl_minimum_version=self.ssl_minimum_version,
             ssl_maximum_version=self.ssl_maximum_version,
