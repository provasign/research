diff --git a/src/click/shell_completion.py b/src/click/shell_completion.py
index 5652214..36d64a8 100644
--- a/src/click/shell_completion.py
+++ b/src/click/shell_completion.py
@@ -206,6 +206,55 @@ complete --no-files --command %(prog_name)s --arguments \
 "(%(complete_func)s)";
 """
 
+# PowerShell passes the whole command line as an AST and the word being
+# completed separately, which maps onto COMP_WORDS and COMP_CWORD the
+# same way Fish does.
+_SOURCE_PWSH = """\
+Register-ArgumentCompleter -Native -CommandName %(prog_name)s -ScriptBlock {
+    param($wordToComplete, $commandAst, $cursorPosition);
+
+    $env:%(complete_var)s = "pwsh_complete";
+    $env:COMP_WORDS = $commandAst.ToString();
+    $env:COMP_CWORD = $wordToComplete;
+    $response = (& %(prog_name)s) | Out-String;
+    Remove-Item Env:\\%(complete_var)s;
+    Remove-Item Env:\\COMP_WORDS;
+    Remove-Item Env:\\COMP_CWORD;
+
+    foreach ($completion in ($response -split "\\r?\\n")) {
+        if (-not $completion) {
+            continue;
+        }
+
+        $type, $value, $help = $completion -split "`t", 3;
+
+        if ($type -eq "plain") {
+            if (-not $help) {
+                $help = $value;
+            }
+
+            [System.Management.Automation.CompletionResult]::new(
+                $value, $value, 'ParameterValue', $help
+            );
+        }
+        elseif ($type -eq "dir") {
+            Get-ChildItem -Directory -Path "$value*" | ForEach-Object {
+                [System.Management.Automation.CompletionResult]::new(
+                    $_.Name, $_.Name, 'ProviderContainer', $_.FullName
+                );
+            };
+        }
+        elseif ($type -eq "file") {
+            Get-ChildItem -Path "$value*" | ForEach-Object {
+                [System.Management.Automation.CompletionResult]::new(
+                    $_.Name, $_.Name, 'ProviderItem', $_.FullName
+                );
+            };
+        }
+    };
+}
+"""
+
 
 class _SourceVarsDict(t.TypedDict):
     complete_func: str
@@ -456,9 +505,42 @@ class FishComplete(ShellComplete):
         return f"{item.type},{item.value}"
 
 
+class PowerShellComplete(ShellComplete):
+    """Shell completion for PowerShell (and Windows PowerShell).
+
+    .. versionadded:: 8.5
+    """
+
+    name: t.ClassVar[str] = "pwsh"
+    source_template: t.ClassVar[str] = _SOURCE_PWSH
+
+    def get_completion_args(self) -> tuple[list[str], str]:
+        cwords = split_arg_string(os.environ["COMP_WORDS"])
+        incomplete = os.environ["COMP_CWORD"]
+        args = cwords[1:]
+
+        # PowerShell includes the partial word in the command line AST,
+        # remove it from the complete args.
+        if incomplete and args and args[-1] == incomplete:
+            args.pop()
+
+        return args, incomplete
+
+    def format_completion(self, item: CompletionItem[str]) -> str:
+        # The script splits each line on tabs, so help text must not
+        # contain them or newlines.
+        if item.help:
+            help_ = item.help.replace("\n", " ").replace("\t", " ")
+            return f"{item.type}\t{item.value}\t{help_}"
+
+        return f"{item.type}\t{item.value}"
+
+
 _available_shells: t.Final[dict[str, type[ShellComplete]]] = {
     "bash": BashComplete,
     "fish": FishComplete,
+    "pwsh": PowerShellComplete,
+    "powershell": PowerShellComplete,
     "zsh": ZshComplete,
 }
 
