@@ -78,6 +78,18 @@ RECENT_DATE = datetime.date(2025, 1, 1)
 
 _CONTAINS_CONTROL_CHAR_RE = re.compile(r"[^-!#$%&'*+.^_`|~0-9a-zA-Z]")
 
+# RFC 7230, section 3.2.4: an obs-fold is a CRLF followed by at least one
+# SP/HTAB, used by obsolete implementations to continue a header line. It
+# must be replaced with one or more SP octets prior to interpreting the
+# field value, otherwise the raw CRLF ends up embedded in the header value
+# (e.g. a malformed Set-Cookie header leaking a CRLF into the Cookie header
+# on subsequent requests).
+_OBS_FOLD_RE = re.compile(r"\r\n(?=[ \t])|\r(?=[ \t])|\n(?=[ \t])")
+
+
+def _unfold_obs_fold(value: str) -> str:
+    return _OBS_FOLD_RE.sub(" ", value)
+
 
 class HTTPConnection(_HTTPConnection):
     """
@@ -616,7 +628,10 @@ class HTTPConnection(_HTTPConnection):
                 exc_info=True,
             )
 
-        headers = HTTPHeaderDict(httplib_response.msg.items())
+        headers = HTTPHeaderDict(
+            (name, _unfold_obs_fold(value))
+            for name, value in httplib_response.msg.items()
+        )
 
         response = HTTPResponse(
             body=httplib_response,
