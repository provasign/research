 from __future__ import annotations
 
 import http.client as httplib
+import re
 from email.errors import MultipartInvariantViolationDefect, StartBoundaryNotFoundDefect
 
 from ..exceptions import HeaderParsingError
 
+# RFC 7230 section 3.2.4 obs-fold: a CRLF followed by leading whitespace on
+# the next line. A user agent MUST replace each received obs-fold with one
+# or more SP octets prior to interpreting the field value, since some
+# servers send malformed header blocks (e.g. an unrelated header line
+# swallowed into the previous header's value) that would otherwise leak a
+# raw CRLF into the parsed header value.
+_OBS_FOLD_RE = re.compile(r"\r\n[ \t]+")
+
 
 def is_fp_closed(obj: object) -> bool:
     """
@@ -37,6 +46,29 @@ def is_fp_closed(obj: object) -> bool:
     raise ValueError("Unable to determine whether fp is closed.")
 
 
+def _unfold_obs_fold_headers(headers: httplib.HTTPMessage) -> None:
+    """
+    Replaces any obs-fold sequence (an unescaped CRLF followed by leading
+    whitespace) still present in a parsed header's value with a single SP,
+    per RFC 7230 section 3.2.4. Mutates ``headers`` in place.
+    """
+    items = headers.items()
+
+    sanitized = [(name, _OBS_FOLD_RE.sub(" ", value)) for name, value in items]
+
+    if sanitized == list(items):
+        return
+
+    # Message.__delitem__ removes every occurrence of a header name, and
+    # Message.__setitem__ appends rather than replaces, so this rebuilds the
+    # header list in its original order while preserving duplicate headers.
+    for name in {name for name, _ in items}:
+        del headers[name]
+
+    for name, value in sanitized:
+        headers[name] = value
+
+
