diff --git a/src/pack_unpack.c b/src/pack_unpack.c
index 5ce8a7a..d42efe1 100644
--- a/src/pack_unpack.c
+++ b/src/pack_unpack.c
@@ -30,6 +30,7 @@ typedef struct {
     int column;
     size_t pos;
     int has_error;
+    int key_annotated;
 } scanner_t;
 
 #define token(scanner) ((scanner)->token.token)
@@ -53,6 +54,26 @@ static void scanner_init(scanner_t *s, json_error_t *error, size_t flags,
     s->column = 0;
     s->pos = 0;
     s->has_error = 0;
+    s->key_annotated = 0;
+}
+
+/* Appends " for key <key>" to a wrong-type error message, unless a more
+   deeply nested error has already been annotated with its own key. */
+static void annotate_wrong_type_key(scanner_t *s, const char *key) {
+    size_t text_len;
+    size_t space;
+    char code;
+
+    if (!s->error || s->key_annotated ||
+        json_error_code(s->error) != json_error_wrong_type)
+        return;
+
+    text_len = strlen(s->error->text);
+    space = JSON_ERROR_TEXT_LENGTH - 1 - text_len;
+    code = s->error->text[JSON_ERROR_TEXT_LENGTH - 1];
+    snprintf(s->error->text + text_len, space, " for key %s", key);
+    s->error->text[JSON_ERROR_TEXT_LENGTH - 1] = code;
+    s->key_annotated = 1;
 }
 
 static void next_token(scanner_t *s) {
@@ -551,8 +572,10 @@ static int unpack_object(scanner_t *s, json_t *root, va_list *ap) {
             }
         }
 
-        if (unpack(s, value, ap))
+        if (unpack(s, value, ap)) {
+            annotate_wrong_type_key(s, key);
             goto out;
+        }
 
         hashtable_set(&key_set, key, key_len, json_null());
         next_token(s);
@@ -656,8 +679,13 @@ static int unpack_array(scanner_t *s, json_t *root, va_list *ap) {
             }
         }
 
-        if (unpack(s, value, ap))
+        if (unpack(s, value, ap)) {
+            /* A wrong-type error inside an array element is not
+               attributable to a single object key, even if the array
+               itself lives inside an object; suppress annotation. */
+            s->key_annotated = 1;
             return -1;
+        }
 
         next_token(s);
         i++;
