+class PwshComplete(ShellComplete):
+    """Shell completion for PowerShell.
+
+    .. versionadded:: 8.5.0
+    """
+
+    name: t.ClassVar[str] = "pwsh"
+    source_template: t.ClassVar[str] = _SOURCE_PWSH
+
+    def get_completion_args(self) -> tuple[list[str], str]:
+        cwords = split_arg_string(os.environ["COMP_WORDS"])
+        cword = int(os.environ["COMP_CWORD"])
+        args = cwords[1:cword]
+
+        try:
+            incomplete = cwords[cword]
+        except IndexError:
+            incomplete = ""
+
+        return args, incomplete
+
+    def format_completion(self, item: CompletionItem[str]) -> str:
+        # The completion script splits on the first two commas, so the help
+        # text may contain commas but the value may not. A tooltip can't be
+        # empty, so fall back to the value.
+        help_ = (item.help or item.value).replace("\n", " ").replace("\r", " ")
+        return f"{item.type},{item.value},{help_}"
+
+
 _available_shells: t.Final[dict[str, type[ShellComplete]]] = {
     "bash": BashComplete,
     "fish": FishComplete,
+    "pwsh": PwshComplete,
+    "powershell": PwshComplete,
     "zsh": ZshComplete,
 }
 
