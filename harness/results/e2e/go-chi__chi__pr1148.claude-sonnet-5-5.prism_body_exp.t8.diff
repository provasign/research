+// sameHandler reports whether a and b are the same handler. Func-typed
+// handlers are not comparable with ==, so compare their code pointers.
+func sameHandler(a, b http.Handler) bool {
+	va, vb := reflect.ValueOf(a), reflect.ValueOf(b)
+	if va.Kind() == reflect.Func && vb.Kind() == reflect.Func {
+		return va.Pointer() == vb.Pointer()
+	}
+	if va.Kind() == reflect.Func || vb.Kind() == reflect.Func {
+		return false
+	}
+	return a == b
+}
