diff --git a/changelog/3401.bugfix.rst b/changelog/3401.bugfix.rst
new file mode 100644
index 00000000..3699282d
--- /dev/null
+++ b/changelog/3401.bugfix.rst
@@ -0,0 +1 @@
+Fixed ``proxy_ssl_context`` being overridden by the target ``ssl_context`` verification settings, which made it impossible to verify the HTTPS proxy connection while skipping verification of the proxied connection.
diff --git a/src/urllib3/connection.py b/src/urllib3/connection.py
index 8a89488d..edb309ba 100644
--- a/src/urllib3/connection.py
+++ b/src/urllib3/connection.py
@@ -843,9 +843,17 @@ class HTTPSConnection(HTTPConnection):
             else:
                 ssl_context = self.ssl_context
 
+            # ``self.cert_reqs`` may have been derived from the connection's
+            # ``ssl_context``, so don't let it override the verification
+            # settings of a different (proxy) SSL context.
+            if ssl_context is not None and ssl_context is not self.ssl_context:
+                cert_reqs: int | str | None = ssl_context.verify_mode
+            else:
+                cert_reqs = self.cert_reqs
+
             sock_and_verified = _ssl_wrap_socket_and_match_hostname(
                 sock=sock,
-                cert_reqs=self.cert_reqs,
+                cert_reqs=cert_reqs,
                 ssl_version=self.ssl_version,
                 ssl_minimum_version=self.ssl_minimum_version,
                 ssl_maximum_version=self.ssl_maximum_version,
@@ -915,9 +923,16 @@ class HTTPSConnection(HTTPConnection):
         # `_connect_tls_proxy` is called when self._tunnel_host is truthy.
         proxy_config = typing.cast(ProxyConfig, self.proxy_config)
         ssl_context = proxy_config.ssl_context
+        # The connection's ``cert_reqs`` describes the target connection and may
+        # have been derived from the target's ``ssl_context``. Don't let it
+        # override the verification settings of a proxy-specific SSL context.
+        if ssl_context is not None:
+            cert_reqs: int | str | None = ssl_context.verify_mode
+        else:
+            cert_reqs = self.cert_reqs
         sock_and_verified = _ssl_wrap_socket_and_match_hostname(
             sock,
-            cert_reqs=self.cert_reqs,
+            cert_reqs=cert_reqs,
             ssl_version=self.ssl_version,
             ssl_minimum_version=self.ssl_minimum_version,
             ssl_maximum_version=self.ssl_maximum_version,
