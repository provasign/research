+_OBS_FOLD_RE = re.compile(r"[\r\n]+[ \t]+")
+
+
+def _replace_obs_fold(value: str) -> str:
+    """Replace obsolete line folding in a received header value with a single space.
+
+    A user agent that receives an obs-fold in a response message that is not
+    within a message/http container MUST replace each received obs-fold with
+    one or more SP octets prior to interpreting the field value.
+    See https://datatracker.ietf.org/doc/html/rfc9112#section-5.2
+    """
+    return _OBS_FOLD_RE.sub(" ", value)
+
+
 def _get_default_user_agent() -> str:
     return f"python-urllib3/{__version__}"
 
