+    @classmethod
+    def split_newlines(cls, segments: Iterable["Segment"]) -> Iterable["Segment"]:
+        """Split segments so that line feeds are yielded as separate un-styled segments.
+
+        This ensures a style is reset before the line feed, and doesn't carry on to the
+        following line.
+
+        Args:
+            segments (Iterable[Segment]): Segments potentially containing line feeds.
+
+        Yields:
+            Segment: Segments where no segment contains a line feed with other text.
+        """
+        new_line_segment = cls("\n")
+        for segment in segments:
+            if "\n" in segment.text and not segment.control:
+                text, style, _ = segment
+                while text:
+                    _text, new_line, text = text.partition("\n")
+                    if _text:
+                        yield cls(_text, style)
+                    if new_line:
+                        yield new_line_segment
+            else:
+                yield segment
+
