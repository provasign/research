+    /**
+     * Helper method used to figure out whether given deserializer actually overrides
+     * {@link ValueDeserializer#collectAllPropertyNamesTo} (and so can be trusted to
+     * report an accurate, possibly empty, set of recognized property names) or relies
+     * on the default (no-op) implementation, in which case we have no information about
+     * properties it may (or may not) recognize.
+     *
+     * @since 3.2
+     */
+    private static boolean _declaresKnownPropertyNames(ValueDeserializer<?> deser) {
+        try {
+            return deser.getClass().getMethod("collectAllPropertyNamesTo", Set.class)
+                    .getDeclaringClass() != ValueDeserializer.class;
+        } catch (NoSuchMethodException | SecurityException e) {
