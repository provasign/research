@@ -205,6 +205,28 @@ func (cmd *Command) allFlags() []Flag {
 	return flags
 }
 
+// preParseStateResetter is implemented by flags which track whether
+// PreParse has already applied them, so that a flag instance shared
+// between a parent command and one of its subcommands isn't re-applied
+// (and its value discarded) partway through a single Run.
+type preParseStateResetter interface {
+	resetPreParseState()
+}
+
+// resetFlagsPreParseState clears the "already applied" bit tracked by flags
+// across the whole command tree so each top-level Run starts from a clean
+// slate, regardless of whether previous Run calls left that bit set.
+func resetFlagsPreParseState(cmd *Command) {
+	for _, fl := range cmd.allFlags() {
+		if r, ok := fl.(preParseStateResetter); ok {
+			r.resetPreParseState()
+		}
+	}
+	for _, subCmd := range cmd.Commands {
+		resetFlagsPreParseState(subCmd)
+	}
+}
