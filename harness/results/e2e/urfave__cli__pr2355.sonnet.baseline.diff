 // arguments are parsed according to the Flag and Command
 // definitions and the matching Action functions are run.
 func (cmd *Command) Run(ctx context.Context, osArgs []string) (deferErr error) {
+	cmd.resetFlagsForRun()
 	_, deferErr = cmd.run(ctx, osArgs)
 	return deferErr
 }
 
+// resetFlagsForRun clears any "already applied" state left over on this
+// command's flags (and those of all of its subcommands) from a previous,
+// independent Run invocation. Flag instances -- and in particular ones
+// shared between a command and its subcommands -- persist across separate
+// Run calls (e.g. an app run multiple times in a test, or interactively),
+// so without this their values from the previous invocation would leak
+// into the next one.
+func (cmd *Command) resetFlagsForRun() {
+	for _, f := range cmd.allFlags() {
+		if r, ok := f.(interface{ resetForRun() }); ok {
+			r.resetForRun()
+		}
+	}
+
+	for _, sub := range cmd.Commands {
+		sub.resetFlagsForRun()
+	}
+}
