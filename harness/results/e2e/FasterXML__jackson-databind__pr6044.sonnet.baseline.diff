+    /**
+     * Handles the case where the external type id actually applies to the
+     * <b>content</b> type of a Collection/array-valued property (see
+     * {@link #isForContentType()}): resolves the concrete element type from
+     * the type id, narrows the property's (container) type to use it, and lets
+     * the regular container deserializer (with its usual single-value-as-array
+     * handling) take care of the rest, instead of trying to apply the
+     * element's type deserializer directly to the whole container value.
+     */
+    private Object _deserializeContentValue(JsonParser p, DeserializationContext ctxt,
+            ExtTypedProperty extProp, String typeId) throws JacksonException
+    {
+        JavaType containerType = extProp.getProperty().getType();
+        JavaType subtype = extProp._typeDeserializer.getTypeIdResolver().typeFromId(ctxt, typeId);
+        if (subtype != null) {
+            containerType = containerType.withContentType(subtype);
+        }
+        ValueDeserializer<Object> deser = ctxt.findContextualValueDeserializer(containerType,
+                extProp.getProperty());
+        return deser.deserialize(p, ctxt);
+    }
