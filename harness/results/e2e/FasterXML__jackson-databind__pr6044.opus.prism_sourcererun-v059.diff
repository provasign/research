+    /**
+     * Helper method called to verify that an unsupported combination of
+     * {@link JsonTypeInfo.As#EXTERNAL_PROPERTY} inclusion and Container
+     * (Collection, Map, array) type is not being used: if it is, fail
+     * eagerly instead of producing content that cannot be read back.
+     *
+     * @since 3.2
+     */
+    protected void _verifyNonContainerExternalProperty(DatabindContext ctxt,
+            Annotated accessor, JavaType containerType)
+    {
+        // Only Containers (Collections, Maps, arrays) problematic; Reference
+        // types (like `AtomicReference`) work fine
+        if (!containerType.isContainerType()) {
+            return;
+        }
+        final MapperConfig<?> config = ctxt.getConfig();
+        JsonTypeInfo.Value typeInfo = config.getAnnotationIntrospector()
+                .findPolymorphicTypeInfo(config, accessor);
+        if ((typeInfo == null)
+                || (typeInfo.getIdType() == JsonTypeInfo.Id.NONE)
+                || (typeInfo.getInclusionType() != JsonTypeInfo.As.EXTERNAL_PROPERTY)) {
+            return;
+        }
+        ctxt.reportBadDefinition(containerType, String.format(
+"Cannot use `@JsonTypeInfo(include=JsonTypeInfo.As.EXTERNAL_PROPERTY)` with Container type %s: `EXTERNAL_PROPERTY` only supported for scalar and Bean (POJO) types",
+                ClassUtil.getTypeDescription(containerType)));
+    }
