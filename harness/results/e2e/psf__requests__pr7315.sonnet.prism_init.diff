+        if url.startswith("//"):
+            # A path with excess leading slashes (e.g. "//host:port/...")
+            # can be mistaken by urllib3 for a network-path reference and
+            # reparsed as an authority. Only trim the extra slashes when
+            # the first path segment could be confused for a "host:port"
+            # in that way; otherwise leave the path untouched, since a
+            # literal leading "/" is significant (e.g. an S3 object key
+            # that itself starts with "/").
+            first_segment = url[2:].split("/", 1)[0].split("?", 1)[0].split("#", 1)[0]
+            if ":" in first_segment:
+                url = f"/{url.lstrip('/')}"
 
         if is_proxied_http_request and not using_socks_proxy:
             url = urldefragauth(request.url)
