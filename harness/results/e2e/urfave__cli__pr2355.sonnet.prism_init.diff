diff --git a/command.go b/command.go
index d1fc008e..3cb72a00 100644
--- a/command.go
+++ b/command.go
@@ -13,6 +13,14 @@ const (
 	ignoreFlagPrefix = "test."
 
 	commandContextKey = contextKey("cli.context")
+
+	// preParsedFlagsKey tracks, for a single top-level Run invocation, which
+	// flags have already had PreParse called on them. This allows a flag
+	// instance that is shared between a parent command and one of its
+	// subcommands to be initialized only once per Run, instead of once per
+	// command level, which would otherwise discard a value already
+	// populated from an env var or other source.
+	preParsedFlagsKey = contextKey("cli.preparsed-flags")
 )
 
 type contextKey string
diff --git a/command_run.go b/command_run.go
index 87fa7e7f..10b53bd7 100644
--- a/command_run.go
+++ b/command_run.go
@@ -141,10 +141,20 @@ func (cmd *Command) run(ctx context.Context, osArgs []string) (_ context.Context
 	var rargs Args = &stringSliceArgs{v: osArgs}
 	var args Args = &stringSliceArgs{rargs.Tail()}
 
+	preParsedFlags, ok := ctx.Value(preParsedFlagsKey).(map[Flag]struct{})
+	if !ok {
+		preParsedFlags = map[Flag]struct{}{}
+		ctx = context.WithValue(ctx, preParsedFlagsKey, preParsedFlags)
+	}
+
 	for _, f := range cmd.allFlags() {
+		if _, seen := preParsedFlags[f]; seen {
+			continue
+		}
 		if err := f.PreParse(); err != nil {
 			return ctx, err
 		}
+		preParsedFlags[f] = struct{}{}
 	}
 
 	var err error
