+  /**
+   * Tracks lone (unpaired) surrogates across a sequence of characters that make up a JSON string,
+   * whether they originate from a literal character or from a {@code \\u} escape sequence.
+   *
+   * @param pendingHighSurrogate a high surrogate seen right before {@code c} which is still
+   *     awaiting its low surrogate partner, or {@code 0} if there is none
+   * @return the new value for {@code pendingHighSurrogate}
+   */
+  private char updatePendingSurrogate(char pendingHighSurrogate, char c) throws IOException {
+    if (Character.isHighSurrogate(c)) {
+      if (pendingHighSurrogate != 0) {
+        throw syntaxError(unpairedSurrogateMessage(pendingHighSurrogate));
+      }
+      return c;
+    } else if (Character.isLowSurrogate(c)) {
+      if (pendingHighSurrogate == 0) {
+        throw syntaxError(unpairedSurrogateMessage(c));
+      }
+      return 0;
+    } else if (pendingHighSurrogate != 0) {
+      throw syntaxError(unpairedSurrogateMessage(pendingHighSurrogate));
+    }
+    return 0;
+  }
+
+  private static String unpairedSurrogateMessage(char c) {
+    return String.format("Unpaired surrogate \\u%04x is not allowed in strict mode", (int) c);
+  }
