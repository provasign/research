+    def fileno(self) -> int:
+        """Return a real file descriptor, so that this stream can be passed to
+        subprocesses. Anything written to the descriptor is copied into this
+        buffer.
+
+        .. versionadded:: 8.3.2
+        """
+        if self._fd_file is None:
+            self._fd_file = tempfile.TemporaryFile("w+b")
+
+        return self._fd_file.fileno()
+
+    def _drain_fd(self) -> None:
+        """Copy data written to the real file descriptor into this buffer."""
+        if self._fd_file is None:
+            return
+
+        fd = self._fd_file.fileno()
+
+        while True:
+            if hasattr(os, "pread"):
+                # Read without moving the file offset, which is shared with
+                # any subprocess writing to the descriptor.
+                data = os.pread(fd, io.DEFAULT_BUFFER_SIZE, self._fd_pos)
+            else:
+                self._fd_file.seek(self._fd_pos)
+                data = self._fd_file.read(io.DEFAULT_BUFFER_SIZE)
+
+            if not data:
+                break
+
+            self._fd_pos += len(data)
+            self.write(data)
+
+    def _close_fd(self) -> None:
+        """Drain and release the file descriptor created by :meth:`fileno`."""
+        if self._fd_file is not None:
+            self._drain_fd()
+            self._fd_file.close()
+            self._fd_file = None
 
     def flush(self) -> None:
+        self._drain_fd()
         super().flush()
         self.copy_to.flush()
 
+    def getvalue(self) -> bytes:
+        self._drain_fd()
+        return super().getvalue()
+
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
         return super().write(b)
