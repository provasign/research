@@ -0,0 +1,20 @@
+import org.apache.commons.collections4.trie.analyzer.StringKeyAnalyzer;
+
+public class TestNullKey {
+    public static void main(String[] args) {
+        StringKeyAnalyzer analyzer = StringKeyAnalyzer.INSTANCE;
+        
+        // This should not throw NPE anymore
+        boolean result = analyzer.isBitSet(null, 0, 10);
+        System.out.println("Result for null key: " + result);
+        
+        // Test other edge cases
+        result = analyzer.isBitSet("", 0, 0);
+        System.out.println("Result for empty string with 0 length: " + result);
+        
+        result = analyzer.isBitSet("test", -1, 10);
+        System.out.println("Result for negative bit index: " + result);
+        
+        System.out.println("All tests passed!");
+    }
+}
