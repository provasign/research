+    def fileno(self) -> int:
+        """Return a real file descriptor, backed by a temporary file.
+
+        ``io.BytesIO`` has no file descriptor, so passing an isolated
+        stream to an API that needs one, such as
+        ``subprocess.run(..., stdout=sys.stderr)``, would raise
+        ``io.UnsupportedOperation``. Anything written to the descriptor
+        is copied into this buffer on the next flush or read.
+
+        .. versionadded:: 8.3.3
+        """
+        if self._fd_file is None:
+            self._fd_file = tempfile.TemporaryFile()
+
+        return self._fd_file.fileno()
+
+    def _drain_fd(self) -> None:
+        """Copy anything written to the file descriptor into this buffer."""
+        if self._fd_file is None:
+            return
+
+        self._fd_file.seek(self._fd_pos)
+        data = self._fd_file.read()
+
+        if data:
+            self._fd_pos += len(data)
+            self.write(data)
+
+    def _close_fd(self) -> None:
+        """Drain and discard the temporary file backing the descriptor."""
+        if self._fd_file is None:
+            return
+
+        self._drain_fd()
+        self._fd_file.close()
+        self._fd_file = None
 
     def flush(self) -> None:
+        self._drain_fd()
         super().flush()
         self.copy_to.flush()
 
+    def getvalue(self) -> bytes:
+        self._drain_fd()
+        return super().getvalue()
