+import sys
+from io import StringIO
+from click.utils import echo
+
+# Test case: echo with StringIO that is not a TTY but color=True
+s = StringIO()
+echo("Hello \033[31mWorld\033[0m", file=s, color=True)
+result = s.getvalue()
+print(f"Result: {repr(result)}")
+
+# Test case: echo with StringIO that is not a TTY and color=None (default)
+s2 = StringIO()
+echo("Hello \033[31mWorld\033[0m", file=s2, color=None)
+result2 = s2.getvalue()
+print(f"Result2: {repr(result2)}")
+
+# Test case: echo with sys.stdout that is a TTY (if it is) and color=True
+echo("Hello \033[31mWorld\033[0m", file=sys.stdout, color=True)
