--- a/src/click/testing.py
+++ b/src/click/testing.py
@@ -117,6 +117,21 @@ class _NamedTextIOWrapper(io.TextIOWrapper):
         """
         ...
 
+    def fileno(self) -> int:
+        """Return the descriptor of the real stream this wrapper stands in
+        for, so APIs that need a true file descriptor, such as
+        :func:`subprocess.run`, keep working during isolation. Output a
+        subprocess writes there goes to the real stream and is not captured.
+
+        .. versionadded:: 8.3.2
+        """
+        real = getattr(sys, f"__{self._name.strip('<>')}__", None)
+
+        if real is None:
+            raise io.UnsupportedOperation("fileno")
+
+        return real.fileno()
+
     @property
     def name(self) -> str:
         return self._name
