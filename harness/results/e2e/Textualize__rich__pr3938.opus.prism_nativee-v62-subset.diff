+    @classmethod
+    def split_newlines(cls, segments: Iterable["Segment"]) -> Iterable["Segment"]:
+        """Split segments so that line feeds are in their own unstyled segments.
+
+        This ensures styles (such as background colors) don't extend beyond the
+        end of a line.
+
+        Args:
+            segments (Iterable[Segment]): Segments potentially containing line feeds.
+
+        Yields:
+            Iterable[Segment]: Segments where no styled segment contains a line feed.
+        """
+        new_line_segment = cls("\n")
+        for segment in segments:
+            text, style, control = segment
+            if style and "\n" in text and not control:
+                while text:
+                    _text, new_line, text = text.partition("\n")
+                    if _text:
+                        yield cls(_text, style)
+                    if new_line:
+                        yield new_line_segment
+            else:
+                yield segment
+
