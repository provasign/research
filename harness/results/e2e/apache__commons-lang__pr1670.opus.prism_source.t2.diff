+    /**
+     * Tests whether the given class name only contains well-formed array markers ({@code "[]"}) from the given index to the end, for example the
+     * {@code "[][]"} in {@code "java.lang.String[][]"}.
+     *
+     * @param canonicalName the class name to check.
+     * @param fromIndex     the index of the first array marker.
+     * @return whether the array suffix is well-formed.
+     */
+    private static boolean isArrayMarkerSuffix(final String canonicalName, final int fromIndex) {
+        final int len = canonicalName.length();
+        if ((len - fromIndex) % 2 != 0) {
+            return false;
+        }
+        for (int i = fromIndex; i < len; i += 2) {
+            if (canonicalName.charAt(i) != '[' || canonicalName.charAt(i + 1) != ']') {
+                return false;
+            }
+        }
+        return true;
+    }
