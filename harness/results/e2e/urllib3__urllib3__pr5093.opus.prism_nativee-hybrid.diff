+def _proxy_cert_reqs(
+    proxy_ssl_context: ssl.SSLContext | None, cert_reqs: int | str | None
+) -> int | str | None:
+    """Resolve the ``cert_reqs`` to use for the connection to the proxy.
+
+    When a proxy SSLContext is given its own ``verify_mode`` is authoritative,
+    otherwise we fall back to the connection's ``cert_reqs``.
+    """
+    if proxy_ssl_context is not None:
+        return proxy_ssl_context.verify_mode
+    return cert_reqs
+
