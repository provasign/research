+package org.apache.commons.lang3;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import java.util.Random;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test for the fix of LANG-1874.
+ */
+public class RandomStringUtilsLang1874Test {
+
+    @Test
+    public void testRangeWithDigitsAndLetters() {
+        // This should work now - range ['0', 'A') contains digits but no letters
+        // The original bug was that this would incorrectly throw an exception
+        assertDoesNotThrow(() -> {
+            RandomStringUtils.random(5, '0', 'A', true, true, null, new Random());
+        }, "Range ['0', 'A') with both letters=true and digits=true should not throw exception");
+    }
+}
