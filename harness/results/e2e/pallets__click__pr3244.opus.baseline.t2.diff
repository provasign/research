@@ -107,6 +107,48 @@ class _NamedTextIOWrapper(io.TextIOWrapper):
         super().__init__(buffer, **kwargs)
         self._name = name
         self._mode = mode
+        self._fd_file: t.IO[bytes] | None = None
+        self._fd_pos = 0
+
+    def fileno(self) -> int:
+        """Return a real file descriptor for this stream.
+
+        The underlying buffer is an :class:`io.BytesIO`, which has no file
+        descriptor, so code such as ``subprocess.run(..., stdout=sys.stdout)``
+        would fail with ``io.UnsupportedOperation``. A temporary file provides
+        a real descriptor instead; whatever is written to it is copied into the
+        captured stream by :meth:`_drain_fd`.
+
+        .. versionadded:: 8.3.3
+        """
+        if self._fd_file is None:
+            self._fd_file = tempfile.TemporaryFile("w+b")
+
+        return self._fd_file.fileno()
+
+    def _drain_fd(self) -> None:
+        """Copy anything written to the descriptor from :meth:`fileno` into
+        the captured stream.
+        """
+        if self._fd_file is None:
+            return
+
+        self._fd_file.seek(self._fd_pos)
+        data = self._fd_file.read()
+        self._fd_pos = self._fd_file.tell()
+
+        if data:
+            super().flush()
+            self.buffer.write(data)
+
+    def flush(self) -> None:
+        super().flush()
+        self._drain_fd()
+
+    def write(self, s: str) -> int:
+        # Keep descriptor writes roughly in order with writes to this stream.
+        self._drain_fd()
+        return super().write(s)
 
     def close(self) -> None:
         """
