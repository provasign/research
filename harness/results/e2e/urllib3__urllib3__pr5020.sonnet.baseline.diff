 from __future__ import annotations
 
 import http.client as httplib
+import re
 from email.errors import MultipartInvariantViolationDefect, StartBoundaryNotFoundDefect
 
 from ..exceptions import HeaderParsingError
 
+# RFC 7230 section 3.2.4 forbids "obsolete line folding" (a CRLF followed by
+# whitespace) from surviving into a parsed header value: it must be replaced
+# with one or more SP octets before the value is interpreted. Python's
+# email parser (used by http.client) leaves the raw CRLF in place instead,
+# which lets a single malformed header smuggle what looks like an extra
+# header/line into the value (e.g. into a Set-Cookie value later echoed back
+# in a Cookie header).
+_OBS_FOLD_RE = re.compile(r"\r\n[ \t]+")
+
 
 def is_fp_closed(obj: object) -> bool:
     """
@@ -55,6 +65,18 @@ def assert_header_parsing(headers: httplib.HTTPMessage) -> None:
     if not isinstance(headers, httplib.HTTPMessage):
         raise TypeError(f"expected httplib.Message, got {type(headers)}.")
 
+    # Undo obsolete line folding left in header values by the email parser,
+    # in-place and preserving header order/duplicates.
+    unfolded = [
+        (name, _OBS_FOLD_RE.sub(" ", value) if isinstance(value, str) else value)
+        for name, value in headers.items()
+    ]
+    if any(new != old for (_, new), (_, old) in zip(unfolded, headers.items())):
+        for name in list(headers.keys()):
+            del headers[name]
+        for name, value in unfolded:
+            headers[name] = value
+
     unparsed_data = None
 
