 from __future__ import annotations
 
 import http.client as httplib
+import re
 from email.errors import MultipartInvariantViolationDefect, StartBoundaryNotFoundDefect
 
 from ..exceptions import HeaderParsingError
 
+# Match an obsolete line folding (obs-fold) sequence: a CRLF (or bare LF)
+# followed by at least one space or tab. Per RFC 7230 Section 3.2.4, a
+# recipient that isn't a proxy MUST replace each obs-fold with one or more
+# SP octets before interpreting the field value, since Python's header
+# parser (email.parser) doesn't do this unfolding itself and would
+# otherwise leave the raw CRLF embedded in the header value.
+_OBS_FOLD_RE = re.compile(r"\r\n[ \t]+|\n[ \t]+")
+
+
+def _unfold_header_value(value: str) -> str:
+    return _OBS_FOLD_RE.sub(" ", value)
