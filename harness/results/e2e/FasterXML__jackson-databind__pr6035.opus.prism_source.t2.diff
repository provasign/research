+    /**
+     * Variant of {@link #_collectIgnorals(String)} that, for deserialization, also
+     * registers {@code @JsonAlias} names of the ignored property: without this,
+     * incoming JSON using an alias of an ignored property would not be recognized
+     * as ignorable (leading to "unknown property" failures, or the value being
+     * routed to an any-setter) even though the primary name is ({@code [databind#6031]}).
+     *<p>
+     * Must be called BEFORE accessors are removed from the property, since aliases
+     * are resolved via the property's primary member.
+     *
+     * @since 3.2
+     */
+    protected void _collectIgnoralsWithAliases(POJOPropertyBuilder prop)
+    {
+        _collectIgnorals(prop.getName());
+        if (!_forSerialization) {
+            for (PropertyName alias : prop.findAliases()) {
+                _collectIgnorals(alias.getSimpleName());
+            }
+        }
+    }
