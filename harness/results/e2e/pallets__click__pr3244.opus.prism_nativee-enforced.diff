+        self,
+        buffer: t.BinaryIO,
+        name: str,
+        mode: str,
+        fileno: int | None = None,
+        **kwargs: t.Any,
     ) -> None:
         super().__init__(buffer, **kwargs)
         self._name = name
         self._mode = mode
+        self._fileno = fileno
+
+    def fileno(self) -> int:
+        """Return the descriptor of the real stream this one replaces.
+
+        The isolated stream is backed by an in-memory buffer, which has no
+        file descriptor. Consumers that need a real one, such as
+        ``subprocess.run(stdout=sys.stderr)``, would otherwise fail with
+        ``io.UnsupportedOperation``.
+
+        .. versionadded:: 8.3.3
+        """
+        if self._fileno is not None:
+            return self._fileno
+
+        return super().fileno()
 
