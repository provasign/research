+def _echo_lf(message: str) -> None:
+    """Write ``message`` to stdout using ``\\n`` line endings only.
+
+    This output is a shell script that gets ``eval``'d or ``source``'d by
+    the calling shell. On Windows, :func:`~click.echo` writes through a
+    text stream that translates ``\\n`` to ``\\r\\n``. POSIX-style shells
+    that run on Windows (e.g. MSYS2/Git Bash zsh) don't strip the stray
+    ``\\r``, which corrupts multi-line constructs like ``if``/``elif`` and
+    causes a parse error. Writing raw bytes avoids that translation on
+    every platform.
+    """
+    stream = get_binary_stream("stdout")
+    stream.write(message.encode())
+    stream.write(b"\n")
+    stream.flush()
+
