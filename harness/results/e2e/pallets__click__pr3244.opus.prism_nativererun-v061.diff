+    def fileno(self) -> int:
+        """Return the descriptor of the real stream this one replaces.
+
+        ``BytesIO`` has no descriptor, so APIs that need one, such as
+        ``subprocess.run(stdout=sys.stderr)``, fail during isolation.
+        Deferring to the replaced stream keeps them working.
