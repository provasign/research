+import click
+import pytest
+
+
+def test_help_option_conflict():
+    """Test that when an argument named 'help' is defined, it doesn't break help resolution."""
+    
+    @click.command()
+    @click.argument('help')
+    @click.option('--verbose', is_flag=True)
+    def cli(help, verbose):
+        return f"help={help}, verbose={verbose}"
+    
+    # This should work without raising an error
+    with pytest.raises(SystemExit):
+        cli(['--help'], prog_name='test')
+
+
+def test_help_option_conflict_with_custom_names():
+    """Test that when an argument named 'help' is defined, custom help option names work."""
+    
+    @click.command()
+    @click.argument('help')
+    @click.option('--verbose', is_flag=True)
+    def cli(help, verbose):
+        return f"help={help}, verbose={verbose}"
+    
+    # This should work without raising an error
+    with pytest.raises(SystemExit):
+        cli(['-h'], prog_name='test')
+
+
+if __name__ == '__main__':
+    test_help_option_conflict()
+    test_help_option_conflict_with_custom_names()
+    print("Tests passed!")
