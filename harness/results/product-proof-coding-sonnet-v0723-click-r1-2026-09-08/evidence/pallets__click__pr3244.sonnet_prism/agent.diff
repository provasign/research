 class BytesIOCopy(io.BytesIO):
     """Patch ``io.BytesIO`` to let the written stream be copied to another.
 
+    A real, OS-backed file is lazily created the first time ``fileno()``
+    is requested, so that code under test which passes ``sys.stdout``/
+    ``sys.stderr`` directly to APIs like :func:`subprocess.run` works
+    under :class:`CliRunner`, instead of failing with
+    ``io.UnsupportedOperation: fileno``. Streams that never need a real
+    file descriptor keep behaving as plain in-memory buffers.
+
     .. versionadded:: 8.2
+
+    .. versionchanged:: 8.3
+        Added lazy ``fileno()`` support backed by a real file.
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
         super().__init__()
         self.copy_to = copy_to
+        self._file: t.IO[bytes] | None = None
+
+    def close(self) -> None:
+        if self._file is not None:
+            self._file.close()
+            self._file = None
+        super().close()
 
     def flush(self) -> None:
         super().flush()
         self.copy_to.flush()
+        if self._file is not None:
+            self._file.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
+        if self._file is not None:
+            self._file.write(b)
         return super().write(b)
 
+    def fileno(self) -> int:
+        if self._file is None:
+            self._file = tempfile.TemporaryFile()
+            self._file.write(self.getvalue())
+            self._file.flush()
+        return self._file.fileno()
+
 
