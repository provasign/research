@@ -0,0 +1,25 @@
+package chi
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestWalkRouteAndGetSamePattern(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	r := NewRouter()
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) {})
+		r.Get("/bar", h)
+	})
+	found := false
+	Walk(r, func(method, route string, _ http.Handler, _ ...func(http.Handler) http.Handler) error {
+		if method == "GET" && route == "/foo/bar" {
+			found = true
+		}
+		return nil
+	})
+	if !found {
+		t.Fatal("GET /foo/bar not walked")
+	}
+}
