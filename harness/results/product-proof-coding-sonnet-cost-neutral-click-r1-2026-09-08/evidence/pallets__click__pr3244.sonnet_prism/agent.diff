-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """Like ``io.BytesIO``, but backed by a real, file-descriptor backed
+    temporary file so that ``fileno()`` works. This lets the stream be
+    passed to APIs such as :func:`subprocess.run` that require a real
+    file descriptor. The written data is also copied to another stream.
 
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def __del__(self) -> None:
+        # Make sure the file-descriptor backed temporary file is closed
+        # even if it was never explicitly closed, so it doesn't trigger
+        # a ``ResourceWarning`` or leak a file descriptor.
+        try:
+            self._file.close()
+        except Exception:
+            pass
 
 
