+class _NamedTemporaryFileCopy:
+    """Wraps a real, file-descriptor backed temporary file so that streams
+    exposed by :class:`CliRunner` can be used as ``stdout``/``stderr`` for
+    :func:`subprocess.run` and friends, while also duplicating everything
+    written to it into another stream.
+
+    .. versionadded:: 8.2
+    """
+
+    def __init__(self, copy_to: io.BytesIO) -> None:
+        self._file = tempfile.TemporaryFile()
+        self.copy_to = copy_to
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
+
+    def flush(self) -> None:
+        self._file.flush()
+        self.copy_to.flush()
+
+    def write(self, b: ReadableBuffer) -> int:
+        self.copy_to.write(b)
+        return self._file.write(b)
+
+    def fileno(self) -> int:
+        return self._file.fileno()
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        data = self._file.read()
+        self._file.seek(pos)
+        return data
+
+    def __del__(self) -> None:
+        # Make sure the underlying OS-level file descriptor is always
+        # released, even if the instance is never explicitly closed.
+        try:
+            self._file.close()
+        except Exception:
+            pass
+
+
