-    """Patch ``io.BytesIO`` to let the written stream be copied to another.
+class BytesIOCopy:
+    """A binary stream that copies everything written to it to another
+    stream, while itself being backed by a real (temporary) file.
+
+    Being backed by a real file, rather than :class:`io.BytesIO`, means
+    it has a working ``fileno()``, so it can be used with APIs like
+    :func:`subprocess.run` (e.g. ``subprocess.run(stdout=sys.stdout)``)
+    inside code invoked through :class:`CliRunner`.
+
+    .. versionchanged:: 8.3
+        Backed by a real file so ``fileno()`` works.
+        :issue:`2647`
 
     .. versionadded:: 8.2
     """
 
     def __init__(self, copy_to: io.BytesIO) -> None:
-        super().__init__()
+        self._file = tempfile.TemporaryFile()
         self.copy_to = copy_to
 
     def flush(self) -> None:
-        super().flush()
+        self._file.flush()
         self.copy_to.flush()
 
     def write(self, b: ReadableBuffer) -> int:
         self.copy_to.write(b)
-        return super().write(b)
+        return self._file.write(b)
+
+    def getvalue(self) -> bytes:
+        pos = self._file.tell()
+        self._file.seek(0)
+        try:
+            return self._file.read()
+        finally:
+            self._file.seek(pos)
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self._file, name)
 
 
