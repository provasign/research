        "file_path": "/private/tmp/e2e-native-vs-window/work/pallets__click__pr3244.r1.sonnet_prism/src/click/testing.py",
        "old_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)",
        "new_string": "class BytesIOCopy(io.RawIOBase):\n    \"\"\"A binary stream backed by a real, temporary OS file, so that it has a\n    usable ``fileno()``. This lets it be passed as ``stdout``/``stderr`` to\n    APIs such as :func:`subprocess.run`, which need to duplicate a real file\n    descriptor. Everything written to it is also copied to another stream.\n\n    .. versionadded:: 8.2\n\n    .. versionchanged:: 8.3.3\n        Backed by a real temporary file instead of an in-memory buffer, so\n        that ``fileno()`` no longer raises ``io.UnsupportedOperation``.\n        :issue:`2522`\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n        self._file = tempfile.TemporaryFile()\n\n    def fileno(self) -> int:\n        return self._file.fileno()\n\n    def readable(self) -> bool:\n        return True\n\n    def writable(self) -> bool:\n        return True\n\n    def seekable(self) -> bool:\n        return True\n\n    def flush(self) -> None:\n        self._file.flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return self._file.write(b)\n\n    def read(self, size: int = -1) -> bytes:\n        return self._file.read(size)\n\n    def seek(self, offset: int, whence: int = 0) -> int:\n        return self._file.seek(offset, whence)\n\n    def tell(self) -> int:\n        return self._file.tell()\n\n    def getvalue(self) -> bytes:\n        pos = self._file.tell()\n        self._file.seek(0)\n        data = self._file.read()\n        self._file.seek(pos)\n        return data\n\n    def close(self) -> None:\n        if not self.closed:\n            self._file.close()\n        super().close()"
      },
