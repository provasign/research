        "old_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        return super().write(b)",
        "new_string": "class BytesIOCopy(io.BytesIO):\n    \"\"\"Patch ``io.BytesIO`` to let the written stream be copied to another.\n\n    Backed by a real, file-descriptor-backed temporary file so that a\n    valid ``fileno()`` is available. This allows the stream to be used as\n    the ``stdout``/``stderr`` target of :func:`subprocess.run` and\n    similar APIs, instead of raising ``io.UnsupportedOperation`` when\n    they try to look up the file descriptor.\n\n    .. versionadded:: 8.2\n    \"\"\"\n\n    def __init__(self, copy_to: io.BytesIO) -> None:\n        super().__init__()\n        self.copy_to = copy_to\n        self._file = tempfile.TemporaryFile()\n\n    def flush(self) -> None:\n        super().flush()\n        self.copy_to.flush()\n        self._file.flush()\n\n    def write(self, b: ReadableBuffer) -> int:\n        self.copy_to.write(b)\n        self._file.write(b)\n        return super().write(b)\n\n    def fileno(self) -> int:\n        return self._file.fileno()\n\n    def getvalue(self) -> bytes:\n        # Anything written directly to the file descriptor (e.g. by a\n        # child process) bypasses ``write()`` above, so merge it in here.\n        pos = self._file.tell()\n        self._file.seek(0)\n        direct = self._file.read()\n        self._file.seek(pos)\n\n        if not direct:\n            return super().getvalue()\n\n        return super().getvalue() + direct\n\n    def close(self) -> None:\n        super().close()\n        self._file.close()"
      },
