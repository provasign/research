        "old_string": "    def fileno(self) -> int:\n        return self._file.fileno()\n\n    def getvalue(self) -> bytes:\n        # Anything written directly to the file descriptor (e.g. by a\n        # child process) bypasses ``write()`` above, so merge it in here.\n        pos = self._file.tell()\n        self._file.seek(0)\n        direct = self._file.read()\n        self._file.seek(pos)\n\n        if not direct:\n            return super().getvalue()\n\n        return super().getvalue() + direct\n\n    def close(self) -> None:\n        super().close()",
        "new_string": "    def fileno(self) -> int:\n        return self._file.fileno()\n\n    def getvalue(self) -> bytes:\n        # ``self._file`` mirrors every write, including ones made\n        # directly against the file descriptor (e.g. by a child\n        # process), so it is the authoritative source of the content.\n        pos = self._file.tell()\n        self._file.seek(0)\n        data = self._file.read()\n        self._file.seek(pos)\n        return data\n\n    def close(self) -> None:\n        super().close()"
