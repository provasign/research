        "old_string": "            else:\n                self._buffer.extend(new_segments)",
        "new_string": "            else:\n                # Split any embedded newlines out of styled segments so that\n                # a style's reset code is emitted before the newline rather\n                # than after it. Otherwise the style (e.g. a background\n                # color) can bleed on to the following line in the terminal.\n                buffer_append = self._buffer.append\n                for segment in new_segments:\n                    text, segment_style, control = segment\n                    if \"\\n\" in text and not control:\n                        while text:\n                            _text, new_line, text = text.partition(\"\\n\")\n                            if _text:\n                                buffer_append(Segment(_text, segment_style))\n                            if new_line:\n                                buffer_append(Segment(\"\\n\"))\n                    else:\n                        buffer_append(segment)"
      },
