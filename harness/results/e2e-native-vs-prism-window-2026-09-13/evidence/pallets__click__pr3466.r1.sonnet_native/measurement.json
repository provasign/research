        "old_string": "    if instruction == \"source\":\n        echo(comp.source())\n        return 0",
        "new_string": "    if instruction == \"source\":\n        # Write directly to the binary stream so newlines in the\n        # generated shell script are not translated to \"\\r\\n\" by a\n        # text-mode stdout (e.g. on Windows). A script containing \"\\r\\n\"\n        # line endings can fail to parse when ``eval``-ed by shells such\n        # as zsh, producing errors like \"parse error near `elif'\".\n        stdout = get_binary_stdout()\n        stdout.write(comp.source().encode())\n        stdout.flush()\n        return 0"
