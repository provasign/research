+        # Ensure that a background (or other) style is not carried over on to the
+        # newline character itself, otherwise a terminal may paint the following
+        # line with the previous line's background colour before the reset code
+        # is processed.
+        def _strip_newline_style(
+            segments: Iterable["Segment"],
+        ) -> Iterable["Segment"]:
+            for segment in segments:
+                text, seg_style, control = segment
+                if control or "\n" not in text:
+                    yield segment
+                    continue
+                while "\n" in text:
+                    before, _, text = text.partition("\n")
+                    if before:
+                        yield cls(before, seg_style)
+                    yield cls("\n")
+                if text:
+                    yield cls(text, seg_style)
+
+        return _strip_newline_style(result_segments)
 
