index 0000000..bd6ad39
--- /dev/null
+++ b/walk_same_pattern_test.go
@@ -0,0 +1,25 @@
+package chi
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestWalkRouteAndGetSamePattern(t *testing.T) {
+	h := http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})
+	r := NewRouter()
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) { r.Get("/baz", h) })
+		r.Get("/bar", h)
+	})
+	got := map[string]bool{}
+	Walk(r, func(m, p string, _ http.Handler, _ ...func(http.Handler) http.Handler) error {
+		got[m+" "+p] = true
+		return nil
+	})
+	for _, k := range []string{"GET /foo/bar", "GET /foo/bar/baz"} {
+		if !got[k] {
+			t.Errorf("missing %s: %v", k, got)
+		}
+	}
+}
