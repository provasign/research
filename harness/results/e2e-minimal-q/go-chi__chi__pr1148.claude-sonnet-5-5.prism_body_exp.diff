@@ -883,3 +897,17 @@ func walk(r Routes, walkFn WalkFunc, parentRoute string, parentMw ...func(http.H
 
 	return nil
 }
+
+// sameHandler reports whether a and b are the same handler, without panicking
+// on uncomparable dynamic types such as http.HandlerFunc.
+func sameHandler(a, b http.Handler) bool {
+	va, vb := reflect.ValueOf(a), reflect.ValueOf(b)
+	if va.Type() != vb.Type() {
+		return false
+	}
+	switch va.Kind() {
+	case reflect.Func, reflect.Pointer, reflect.Map, reflect.Chan, reflect.UnsafePointer:
+		return va.Pointer() == vb.Pointer()
+	}
+	return va.Type().Comparable() && a == b
+}
diff --git a/walk_same_pattern_test.go b/walk_same_pattern_test.go
