+package tools.jackson.dataformat.xml.lists;
+
+import java.util.*;
+
+import org.junit.jupiter.api.Test;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+
+import tools.jackson.dataformat.xml.*;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+public class PolymorphicNullInListTest extends XmlTestUtil
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.CLASS, include = JsonTypeInfo.As.PROPERTY, property = "cl")
+    public static class Detail { }
+
+    public static class Master {
+        public List<Detail> details = new ArrayList<>();
+    }
+
+    @Test
+    public void testNullInPolymorphicList() throws Exception
+    {
+        XmlMapper mapper = new XmlMapper();
+        Master master = new Master();
+        master.details.add(null);
+        master.details.add(new Detail());
+        String xml = mapper.writeValueAsString(master);
+        Master result = mapper.readValue(xml, Master.class);
+        assertEquals(2, result.details.size());
+        assertNull(result.details.get(0));
+        assertNotNull(result.details.get(1));
+    }
+}
