+package tools.jackson.dataformat.xml.deser;
+
+import java.util.*;
+
+import org.junit.jupiter.api.Test;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+
+import tools.jackson.databind.ObjectMapper;
+import tools.jackson.dataformat.xml.XmlTestUtil;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+// null in polymorphic Collection
+public class PolymorphicNullInList334Test extends XmlTestUtil
+{
+    static class Master {
+        public List<Detail> details = new ArrayList<>();
+    }
+
+    @JsonTypeInfo(use = JsonTypeInfo.Id.CLASS, include = JsonTypeInfo.As.PROPERTY, property = "cl")
+    static class Detail { }
+
+    @Test
+    public void testNullInPolymorphicList() throws Exception
+    {
+        ObjectMapper mapper = mapperBuilder().build();
+        Master master = new Master();
+        master.details.add(null);
+        String xml = mapper.writeValueAsString(master);
+        Master result = mapper.readValue(xml, Master.class);
+        assertEquals(1, result.details.size());
+        assertNull(result.details.get(0));
+    }
+}
