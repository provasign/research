#!/bin/sh
# run_e2e pinned pnpm: the exact version js_eval installs with (zod, h3).
# run_e2e installs it once into ~/.e2e-node-tools (no registry round trip per
# call, works offline); npx is the fallback before that exists.
T="$HOME/.e2e-node-tools/pnpm-10.33.2/bin/pnpm"
[ -x "$T" ] && exec "$T" "$@"
exec npx -y pnpm@10.33.2 "$@"
