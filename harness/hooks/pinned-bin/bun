#!/bin/sh
# run_e2e pinned bun: the exact version js_eval installs hono with (bun.lock).
# run_e2e installs it once into ~/.e2e-node-tools (no registry round trip per
# call, works offline); npx is the fallback before that exists.
T="$HOME/.e2e-node-tools/bun-1.2.20/bin/bun"
[ -x "$T" ] && exec "$T" "$@"
exec npx -y bun@1.2.20 "$@"
