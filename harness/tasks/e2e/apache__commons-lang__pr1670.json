    "org.apache.commons.lang3.ClassUtilsTest::testGetClassStringMalformedMiddleJunkRejected",
    "org.apache.commons.lang3.ClassUtilsTest::testGetClassStringMalformedUnpairedBracketsRejected"
  ],
