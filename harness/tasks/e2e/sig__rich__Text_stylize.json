 "site_mode": "files",
 "instruction": "`Text.stylize(start, end, style)` (rich/text.py) puts the style last, which makes the common case of styling the whole text awkward. Change the signature to `Text.stylize(style, start=0, end=None)`: the style comes first, `start` defaults to 0, and `end=None` means the end of the text. Both offsets may be negative, counting back from the end of the text (as with slicing); a span that is empty or outside the text is ignored. Update everything that calls `stylize` to the new argument order.",
 "gold_files": [
  "examples/rainbow.py",
  "rich/text.py",
  "tests/test_text.py"
 ],
