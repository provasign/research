unc {\n \n \t\tparam.ClientIP = c.ClientIP()\n \t\tparam.Method = c.Request.Method\n-\t\tparam.StatusCode = c.Writer.Status()\n+\t\tparam.StatusCode = c.Writer.ResponseStatus()\n \t\tparam.ErrorMessage = c.Errors.ByType(ErrorTypePrivate).String()\n \n \t\tparam.BodySize = c.Writer.Size()\ndiff --git a/logger_test.go b/logger_test.go\nindex 395d97e..749ae35 100644\n--- a/logger_test.go\n+++ b/logger_test.go\n@@ -439,7 +439,7 @@ func TestLoggerWithConfigSkipper(t *testing.T) {\n \trouter.Use(LoggerWithConfig(LoggerConfig{\n \t\tOutput: buffer,\n \t\tSkip: func(c *Context) bool {\n-\t\t\treturn c.Writer.Status() == http.StatusNoContent\n+\t\t\treturn c.Writer.ResponseStatus() == http.StatusNoContent\n \t\t},\n \t}))\n \trouter.GET(\"/logged\", func(c *Context) { c.Status(http.StatusOK) })\ndiff --git a/response_writer.go b/response_writer.go\nindex 8e2d8b3..2479c33 100644\n--- a/response_writer.go\n+++ b/response_writer.go\n@@ -26,8 +26,8 @@ type ResponseWriter interface {\n \thttp.Flusher\n \thttp.CloseNotifier\n \n-\t// Status returns the HTTP response status code of the current request.\n-\tStatus() int\n+\t// ResponseStatus returns the HTTP response status code of the current request.\n+\tResponseStatus() int\n \n \t// Size returns the number of bytes already written into the response http body.\n \t// See Written()\n@@ -95,7 +95,7 @@ func (w *responseWriter) WriteString(s string) (n int, err error) {\n \treturn\n }\n \n-func (w *responseWriter) Status() int {\n+func (w *responseWriter) ResponseStatus() int {\n \treturn w.status\n }\n \ndiff --git a/response_writer_test.go b/response_writer_test.go\nindex 83d3fc8..8c3fa65 100644\n--- a/response_writer_test.go\n+++ b/response_writer_test.go\n@@ -49,7 +49,7 @@ func TestResponseWriterReset(t *testing.T) {\n \tassert.Equal(t, http.StatusOK, writer.status)\n \tassert.Equal(t, testWriter, writer.ResponseWriter)\n \tassert.Equal(t, -1, w.Size())\n-\tassert.Equal(t, http.StatusOK, w.Status())\n+\tassert.Equal(t, http.Statu